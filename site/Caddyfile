# Caddyfile — production reverse proxy / static server for the Astro build.
#
# The {$SITE_HOST} placeholder is filled in from the SITE_HOST environment
# variable (set in docker-compose.yml or your shell). On a real server with
# DNS pointing at the host, Caddy will fetch a free Let's Encrypt certificate
# automatically on first request and renew it forever.
#
# For local testing without a public domain, set SITE_HOST=:80 in compose
# (no TLS), or SITE_HOST=localhost (Caddy issues a local self-signed cert).

{$SITE_HOST} {
	root * /srv
	encode zstd gzip
	file_server

	# Astro emits a /404.html — serve it for missing routes with a 404 status.
	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	# Long cache for hashed asset bundles; short cache for HTML.
	@hashed path_regexp ^/_astro/
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"
}
