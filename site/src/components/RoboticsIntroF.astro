---
import HexMatrix from "./HexMatrix.astro";
import Heart from "./Heart.astro";
import HandLabel from "./HandLabel.astro";
---
<section class="ric" aria-labelledby="robotics-wordmark">
  <HexMatrix />

  <div class="ric__topbar">
    <div class="eyebrow">§ 02 — Robotics</div>
    <div class="eyebrow">Two programs · one workshop</div>
  </div>

  <!-- Left CAD (intentionally oversized + clipped) -->
  <img
    class="ric__cad ric__cad--left"
    src="/cad/sailfish-front-exploded.png"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
  />
  <div class="ric__hand ric__hand--left">
    <HandLabel rotate={-40} size={56}>Project Sailfish</HandLabel>
  </div>

  <!-- Right CAD (mirrored vertically, also clipped) -->
  <img
    class="ric__cad ric__cad--right"
    src="/cad/sailfish-3d-exploded.png"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
  />
  <div class="ric__hand ric__hand--right">
    <HandLabel rotate={40} size={56} align="right">FTC Team 16366</HandLabel>
  </div>

  <!-- Centered wordmark -->
  <div class="ric__wordmark" id="robotics-wordmark">
    <div class="ric__col ric__col--left">
      <div class="ric__heart">
        <Heart size={80} />
      </div>
      <div class="ric__big">IMPACTFUL</div>
      <div class="ric__small">ROBOTICS</div>
    </div>
    <div class="ric__divider" aria-hidden="true"></div>
    <div class="ric__col ric__col--right">
      <div class="ric__big">COMPETITIVE</div>
      <div class="ric__small">ROBOTICS</div>
    </div>
  </div>

  <!-- Blurbs + CTAs -->
  <div class="ric__blurbs">
    <div class="ric__blurb ric__blurb--left">
      <p>
        Three generations of an open-sourced autonomous SAR drone.<br />
        <em>Built to reach lost crews faster.</em>
      </p>
      <a class="ric__cta" href="#sailfish">↳ Project Sailfish</a>
    </div>
    <div class="ric__blurb ric__blurb--right">
      <p>
        Five years FTC — competitor, mechanical lead, mentor.<br />
        <em>Ontario Inspire 2024 + Worlds, Houston.</em>
      </p>
      <a class="ric__cta" href="#ftc">↳ FTC Team 16366</a>
    </div>
  </div>
</section>

<style>
  .ric {
    position: relative;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-body);
    min-height: 900px;
    overflow: hidden;
  }

  .ric__topbar {
    position: relative;
    padding: 28px var(--page-pad) 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 5;
    gap: 24px;
    flex-wrap: wrap;
  }

  .ric__cad {
    position: absolute;
    pointer-events: none;
    height: auto;
    z-index: 1;
  }
  .ric__cad--left {
    width: 1400px;
    left: -400px;
    top: 80px;
    transform: rotate(225deg);
    transform-origin: center center;
  }
  .ric__cad--right {
    width: 1100px;
    right: -560px;
    top: 80px;
    transform: scaleY(-1);
    transform-origin: center center;
  }

  .ric__hand { position: absolute; top: 600px; z-index: 4; }
  .ric__hand--left { left: 120px; }
  .ric__hand--right { right: 120px; text-align: right; }

  .ric__wordmark {
    position: relative;
    z-index: 3;
    margin-top: 300px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: var(--content-max);
    margin-left: auto;
    margin-right: auto;
    padding: 0 var(--page-pad);
  }
  .ric__col { position: relative; }
  .ric__col--left { text-align: right; padding-right: 18px; }
  .ric__col--right { text-align: left; padding-left: 18px; }
  .ric__heart {
    position: absolute;
    right: 36px;
    top: -55%;
    transform: rotate(-8deg);
  }
  .ric__big {
    font-family: var(--font-tech);
    font-weight: 700;
    font-size: clamp(56px, 9vw, 104px);
    line-height: 0.88;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-transform: uppercase;
  }
  .ric__small {
    font-family: var(--font-tech);
    font-weight: 500;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--ink-dim);
    text-transform: uppercase;
    margin-top: 4px;
  }
  .ric__divider {
    width: 1px;
    height: 150px;
    background: var(--rule);
    align-self: center;
  }

  .ric__blurbs {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 60px;
    padding: 48px 120px 56px;
    max-width: var(--content-max);
    margin: 0 auto;
  }
  .ric__blurb p {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-dim);
    margin: 0;
    text-wrap: pretty;
  }
  .ric__blurb--left { padding-right: 36px; text-align: right; }
  .ric__blurb--right { padding-left: 36px; }

  .ric__cta {
    display: inline-block;
    margin-top: 18px;
    padding: 10px 14px;
    background: transparent;
    color: var(--accent);
    border: 2px solid var(--accent);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    text-decoration: none;
  }
  .ric__cta:hover { background: var(--accent); color: var(--accent-ink); }

  @media (max-width: 960px) {
    .ric__cad--left  { width: 800px; left: -260px; top: 60px; }
    .ric__cad--right { width: 700px; right: -320px; top: 60px; }
    .ric__hand { top: 480px; }
    .ric__hand--left { left: 24px; }
    .ric__hand--right { right: 24px; }
    .ric__wordmark { margin-top: 220px; }
    .ric__blurbs { padding: 48px 24px; column-gap: 24px; }
    .ric__heart { right: 18px; }
  }

  @media (max-width: 640px) {
    .ric__wordmark { grid-template-columns: 1fr; gap: 32px; }
    .ric__divider { display: none; }
    .ric__col--left, .ric__col--right { text-align: center; padding: 0; }
    .ric__blurbs { grid-template-columns: 1fr; }
    .ric__blurb--left { text-align: left; padding: 0; }
    .ric__blurb--right { padding: 0; }
  }
</style>
