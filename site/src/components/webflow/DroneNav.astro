---
// The Webflow template's left sidebar, shared by the portfolio index and the
// project detail pages. Reproducing it in one place is what makes the detail
// pages read as the right-hand panel swapping rather than a full page load —
// which is how the template behaved.
//
// .nav-button is the template's own mobile menu toggle (ix2 a-12/a-13,
// MOUSE_CLICK / MOUSE_SECOND_CLICK on .nav-button, medium/small/tiny only).
// The template CSS already pins it top-right and gives .nav-item-menu
// overflow:hidden below 991px; the toggle itself lives in DroneMotion. Webflow
// drove the icon with a Lottie — this uses a CSS hamburger/X morph instead, so
// the page doesn't have to ship a Lottie runtime for one 6-frame animation.
import { readText } from "@/lib/finalImages";
import { SITE } from "@/data/content";

interface Props {
  projects: { slug: string; title: string }[];
  current?: string;
  assets?: string;
}
const { projects, current, assets = "/webflow/drone-videography" } = Astro.props;
const blurb = readText("drone-videography/intro/blurb");
const isDetail = Boolean(current);
---
<div id="w-node-f07d9bc0-ac14-acac-7e55-92e97fb92134-7fb92134" class="nav">
  <div class="nav-item">
    <div class="nav-item-title">
      <div class="nav-brand-row">
        {isDetail && (
          <a href="/drone-videography" class="dv-back" data-dv-return aria-label="Back to the gallery">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 12H5" /><path d="M12 19l-7-7 7-7" />
            </svg>
          </a>
        )}
        <a href="/drone-videography" class="nav-brand w-inline-block" data-dv-return={isDetail ? "" : undefined} data-dv-home={isDetail ? undefined : ""}>
          <img
            src={`${assets}/images/Luc-Desautels---Small-Final-Luc-upright-3x.svg`}
            loading="lazy"
            alt="Luc Desautels"
            class="nav-brand-logo"
          />
        </a>
      </div>
      <p class="paragraph">
        {blurb}
        <svg class="dv-leaf" viewBox="0 0 512 512" width="1em" height="1em" fill="currentColor" aria-hidden="true">
          <path d="M256 32l-38 71c-4 8-12 7-20 3l-28-14 21 111c4 21-10 21-18 12l-49-54-8 28c-1 4-6 8-13 7l-62-13 16 59c3 13 6 18-4 22l-22 10 107 87c11 8 7 12 3 26l-9 31 101-12c6 0 10 4 10 11l-5 105h30l-3-105c0-7 4-11 10-11l101 12-9-31c-4-14-8-18 3-26l107-87-22-10c-10-4-7-9-4-22l16-59-62 13c-7 1-12-3-13-7l-8-28-49 54c-8 9-22 9-18-12l21-111-28 14c-8 4-16 5-20-3z" />
        </svg>
      </p>
    </div>

    <button
      type="button"
      class="nav-button"
      data-dv-nav-toggle
      aria-expanded="false"
      aria-controls="dv-nav-menu"
      aria-label="Open menu"
    >
      <span class="dv-burger" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>

  <div class="nav-item nav-item-menu" id="dv-nav-menu">
    <div class="nav-menu">
      <div class="nav-menu-links">
        <div class="nav-menu-list">
          <div class="display-s display-light">Locations</div>
          <div class="nav-menu-list-wrapper">
            <div role="list" class="nav-menu-list">
              {projects.map((p) => (
                <div role="listitem" class="nav-menu-list-item">
                  <a
                    href={`/drone-videography/${p.slug}`}
                    class:list={["nav-link", p.slug === current && "w--current"]}
                    aria-current={p.slug === current ? "page" : undefined}
                  >
                    {p.title}
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="nav-menu-links">
        <div class="nav-menu-list">
          <div class="display-s display-light">Elsewhere</div>
          <a
            href="https://www.linkedin.com/in/luc-desautels/"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-link">LinkedIn</a
          >
          <a href={`mailto:${SITE.contact.email}`} class="nav-link">{SITE.contact.email}</a>
          <a href="/" class="nav-link">Back To LucDesautels.com</a>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* Brand row so the detail-page back arrow sits inline with the logo. */
  .nav-brand-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .dv-back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    color: var(--color--shade-6);
    border: 1px solid var(--color--shade-3);
    border-radius: 50%;
    text-decoration: none;
    transition:
      transform 0.2s cubic-bezier(0.165, 0.84, 0.44, 1),
      border-color 0.2s cubic-bezier(0.165, 0.84, 0.44, 1),
      opacity 0.2s cubic-bezier(0.165, 0.84, 0.44, 1);
  }
  .dv-back:hover { border-color: var(--color--shade-6); }
  .dv-back:active { transform: scale(0.9); }
  .dv-back:focus-visible { outline: 2px solid var(--color--brand-primary); outline-offset: 2px; }

  .dv-leaf {
    display: inline-block;
    vertical-align: -0.12em;
    margin-left: 0.35em;
  }

  /* Hamburger -> X, standing in for the template's Lottie. Hidden above the
     991px breakpoint, matching the mediaQueries on ix2 e-33/e-34. */
  .nav-button {
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--color--shade-6);
  }
  .dv-burger {
    position: relative;
    display: block;
    width: 1.25rem;
    height: 0.9rem;
  }
  .dv-burger span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), opacity 0.2s linear;
  }
  .dv-burger span:nth-child(1) { top: 0; }
  .dv-burger span:nth-child(2) { top: 50%; transform: translateY(-50%); }
  .dv-burger span:nth-child(3) { bottom: 0; }
  .nav-button[aria-expanded="true"] .dv-burger span:nth-child(1) {
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
  }
  .nav-button[aria-expanded="true"] .dv-burger span:nth-child(2) { opacity: 0; }
  .nav-button[aria-expanded="true"] .dv-burger span:nth-child(3) {
    bottom: auto;
    top: 50%;
    transform: translateY(-50%) rotate(-45deg);
  }

  @media screen and (max-width: 991px) {
    .nav-button { display: flex; }
    /* a-12/a-13: collapsed by default, expanded by the toggle. The template
       already sets overflow:hidden on .nav-item-menu at this breakpoint. */
    .nav-item.nav-item-menu {
      height: 0;
      transition: height 500ms cubic-bezier(0.165, 0.84, 0.44, 1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-item.nav-item-menu,
    .dv-burger span { transition-duration: 1ms; }
  }
</style>
