---
import { SITE, RESUME_HREF } from "@/data/content";
import Noise from "./Noise.astro";
---
<footer class="ft">
  <Noise />
  <div class="ft__inner shell">
    <h2 class="ft__h">
      Let's <em class="ft__em">talk.</em>
    </h2>
    <div class="ft__row">
      <div class="ft__left">
        <a class="ft__email" href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>
        <div class="ft__links">
          <a href={`https://${SITE.contact.github}`}>GITHUB ↗</a>
          <a href={`https://${SITE.contact.linkedin}`}>LINKEDIN ↗</a>
          <a href={RESUME_HREF}>RESUME ↗</a>
        </div>
      </div>
      <div class="ft__right">
        <div>Built in Toronto</div>
        <div style="margin-top:6px;">v2026.05</div>
      </div>
    </div>
  </div>
</footer>

<style>
  .ft {
    padding: 88px var(--page-pad) 56px;
    background: var(--dark);
    color: var(--dark-ink);
    position: relative;
    overflow: hidden;
  }
  .ft__inner { position: relative; z-index: 1; }
  .ft__h {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(64px, 14vw, 140px);
    line-height: 0.88;
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--dark-ink);
  }
  .ft__em { font-style: italic; color: var(--accent); font-weight: 500; }
  .ft__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 40px;
    gap: 24px;
    flex-wrap: wrap;
  }
  .ft__left { display: flex; flex-direction: column; gap: 14px; }
  .ft__email {
    font-family: var(--font-body);
    font-size: 22px;
    color: var(--dark-ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 6px;
  }
  .ft__links {
    display: flex;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--dark-dim);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    flex-wrap: wrap;
  }
  .ft__right {
    text-align: right;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--dark-mute);
    text-transform: uppercase;
  }
</style>
