---
import { ROBOTICS } from "@/data/content";
import Placeholder from "./Placeholder.astro";

const cols = ROBOTICS; // [Sailfish, FTC]
const N = 5; // slides per column
---
<section class="rp" id="sailfish" data-rp data-rsec="robotics-panels">
  <!-- Sticky band: column headers + media + progress bars ─────────────── -->
  <div class="rp__stickytop">
    <div class="rp__shell shell">
      <div class="rp__grid rp__grid--top">
        {cols.map((p, ci) => (
          <div class="col col--top" data-col={ci} id={ci === 1 ? "ftc" : undefined}>
            <div class="col__head">
              <div class="col__topline">
                <div class="eyebrow eyebrow--dark">{p.eyebrow}</div>
                <div class="col__counter">{String(ci + 1).padStart(2, "0")} / 02</div>
              </div>
              <h3 class="col__title">{p.title}</h3>
              {p.subtitle && <div class="col__subtitle">{p.subtitle}</div>}
            </div>

            <div class="col__media">
              <div class="col__img" data-col={ci} role="button" tabindex="0" aria-label={`Open ${p.title} lightbox`}>
                {p.slides.map((s, si) => (
                  <div class={`col__slide${si === 0 ? " is-active" : ""}`} data-slide={si}>
                    {s.image ? (
                      <img class="col__photo" src={s.image} alt={s.imageLabel} loading={si === 0 ? "eager" : "lazy"} decoding="async" />
                    ) : (
                      <Placeholder label={s.imageLabel} aspect="16/10" dark note="REPLACE" />
                    )}
                    {s.caption && <div class="col__caption">// {s.caption}</div>}
                  </div>
                ))}
              </div>

              <div class="col__bars" data-col={ci} aria-label="Slide progress">
                {Array.from({ length: N }).map((_, si) => (
                  <button class={`bar${si === 0 ? " is-active" : ""}`} data-col={ci} data-idx={si} aria-label={`Go to slide ${si + 1}`} type="button">
                    <span class="bar__fill"></span>
                  </button>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Scroll-revealed info rows. Aligned across columns via shared grid. ── -->
  <div class="rp__rowsband">
    <div class="rp__shell shell">
      <div class="rp__grid rp__grid--rows" style={`--n:${N}`}>
        {Array.from({ length: N }).map((_, si) => (
          <>
            {cols.map((p, ci) => (
              <button
                class={`row${si === 0 ? " is-active" : ""}`}
                data-col={ci}
                data-idx={si}
                style={`grid-row:${si + 1}; grid-column:${ci + 1};`}
                type="button"
                aria-label={`${p.title} — ${p.slides[si].title}`}
              >
                <span class="row__indicator" aria-hidden="true"></span>
                <span class="row__inner">
                  <span class="eyebrow eyebrow--dark">&gt; {p.slides[si].eyebrow}</span>
                  <span class="row__title">{p.slides[si].title}</span>
                  <span class="row__body">{p.slides[si].body}</span>
                </span>
              </button>
            ))}
          </>
        ))}
      </div>

      <div class="rp__ctas">
        {cols.map((p) => (
          <a class="rp__cta" href={p.href}>Open dedicated page →</a>
        ))}
      </div>
    </div>
  </div>

  <!-- Lightbox: rendered once, toggles visibility on click. ────────────── -->
  <div class="rplb" data-rplb hidden aria-hidden="true" data-rsec="lightbox">
    <div class="rplb__backdrop" data-rplb-close></div>
    <div class="rplb__panel" role="dialog" aria-modal="true" aria-labelledby="rplb-title">
      <div class="rplb__bars" data-rplb-bars>
        {Array.from({ length: N }).map((_, si) => (
          <button class="bar" data-rplb-bar={si} type="button" aria-label={`Slide ${si + 1}`}>
            <span class="bar__fill"></span>
          </button>
        ))}
      </div>

      <div class="rplb__main">
        <div class="rplb__media">
          {cols.map((p, ci) => (
            p.slides.map((s, si) => (
              <div class="rplb__slide" data-rplb-slide data-col={ci} data-idx={si} hidden>
                <div class="rplb__img">
                  {s.image ? (
                    <img class="rplb__photo" src={s.image} alt={s.imageLabel} loading="lazy" decoding="async" />
                  ) : (
                    <Placeholder label={s.imageLabel} aspect="16/10" dark note="REPLACE" />
                  )}
                  {s.caption && <div class="rplb__caption">{s.caption}</div>}
                </div>
                {s.extras && s.extras.length > 0 && (
                  <div class="rplb__thumbs">
                    {s.extras.map((e) => (
                      <div class="rplb__thumb">
                        {e.image ? (
                          <img class="rplb__thumb-photo" src={e.image} alt={e.label} loading="lazy" decoding="async" />
                        ) : (
                          <Placeholder label={e.label} aspect="4/3" dark />
                        )}
                      </div>
                    ))}
                  </div>
                )}
              </div>
            ))
          ))}

          <button class="rplb__nav rplb__nav--prev" data-rplb-prev aria-label="Previous slide" type="button">
            <svg width="15" height="15" viewBox="0 0 15 15" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="display:block">
              <rect x="9"  y="0"  width="3" height="3"/>
              <rect x="6"  y="3"  width="3" height="3"/>
              <rect x="3"  y="6"  width="3" height="3"/>
              <rect x="6"  y="9"  width="3" height="3"/>
              <rect x="9"  y="12" width="3" height="3"/>
            </svg>
          </button>
          <button class="rplb__nav rplb__nav--next" data-rplb-next aria-label="Next slide" type="button">
            <svg width="15" height="15" viewBox="0 0 15 15" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="display:block">
              <rect x="3"  y="0"  width="3" height="3"/>
              <rect x="6"  y="3"  width="3" height="3"/>
              <rect x="9"  y="6"  width="3" height="3"/>
              <rect x="6"  y="9"  width="3" height="3"/>
              <rect x="3"  y="12" width="3" height="3"/>
            </svg>
          </button>

          <!-- First-open tutorial: explains the click-to-navigate halves.
               Fades out after a few seconds or on the first interaction. -->
          <div class="rplb__hint" data-rplb-hint aria-hidden="true">
            <div class="rplb__hint-half rplb__hint-half--prev">
              <span class="rplb__hint-pill">‹ Click this side — back</span>
            </div>
            <div class="rplb__hint-line"></div>
            <div class="rplb__hint-half rplb__hint-half--next">
              <span class="rplb__hint-pill">Click this side — next ›</span>
            </div>
          </div>
        </div>

        <aside class="rplb__info">
          {cols.map((p, ci) => (
            p.slides.map((s, si) => (
              <div class="rplb__info-block" data-rplb-info data-col={ci} data-idx={si} hidden>
                <div class="eyebrow eyebrow--dark">&gt; {s.eyebrow}</div>
                <h4 id={ci === 0 && si === 0 ? "rplb-title" : undefined} class="rplb__title">{s.title}</h4>
                <p class="rplb__body">{s.longBody ?? s.body}</p>
                <div class="rplb__meta">
                  <span>{p.title}</span>
                  <span class="rplb__sep">·</span>
                  <span>{String(si + 1).padStart(2, "0")} / {String(N).padStart(2, "0")}</span>
                </div>
              </div>
            ))
          ))}
        </aside>
      </div>

      <button class="rplb__close" data-rplb-close type="button" aria-label="Close">
        <svg width="15" height="15" viewBox="0 0 15 15" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="display:block">
          <rect x="0"  y="0"  width="3" height="3"/>
          <rect x="12" y="0"  width="3" height="3"/>
          <rect x="3"  y="3"  width="3" height="3"/>
          <rect x="9"  y="3"  width="3" height="3"/>
          <rect x="6"  y="6"  width="3" height="3"/>
          <rect x="3"  y="9"  width="3" height="3"/>
          <rect x="9"  y="9"  width="3" height="3"/>
          <rect x="0"  y="12" width="3" height="3"/>
          <rect x="12" y="12" width="3" height="3"/>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  // ────────────────────────────────────────────────────────────────────────
  // Robotics dual-carousel state machine.
  //
  // Per spec (Here's the full spec in plain language.txt):
  // - Single shared activeIndex across both columns
  // - Auto-advance every ~4500ms when nothing is interacting
  // - Hover-intent 500ms on a row → switch to that index; bars freeze
  // - Click bar → jump; restart timer with a fresh 4500ms
  // - Click row OR image → open lightbox on THAT column at THAT index
  // - Lightbox: prev/next halves, top bars, keyboard arrows + Esc
  // ────────────────────────────────────────────────────────────────────────

  const TICK_MS = 4500;
  const HOVER_INTENT_MS = 500;
  const N = 5;

  const root = document.querySelector("[data-rp]") as HTMLElement | null;
  if (root) initRoboticsPanels(root);

  function initRoboticsPanels(root: HTMLElement) {
    const slidesByCol: NodeListOf<HTMLElement>[] = [
      root.querySelectorAll<HTMLElement>('[data-col="0"] .col__slide'),
      root.querySelectorAll<HTMLElement>('[data-col="1"] .col__slide'),
    ];
    const barsByCol: NodeListOf<HTMLElement>[] = [
      root.querySelectorAll<HTMLElement>('.col__bars[data-col="0"] .bar'),
      root.querySelectorAll<HTMLElement>('.col__bars[data-col="1"] .bar'),
    ];
    const rowsByCol: NodeListOf<HTMLElement>[] = [
      root.querySelectorAll<HTMLElement>('.row[data-col="0"]'),
      root.querySelectorAll<HTMLElement>('.row[data-col="1"]'),
    ];
    const images: NodeListOf<HTMLElement> =
      root.querySelectorAll<HTMLElement>(".col__img");

    let active = 0;
    let paused = false;
    let lbOpen = false;
    let tickHandle: number | null = null;
    let hoverIntentHandle: number | null = null;

    // ── Bar state ─────────────────────────────────────────────────────
    function renderBars(animateActive: boolean) {
      for (let c = 0; c < 2; c++) {
        barsByCol[c].forEach((bar, i) => {
          const fill = bar.querySelector(".bar__fill") as HTMLElement;
          if (!fill) return;
          fill.style.transition = "none";
          fill.style.animation = "none";
          if (i < active) {
            fill.style.width = "100%";
          } else if (i > active) {
            fill.style.width = "0%";
          } else if (i === active) {
            // Active bar
            if (animateActive && !paused && !lbOpen) {
              fill.style.width = "0%";
              // Force reflow so the animation restarts from 0.
              void fill.offsetWidth;
              fill.style.animation = `rp-fill ${TICK_MS}ms linear forwards`;
            } else {
              // Snap to full when frozen on hover (per spec) or paused.
              fill.style.width = paused ? "100%" : "0%";
            }
          }
        });
      }
    }

    // ── Slide / row visuals ───────────────────────────────────────────
    function renderActive(animateActive: boolean) {
      for (let c = 0; c < 2; c++) {
        slidesByCol[c].forEach((sl, i) => sl.classList.toggle("is-active", i === active));
        rowsByCol[c].forEach((r, i) => r.classList.toggle("is-active", i === active));
        barsByCol[c].forEach((b, i) => b.classList.toggle("is-active", i === active));
      }
      renderBars(animateActive);
    }

    // ── Timer ─────────────────────────────────────────────────────────
    function clearTimer() {
      if (tickHandle != null) {
        window.clearTimeout(tickHandle);
        tickHandle = null;
      }
    }
    function startTimer() {
      clearTimer();
      if (paused || lbOpen) return;
      tickHandle = window.setTimeout(() => {
        active = (active + 1) % N;
        renderActive(true);
        startTimer();
      }, TICK_MS);
    }
    function restart() {
      clearTimer();
      renderActive(true);
      startTimer();
    }

    function setActive(i: number, opts: { restart?: boolean } = {}) {
      active = ((i % N) + N) % N;
      if (opts.restart) restart();
      else renderActive(true);
    }

    // ── Hover behaviour on rows ───────────────────────────────────────
    function clearHoverIntent() {
      if (hoverIntentHandle != null) {
        window.clearTimeout(hoverIntentHandle);
        hoverIntentHandle = null;
      }
    }
    function attachRowHover(row: HTMLElement) {
      const idx = Number(row.dataset.idx);
      row.addEventListener("mouseenter", () => {
        if (lbOpen) return;
        paused = true;
        clearTimer();
        // Freeze the currently filling bar in place by snapping it.
        const fill = barsByCol[0][active]?.querySelector(".bar__fill") as HTMLElement | null;
        const fill2 = barsByCol[1][active]?.querySelector(".bar__fill") as HTMLElement | null;
        [fill, fill2].forEach((f) => {
          if (!f) return;
          // Read current computed width and apply it inline so the animation
          // halts visually where it was.
          const w = window.getComputedStyle(f).width;
          f.style.animation = "none";
          f.style.width = w;
        });
        clearHoverIntent();
        hoverIntentHandle = window.setTimeout(() => {
          if (lbOpen) return;
          active = idx;
          // Snap state: bars 0..idx-1 + idx all solid (user is actively on it).
          for (let c = 0; c < 2; c++) {
            slidesByCol[c].forEach((sl, i) => sl.classList.toggle("is-active", i === active));
            rowsByCol[c].forEach((r, i) => r.classList.toggle("is-active", i === active));
            barsByCol[c].forEach((b, i) => b.classList.toggle("is-active", i === active));
            barsByCol[c].forEach((bar, i) => {
              const f = bar.querySelector(".bar__fill") as HTMLElement;
              if (!f) return;
              f.style.animation = "none";
              f.style.transition = "none";
              if (i <= active) f.style.width = "100%";
              else f.style.width = "0%";
            });
          }
        }, HOVER_INTENT_MS);
      });
      row.addEventListener("mouseleave", () => {
        if (lbOpen) return;
        clearHoverIntent();
        paused = false;
        // Per spec: timer fully resets on leave — fresh 4500ms for the new
        // active bar to fill.
        restart();
      });
    }

    rowsByCol[0].forEach(attachRowHover);
    rowsByCol[1].forEach(attachRowHover);

    // ── Bar clicks (jump directly to that index) ──────────────────────
    function attachBarClick(bar: HTMLElement) {
      const idx = Number(bar.dataset.idx);
      bar.addEventListener("click", (e) => {
        e.stopPropagation();
        if (lbOpen) return;
        paused = false;
        active = idx;
        restart();
      });
    }
    barsByCol[0].forEach(attachBarClick);
    barsByCol[1].forEach(attachBarClick);

    // ── Lightbox plumbing ─────────────────────────────────────────────
    const lb = document.querySelector("[data-rplb]") as HTMLElement | null;
    if (!lb) return;

    const lbSlides = lb.querySelectorAll<HTMLElement>("[data-rplb-slide]");
    const lbInfos = lb.querySelectorAll<HTMLElement>("[data-rplb-info]");
    const lbBars = lb.querySelectorAll<HTMLElement>("[data-rplb-bar]");
    const lbPrev = lb.querySelector("[data-rplb-prev]") as HTMLElement | null;
    const lbNext = lb.querySelector("[data-rplb-next]") as HTMLElement | null;
    const lbMedia = lb.querySelector("[data-rplb] .rplb__media") as HTMLElement | null;
    const lbHint = lb.querySelector("[data-rplb-hint]") as HTMLElement | null;

    let lbCol = 0;
    let lbIdx = 0;
    let hintHandle: number | null = null;

    function lbRender() {
      lbSlides.forEach((el) => {
        const c = Number(el.dataset.col);
        const i = Number(el.dataset.idx);
        el.hidden = !(c === lbCol && i === lbIdx);
      });
      lbInfos.forEach((el) => {
        const c = Number(el.dataset.col);
        const i = Number(el.dataset.idx);
        el.hidden = !(c === lbCol && i === lbIdx);
      });
      lbBars.forEach((b, i) => {
        const f = b.querySelector(".bar__fill") as HTMLElement;
        if (!f) return;
        f.style.animation = "none";
        f.style.transition = "none";
        f.style.width = i <= lbIdx ? "100%" : "0%";
      });
    }

    // The click-zone tutorial overlay — show on open, dismiss on first
    // interaction or after a short timeout.
    function showHint() {
      if (!lbHint) return;
      lbHint.classList.add("is-on");
      if (hintHandle != null) window.clearTimeout(hintHandle);
      hintHandle = window.setTimeout(dismissHint, 3200);
    }
    function dismissHint() {
      if (!lbHint) return;
      lbHint.classList.remove("is-on");
      if (hintHandle != null) { window.clearTimeout(hintHandle); hintHandle = null; }
    }

    function openLb(col: number, idx: number) {
      lbCol = col;
      lbIdx = idx;
      lbOpen = true;
      paused = true;
      clearTimer();
      clearHoverIntent();
      // Move to <body> so it escapes .rp's stacking context and z-index: 100
      // wins against any sibling section with a higher local z-index.
      if (lb.parentElement !== document.body) document.body.appendChild(lb);
      lb.hidden = false;
      lb.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      (window as any).lenis?.stop();
      lbRender();
      // Animate in.
      requestAnimationFrame(() => lb.classList.add("is-open"));
      showHint();
    }
    function closeLb() {
      if (!lbOpen) return;
      lbOpen = false;
      paused = false;
      dismissHint();
      lb.classList.remove("is-open");
      lb.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      (window as any).lenis?.start();
      window.setTimeout(() => { lb.hidden = true; }, 220);
      // Per spec: timer resets and gets a fresh full interval.
      restart();
    }
    function step(d: number) {
      lbIdx = ((lbIdx + d) % N + N) % N;
      lbRender();
      dismissHint();
    }

    lb.querySelectorAll<HTMLElement>("[data-rplb-close]").forEach((el) =>
      el.addEventListener("click", closeLb)
    );
    lbPrev?.addEventListener("click", (e) => { e.stopPropagation(); step(-1); });
    lbNext?.addEventListener("click", (e) => { e.stopPropagation(); step(+1); });

    // Click anywhere on the media: left half → previous, right half → next.
    // The arrow buttons stopPropagation, so they don't double-fire here.
    lbMedia?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest(".rplb__nav")) return;
      const rect = lbMedia.getBoundingClientRect();
      if (e.clientX - rect.left < rect.width / 2) step(-1);
      else step(+1);
    });
    lbBars.forEach((b) =>
      b.addEventListener("click", (e) => {
        e.stopPropagation();
        lbIdx = Number(b.getAttribute("data-rplb-bar"));
        lbRender();
      })
    );
    document.addEventListener("keydown", (e) => {
      if (!lbOpen) return;
      if (e.key === "Escape") closeLb();
      else if (e.key === "ArrowLeft") step(-1);
      else if (e.key === "ArrowRight") step(+1);
    });

    // ── Click handlers on images + rows open the lightbox ─────────────
    images.forEach((img) => {
      const col = Number(img.dataset.col);
      img.addEventListener("click", () => openLb(col, active));
      img.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openLb(col, active);
        }
      });
    });
    rowsByCol[0].forEach((r) => r.addEventListener("click", () => openLb(0, Number(r.dataset.idx))));
    rowsByCol[1].forEach((r) => r.addEventListener("click", () => openLb(1, Number(r.dataset.idx))));

    // ── Visibility: only auto-advance while the section is in view ────
    let inView = false;
    const io = new IntersectionObserver(
      (entries) => {
        inView = entries[0]?.isIntersecting ?? false;
        if (!inView) clearTimer();
        else if (!lbOpen && !paused && !document.hidden) startTimer();
      },
      { rootMargin: "0px 0px -20% 0px" }
    );
    io.observe(root);

    // Also pause when the tab is hidden — no point ticking the carousel
    // when the user has switched away.
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) clearTimer();
      else if (inView && !lbOpen && !paused) startTimer();
    });

    // Initial paint.
    renderActive(true);
    startTimer();
  }
</script>

<style>
  /* ── Layout ──────────────────────────────────────────────────────── */
  .rp {
    position: relative;
    z-index: 2; /* opaquely cover the fixed wave canvas behind it */
    background: var(--dark);
    color: var(--dark-ink);
    /* No bottom padding — the rows + CTAs already provide the scroll
       distance; extra padding here only pads the pin release, forcing the
       user to keep scrolling past the CTAs before the next section appears. */
    padding: 0;
  }
  .rp__shell { padding: 0 var(--page-pad); }

  /* Sticky band pins to top of viewport while rows scroll past.
     Top is negative so engagement is *delayed* — pinning kicks in when the
     column eyebrows ("Impactful Robotics" / "Competitive Robotics") reach
     the top of the viewport, rather than the moment the section enters.
     The padding-top above the eyebrows scrolls under the topbar / off-screen
     before the pin engages. The dark background fills under the auto-hiding
     topbar so rows below never peek through. */
  .rp__stickytop {
    position: sticky;
    top: calc(-1 * var(--topbar-h));
    z-index: 5;
    background: var(--dark);
    padding: calc(var(--topbar-h) + 14px) 0 18px;
    border-bottom: 1px solid var(--dark-line-soft);
  }

  .rp__grid { display: grid; gap: 28px; }
  .rp__grid--top { grid-template-columns: 1fr 1fr; }
  .rp__grid--rows {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: repeat(var(--n, 5), auto);
    margin-top: 28px;
  }

  /* ── Column header (above image) ─────────────────────────────────── */
  .col__head { margin-bottom: 16px; }
  .col__topline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .col__counter {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    color: var(--dark-mute);
    text-transform: uppercase;
  }
  .col__title {
    font-family: var(--font-tech);
    font-size: clamp(36px, 5vw, 60px);
    line-height: 0.95;
    margin: 6px 0 0;
    color: var(--dark-ink);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-weight: 600;
  }
  .col__subtitle {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 8px;
  }

  /* ── Media (image stack + bars) ──────────────────────────────────── */
  .col__media { display: flex; flex-direction: column; gap: 10px; }
  .col__img {
    position: relative;
    aspect-ratio: 16/10;
    cursor: zoom-in;
    outline: none;
    isolation: isolate;
  }
  .col__img:focus-visible { box-shadow: 0 0 0 2px var(--accent); }
  .col__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 450ms ease;
  }
