---
import { SITE, DEDICATED_PAGES } from "@/data/content";
import LinkedInCard from "@/components/LinkedInCard.astro";
import CopyEmailButton from "@/components/islands/CopyEmailButton.tsx";
import { encodeObf } from "@/lib/contact";
// tone="dark": always dark. darkUntil="<selector>": dark while that dark
// section is still under the bar, light once it scrolls past.
const { tone, darkUntil } = Astro.props as { tone?: "dark"; darkUntil?: string };
---
<header class={`topbar${tone === "dark" ? " topbar--dark" : ""}`} data-dark-until={darkUntil}>
  <div class="topbar__shell shell">
    <a class="topbar__brand" href="/">
      {SITE.name}
      <span class="topbar__dot" aria-hidden="true"></span>
    </a>
    <button
      class="topbar__menu-btn"
      data-menu-btn
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="topbar-nav"
    ></button>
    <nav class="topbar__nav" id="topbar-nav" aria-label="Primary">
      {DEDICATED_PAGES.map((p) => (
        <a class="topbar__link" href={p.href}>{p.label}</a>
      ))}
      <CopyEmailButton client:load emailObf={encodeObf(SITE.contact.email)} mask={SITE.contact.email.replace(/[^@.]/g, "•")} />
      <a class="topbar__btn" href="/resume/">Résumé</a>
      <LinkedInCard />
    </nav>
  </div>
</header>

<script>
  // Hide the top bar when scrolling down past the hero; bring it back as soon
  // as the user nudges upward. Always show within the first ~120px of the page.
  const bar = document.querySelector<HTMLElement>(".topbar");
  const menuBtn = document.querySelector<HTMLElement>("[data-menu-btn]");
  if (bar) {
    // ── Mobile dropdown menu (hamburger shown ≤880px via CSS) ──
    const closeMenu = () => {
      bar.classList.remove("topbar--menu-open");
      menuBtn?.setAttribute("aria-expanded", "false");
    };
    if (menuBtn) {
      menuBtn.addEventListener("click", () => {
        const open = bar.classList.toggle("topbar--menu-open");
        menuBtn.setAttribute("aria-expanded", String(open));
      });
      // Navigating closes the menu so it doesn't linger over the next view.
      bar.querySelectorAll<HTMLAnchorElement>(".topbar__nav a")
        .forEach((a) => a.addEventListener("click", closeMenu));
    }

    const SHOW_AT_TOP = 120;     // px from top — always visible inside this zone
    const UP_DELTA = 6;          // min upward movement to reveal
    const DOWN_DELTA = 4;        // min downward movement to hide
    let lastY = window.scrollY;
    let hidden = false;
    let ticking = false;

    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const dy = y - lastY;
      if (y < SHOW_AT_TOP) {
        if (hidden) { hidden = false; bar.classList.remove("topbar--hidden"); }
      } else if (dy > DOWN_DELTA) {
        // Hiding the bar also collapses an open menu so it can't float detached.
        if (!hidden) { hidden = true; bar.classList.add("topbar--hidden"); closeMenu(); }
      } else if (dy < -UP_DELTA) {
        if (hidden) { hidden = false; bar.classList.remove("topbar--hidden"); }
      }
      lastY = y;
    };

    window.addEventListener("scroll", () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
  }

  // ── Dark tone while a dark hero is under the bar ──
  const darkSel = document.querySelector<HTMLElement>(".topbar")?.dataset.darkUntil;
  const darkEl = darkSel ? document.querySelector<HTMLElement>(darkSel) : null;
  if (darkEl) {
    const topbarEl = document.querySelector<HTMLElement>(".topbar")!;
    const syncTone = () => {
      const underBar = darkEl.getBoundingClientRect().bottom > topbarEl.offsetHeight;
      topbarEl.classList.toggle("topbar--dark", underBar);
    };
    syncTone();
    window.addEventListener("scroll", syncTone, { passive: true });
    window.addEventListener("resize", syncTone, { passive: true });
  }
</script>

<style>
  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 22px var(--page-pad);
    background: var(--bg);
    border-bottom: 1px solid var(--rule-soft);
    transition: transform .28s cubic-bezier(.4, 0, .2, 1);
    will-change: transform;
  }
  .topbar--hidden {
    transform: translateY(-100%);
  }
  /* Dark tone for pages/sections that open on the dark background. */
  .topbar--dark {
    --bg: var(--dark);
    --ink: var(--dark-ink);
    --rule: var(--dark-line);
    --rule-soft: var(--dark-line-soft);
  }
  @media (prefers-reduced-motion: reduce) {
    .topbar { transition: none; }
    .topbar--hidden { transform: none; }
  }
  .topbar__shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .topbar__brand {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.01em;
    color: var(--ink);
    display: inline-flex;
    align-items: baseline;
  }
  .topbar__dot {
    display: inline-block;
    margin-left: 6px;
    width: 8px;
    height: 8px;
    background: var(--accent);
  }
  .topbar__nav {
    display: flex;
    gap: 24px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .topbar__link {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
  }
  .topbar__link:hover { color: var(--accent); }
  .topbar__btn {
    padding: 8px 14px;
    border: 2px solid var(--rule);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
  }
  .topbar__btn:hover { background: var(--ink); color: var(--bg); }
  /* Hamburger — hidden on desktop, shown ≤880px (see media query). */
  .topbar__menu-btn {
    display: none;
    width: 44px;
    height: 38px;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--ink);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
  }
  .topbar__menu-btn::before { content: "\2630"; }                    /* ☰ */
  .topbar--menu-open .topbar__menu-btn::before { content: "\2715"; } /* ✕ */
  .topbar__menu-btn:hover { color: var(--accent); border-color: var(--accent); }

  @media (max-width: 880px) {
    /* Collapse the nav behind the hamburger so the fixed bar stays a single
       row (~66px) and never overruns the 78px the body reserves for it —
       which is what was hiding the hero headline behind the bar. */
    .topbar__menu-btn { display: inline-flex; }
    .topbar__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 10px var(--page-pad) 18px;
      background: var(--bg);
      border-bottom: 1px solid var(--rule-soft);
      box-shadow: 0 16px 30px rgba(0, 0, 0, 0.12);
      display: none;
    }
    .topbar--menu-open .topbar__nav { display: flex; }
    .topbar__link { font-size: 15px; padding: 10px 0; }
    .topbar__btn { align-self: flex-start; margin-top: 6px; }
  }
</style>
