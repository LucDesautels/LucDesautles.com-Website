---
import { SITE, DEDICATED_PAGES, RESUME_HREF } from "@/data/content";
import CopyEmailButton from "@/components/islands/CopyEmailButton.tsx";
---
<header class="topbar">
  <div class="topbar__shell shell">
    <a class="topbar__brand" href="/">
      Luc Desautels
      <span class="topbar__dot" aria-hidden="true"></span>
    </a>
    <button
      class="topbar__menu-btn"
      data-menu-btn
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="topbar-nav"
    ></button>
    <nav class="topbar__nav" id="topbar-nav" aria-label="Primary">
      {DEDICATED_PAGES.map((p) => (
        <a class="topbar__link" href={p.href}>{p.label}</a>
      ))}
      <CopyEmailButton client:load email={SITE.contact.email} />
      <a class="topbar__btn" href={RESUME_HREF}>Résumé</a>
      <a
        class="topbar__linkedin"
        href={`https://${SITE.contact.linkedin}`}
        target="_blank"
        rel="noreferrer"
        aria-label="LinkedIn"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.65-1.85 3.39-1.85 3.62 0 4.29 2.38 4.29 5.48v6.26zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
        </svg>
      </a>
    </nav>
  </div>
</header>

<script>
  // Hide the top bar when scrolling down past the hero; bring it back as soon
  // as the user nudges upward. Always show within the first ~120px of the page.
  const bar = document.querySelector<HTMLElement>(".topbar");
  const menuBtn = document.querySelector<HTMLElement>("[data-menu-btn]");
  if (bar) {
    // ── Mobile dropdown menu (hamburger shown ≤880px via CSS) ──
    const closeMenu = () => {
      bar.classList.remove("topbar--menu-open");
      menuBtn?.setAttribute("aria-expanded", "false");
    };
    if (menuBtn) {
      menuBtn.addEventListener("click", () => {
        const open = bar.classList.toggle("topbar--menu-open");
        menuBtn.setAttribute("aria-expanded", String(open));
      });
      // Navigating closes the menu so it doesn't linger over the next view.
      bar.querySelectorAll<HTMLAnchorElement>(".topbar__nav a")
        .forEach((a) => a.addEventListener("click", closeMenu));
    }

    const SHOW_AT_TOP = 120;     // px from top — always visible inside this zone
    const UP_DELTA = 6;          // min upward movement to reveal
    const DOWN_DELTA = 4;        // min downward movement to hide
    let lastY = window.scrollY;
    let hidden = false;
    let ticking = false;

    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const dy = y - lastY;
      if (y < SHOW_AT_TOP) {
        if (hidden) { hidden = false; bar.classList.remove("topbar--hidden"); }
      } else if (dy > DOWN_DELTA) {
        // Hiding the bar also collapses an open menu so it can't float detached.
        if (!hidden) { hidden = true; bar.classList.add("topbar--hidden"); closeMenu(); }
      } else if (dy < -UP_DELTA) {
        if (hidden) { hidden = false; bar.classList.remove("topbar--hidden"); }
      }
      lastY = y;
    };

    window.addEventListener("scroll", () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
  }
</script>

<style>
  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 22px var(--page-pad);
    background: var(--bg);
    border-bottom: 1px solid var(--rule-soft);
    transition: transform .28s cubic-bezier(.4, 0, .2, 1);
    will-change: transform;
  }
  .topbar--hidden {
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .topbar { transition: none; }
    .topbar--hidden { transform: none; }
  }
  .topbar__shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .topbar__brand {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.01em;
    color: var(--ink);
    display: inline-flex;
    align-items: baseline;
  }
  .topbar__dot {
    display: inline-block;
    margin-left: 6px;
    width: 8px;
    height: 8px;
    background: var(--accent);
  }
  .topbar__nav {
    display: flex;
    gap: 24px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .topbar__link {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
  }
  .topbar__link:hover { color: var(--accent); }
  .topbar__btn {
    padding: 8px 14px;
    border: 2px solid var(--rule);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
  }
  .topbar__btn:hover { background: var(--ink); color: var(--bg); }
  .topbar__linkedin {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #0a66c2;
    color: #fff;
    border-radius: 4px;
  }

  /* Hamburger — hidden on desktop, shown ≤880px (see media query). */
  .topbar__menu-btn {
    display: none;
    width: 44px;
    height: 38px;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--ink);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
  }
  .topbar__menu-btn::before { content: "\2630"; }                    /* ☰ */
  .topbar--menu-open .topbar__menu-btn::before { content: "\2715"; } /* ✕ */
  .topbar__menu-btn:hover { color: var(--accent); border-color: var(--accent); }

  @media (max-width: 880px) {
    /* Collapse the nav behind the hamburger so the fixed bar stays a single
       row (~66px) and never overruns the 78px the body reserves for it —
       which is what was hiding the hero headline behind the bar. */
    .topbar__menu-btn { display: inline-flex; }
    .topbar__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 10px var(--page-pad) 18px;
      background: var(--bg);
      border-bottom: 1px solid var(--rule-soft);
      box-shadow: 0 16px 30px rgba(0, 0, 0, 0.12);
      display: none;
    }
    .topbar--menu-open .topbar__nav { display: flex; }
    .topbar__link { font-size: 15px; padding: 10px 0; }
    .topbar__btn { align-self: flex-start; margin-top: 6px; }
  }
</style>
