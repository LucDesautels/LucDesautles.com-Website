---
import { SITE, DEDICATED_PAGES } from "@/data/content";
import CopyEmailButton from "@/components/islands/CopyEmailButton.tsx";
---
<header class="topbar">
  <div class="topbar__shell shell">
    <a class="topbar__brand" href="/">
      {SITE.name}
      <span class="topbar__dot" aria-hidden="true"></span>
    </a>
    <button
      class="topbar__menu-btn"
      data-menu-btn
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="topbar-nav"
    ></button>
    <nav class="topbar__nav" id="topbar-nav" aria-label="Primary">
      {DEDICATED_PAGES.map((p) => (
        <a class="topbar__link" href={p.href}>{p.label}</a>
      ))}
      <CopyEmailButton client:load email={SITE.contact.email} />
      <a class="topbar__btn" href="/resume/">Résumé</a>
      <div class="topbar__li-wrap" data-li-wrap>
        <a
          class="topbar__linkedin"
          href={`https://${SITE.contact.linkedin}`}
          target="_blank"
          rel="noreferrer"
          aria-label="LinkedIn"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.65-1.85 3.39-1.85 3.62 0 4.29 2.38 4.29 5.48v6.26zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
          </svg>
        </a>
        <div class="topbar__li-popup" data-li-popup>
          <div class="topbar__li-badge-wrap">
            <div
              class="badge-base LI-profile-badge"
              data-locale="en_US"
              data-size="medium"
              data-theme="light"
              data-type="HORIZONTAL"
              data-vanity="luc-desautels"
              data-version="v1"
            >
              <a class="badge-base__link LI-simple-link" href="https://ca.linkedin.com/in/luc-desautels?trk=profile-badge">Luc Desautels</a>
            </div>
            <button
              type="button"
              class="topbar__li-overlay"
              data-li-overlay
              aria-label="Open Luc Desautels' LinkedIn profile in a new tab"
            ></button>
          </div>
          <script async defer src="https://platform.linkedin.com/badges/js/profile.js"></script>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  // Hide the top bar when scrolling down past the hero; bring it back as soon
  // as the user nudges upward. Always show within the first ~120px of the page.
  const bar = document.querySelector<HTMLElement>(".topbar");
  const menuBtn = document.querySelector<HTMLElement>("[data-menu-btn]");
  if (bar) {
    // ── Mobile dropdown menu (hamburger shown ≤880px via CSS) ──
    const closeMenu = () => {
      bar.classList.remove("topbar--menu-open");
      menuBtn?.setAttribute("aria-expanded", "false");
    };
    if (menuBtn) {
      menuBtn.addEventListener("click", () => {
        const open = bar.classList.toggle("topbar--menu-open");
        menuBtn.setAttribute("aria-expanded", String(open));
      });
      // Navigating closes the menu so it doesn't linger over the next view.
      bar.querySelectorAll<HTMLAnchorElement>(".topbar__nav a")
        .forEach((a) => a.addEventListener("click", closeMenu));
    }

    const SHOW_AT_TOP = 120;     // px from top — always visible inside this zone
    const UP_DELTA = 6;          // min upward movement to reveal
    const DOWN_DELTA = 4;        // min downward movement to hide
    let lastY = window.scrollY;
    let hidden = false;
    let ticking = false;

    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const dy = y - lastY;
      if (y < SHOW_AT_TOP) {
        if (hidden) { hidden = false; bar.classList.remove("topbar--hidden"); }
      } else if (dy > DOWN_DELTA) {
        // Hiding the bar also collapses an open menu so it can't float detached.
        if (!hidden) { hidden = true; bar.classList.add("topbar--hidden"); closeMenu(); }
      } else if (dy < -UP_DELTA) {
        if (hidden) { hidden = false; bar.classList.remove("topbar--hidden"); }
      }
      lastY = y;
    };

    window.addEventListener("scroll", () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
  }

  // ── LinkedIn badge hover popup ──
  const liWrap = document.querySelector<HTMLElement>("[data-li-wrap]");
  const liPopup = document.querySelector<HTMLElement>("[data-li-popup]");
  const liOverlay = document.querySelector<HTMLButtonElement>("[data-li-overlay]");
  // The embed is a cross-origin iframe LinkedIn controls, and its internal
  // links (including "View profile") navigate the current tab rather than
  // opening a new one. We can't reach into the iframe to fix that, so an
  // invisible button sits on top and catches every click before it reaches
  // the iframe, opening the profile in a new tab ourselves instead.
  liOverlay?.addEventListener("click", () => {
    window.open("https://ca.linkedin.com/in/luc-desautels?trk=profile-badge", "_blank", "noopener,noreferrer");
  });
  if (liWrap && liPopup) {
    const VIEWPORT_MARGIN = 12;
    const positionPopup = () => {
      // Reset to the default (right-aligned) spot before measuring, then
      // nudge left/right only as far as needed to stay on-screen.
      liPopup.style.left = "auto";
      liPopup.style.right = "0px";
      const rect = liPopup.getBoundingClientRect();
      let shift = 0;
      if (rect.right > window.innerWidth - VIEWPORT_MARGIN) {
        shift = window.innerWidth - VIEWPORT_MARGIN - rect.right;
      } else if (rect.left < VIEWPORT_MARGIN) {
        shift = VIEWPORT_MARGIN - rect.left;
      }
      if (shift !== 0) {
        liPopup.style.right = `${0 - shift}px`;
      }
    };

    const showPopup = () => {
      liWrap.classList.add("topbar__li-wrap--open");
      requestAnimationFrame(positionPopup);
    };
    const hidePopup = () => {
      liWrap.classList.remove("topbar__li-wrap--open");
    };

    liWrap.addEventListener("mouseenter", showPopup);
    liWrap.addEventListener("mouseleave", hidePopup);
    liWrap.addEventListener("focusin", showPopup);
    liWrap.addEventListener("focusout", (e) => {
      if (!liWrap.contains((e as FocusEvent).relatedTarget as Node)) hidePopup();
    });
    window.addEventListener("resize", () => {
      if (liWrap.classList.contains("topbar__li-wrap--open")) positionPopup();
    }, { passive: true });
  }
</script>

<style>
  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 22px var(--page-pad);
    background: var(--bg);
    border-bottom: 1px solid var(--rule-soft);
    transition: transform .28s cubic-bezier(.4, 0, .2, 1);
    will-change: transform;
  }
  .topbar--hidden {
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .topbar { transition: none; }
    .topbar--hidden { transform: none; }
  }
  .topbar__shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .topbar__brand {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.01em;
    color: var(--ink);
    display: inline-flex;
    align-items: baseline;
  }
  .topbar__dot {
    display: inline-block;
    margin-left: 6px;
    width: 8px;
    height: 8px;
    background: var(--accent);
  }
  .topbar__nav {
    display: flex;
    gap: 24px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .topbar__link {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
  }
  .topbar__link:hover { color: var(--accent); }
  .topbar__btn {
    padding: 8px 14px;
    border: 2px solid var(--rule);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
  }
  .topbar__btn:hover { background: var(--ink); color: var(--bg); }
  .topbar__linkedin {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #0a66c2;
    color: #fff;
    border-radius: 4px;
  }
  .topbar__li-wrap {
    position: relative;
    display: inline-flex;
    align-self: center;
  }
  .topbar__li-popup {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 60;
    /* Invisible bridge, not a visual gap: it keeps the popup touching the
       icon's hit box so mousing down into it doesn't cross dead space and
       trip mouseleave before the cursor arrives. */
    padding-top: 10px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity .18s ease, transform .18s ease, visibility .18s;
    pointer-events: none;
  }
  .topbar__li-wrap--open .topbar__li-popup {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .topbar__li-popup { transition: opacity .18s ease, visibility .18s; }
  }
  .topbar__li-badge-wrap {
    position: relative;
    line-height: 0;
  }
  /* The embed still ships a plain-text fallback link alongside the iframe;
     once the iframe renders, the badge already shows the name, so drop the
     duplicate line instead of showing both. */
  .LI-profile-badge:has(iframe) > .LI-simple-link {
    display: none;
  }
  /* While the real embed is loading (or if it's blocked, e.g. by an ad
     blocker), give the plain-text fallback its own small card instead of
     floating unstyled text with no container. */
  .LI-simple-link {
    display: inline-block;
    padding: 10px 14px;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 8px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.14);
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--ink);
  }
  .topbar__li-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  /* Hamburger — hidden on desktop, shown ≤880px (see media query). */
  .topbar__menu-btn {
    display: none;
    width: 44px;
    height: 38px;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--ink);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
  }
  .topbar__menu-btn::before { content: "\2630"; }                    /* ☰ */
  .topbar--menu-open .topbar__menu-btn::before { content: "\2715"; } /* ✕ */
  .topbar__menu-btn:hover { color: var(--accent); border-color: var(--accent); }

  @media (max-width: 880px) {
    /* Collapse the nav behind the hamburger so the fixed bar stays a single
       row (~66px) and never overruns the 78px the body reserves for it —
       which is what was hiding the hero headline behind the bar. */
    .topbar__menu-btn { display: inline-flex; }
    .topbar__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 10px var(--page-pad) 18px;
      background: var(--bg);
      border-bottom: 1px solid var(--rule-soft);
      box-shadow: 0 16px 30px rgba(0, 0, 0, 0.12);
      display: none;
    }
    .topbar--menu-open .topbar__nav { display: flex; }
    .topbar__link { font-size: 15px; padding: 10px 0; }
    .topbar__btn { align-self: flex-start; margin-top: 6px; }
  }
</style>
