---
// Global animated wavy-line background — a single canvas paints across the
// entire page (no per-section sub-canvases, no hole punches). The canvas reads
// from window.__wfConfig.main every frame and listens for "wf-config-change"
// to rebuild structural state (e.g. line count).
//
// Continuity across HorizontalTOC:
//   - The horizontal scroll-jack publishes its current strip translateX +
//     dominant section tone via window.__wfState. The wave sampler offsets
//     its x by that translateX while the htoc region is on-screen, so the
//     wave pattern slides horizontally in lockstep with the tiles.
//   - The stroke colour lerps from dark-ink (light sections) → light-ink
//     (dark sections) based on the htoc's published tone darkness, with
//     opacity from horiz.opacityDark / horiz.opacityLight (with optional
//     fade ease + fade window from main config).
//
// Interaction model is intentionally small:
//   - Hover: "drape" only (cursor pulls nearby line baselines toward it).
//   - Click: "droplet" only (an expanding ring is visible; lines bend
//     outward at the ring's leading edge — same coherent wavefield treats
//     it as a radial bump, so there's nothing janky to reconcile).
---
<canvas class="wavefield" data-wavefield aria-hidden="true"></canvas>

<script>
  const ENABLED = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canvas = document.querySelector<HTMLCanvasElement>("[data-wavefield]");
  if (canvas && ENABLED) init(canvas);

  function getCfg() {
    return (window as any).__wfConfig as any;
  }

  // ── Shared cross-component state, written by HorizontalTOC each frame ─
  type WfState = {
    htocShiftX: number;    // current strip translateX (px); 0 outside htoc
    htocActive: number;    // 0..1 — how much the htoc region is on-screen
    htocDarkness: number;  // 0..1 — current dominant section darkness
    htocBounds: { top: number; bottom: number } | null;
    htocPinOffset: number; // accumulated scroll spent inside the pin range
  };
  function getState(): WfState {
    return ((window as any).__wfState as WfState) ?? {
      htocShiftX: 0, htocActive: 0, htocDarkness: 0, htocBounds: null,
      htocPinOffset: 0,
    };
  }

  function init(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d")!;

    // ── Canvas + viewport sizing ──────────────────────────────────
    let W = 0, H = 0, DPR = 1;
    function resize() {
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = Math.floor(W * DPR);
      canvas.height = Math.floor(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }
    resize();
    window.addEventListener("resize", () => { resize(); rebuildLines(); });

    // ── Click droplets — visible expanding ring + radial line push ────
    type Drop = { x: number; yDoc: number; t0: number };
    const drops: Drop[] = [];
    const DROP_LIFE = 3.2;     // seconds
    const DROP_SPEED = 240;    // px/s — radius growth
    const DROP_FW = 110;       // px — bell-curve front-width
    const DROP_AMP = 36;       // px — peak line displacement at the ring

    // ── Document-anchored line catalogue ──────────────────────────
    type Line = { yDoc: number; amp: number };
    let lines: Line[] = [];

    function rebuildLines() {
      const vh = window.innerHeight;
      const docH = Math.max(
        document.documentElement.scrollHeight,
        document.documentElement.clientHeight
      );
      const cfg = getCfg();
      const linesPerViewport = Math.max(1, Math.round((cfg?.main?.lineCount ?? 5)));
      const spacing = vh / linesPerViewport;
      const N = Math.ceil(docH / spacing) + linesPerViewport;
      lines = [];
      for (let i = 0; i < N; i++) {
        const seed = i * 1.61803398;
        const j1 = Math.sin(seed * 4.32) * 0.5 + 0.5;
        const j2 = Math.sin(seed * 2.71) * 0.5 + 0.5;
        lines.push({
          yDoc: i * spacing + j1 * spacing * 0.16,
          amp:  20 + j2 * 10,
        });
      }
    }
    rebuildLines();

    const docResizeObserver = new ResizeObserver(() => rebuildLines());
    docResizeObserver.observe(document.body);

    // Config-driven rebuilds.
    window.addEventListener("wf-config-change", (e) => {
      const k = (e as CustomEvent).detail?.key;
      if (k === "main.lineCount" || k === "__init") rebuildLines();
    });

    // ── Cursor tracking (viewport coords) ─────────────────────────
    const cursor = { x: -9999, y: -9999, has: false };
    window.addEventListener("pointermove", (e) => {
      cursor.x = e.clientX;
      cursor.y = e.clientY;
      cursor.has = true;
    }, { passive: true });
    window.addEventListener("pointerleave", () => { cursor.has = false; });

    // ── Click → spawn droplet (DOC coords so they scroll with page) ───
    window.addEventListener("pointerdown", (e) => {
      if ((e.target as HTMLElement)?.closest("[data-wf-tuner]")) return;
      drops.push({
        x: e.clientX,
        yDoc: e.clientY + window.scrollY,
        t0: performance.now(),
      });
      if (drops.length > 12) drops.shift();
    }, { passive: true });

    // ── Coherent ocean-swell wave field ───────────────────────────
    function waveField(x: number, yDoc: number, t: number, speedMul: number): number {
      const ts = t * speedMul;
      const a = Math.sin(x * 0.0068 + yDoc * 0.0021 - ts * 0.00055);
      const b = Math.sin(x * 0.0115 - yDoc * 0.0033 - ts * 0.00082);
      const c = Math.sin(x * 0.0043 + yDoc * 0.0012 - ts * 0.00040);
      return a * 0.52 + b * 0.28 + c * 0.30;
    }

    // ── Hover (drape only): cursor pulls nearby baselines toward it ──
    function drapeOffset(x: number, baseY: number, now: number, mul: number): number {
      if (!cursor.has || mul <= 0) return 0;
      const dx = x - cursor.x;
      const dy = baseY - cursor.y;
      const dist = Math.hypot(dx, dy);
      const R = 720;
      const k = Math.max(0, 1 - dist / R);
      const bell = k * k;
      const pull = (cursor.y - baseY) * 0.40 * bell;
      const ripple = Math.sin(dist * 0.014 - now * 0.0024) /
                     (1 + dist * 0.004) * 11;
      return (pull + ripple) * mul;
    }

    // ── Droplet displacement: bell-curve at the expanding ring edge ───
    function dropletOffset(x: number, baseYDoc: number, now: number): number {
      let acc = 0;
      for (const d of drops) {
        const age = (now - d.t0) / 1000;
        if (age > DROP_LIFE) continue;
        const dx = x - d.x;
        const dy = baseYDoc - d.yDoc;
        const dist = Math.hypot(dx, dy);
        const r = age * DROP_SPEED;
        const off = dist - r;
        if (Math.abs(off) > DROP_FW) continue;
        const bell = Math.cos((off / DROP_FW) * (Math.PI / 2));
        const decay = 1 - age / DROP_LIFE;
        const ny = dy / (dist || 1);
        acc += -bell * decay * DROP_AMP * ny;
      }
      return acc;
    }

    // ── Colour helpers ────────────────────────────────────────────────
    // Lerps stroke + opacity between "dark ink on light bg" and "light ink
    // on dark bg" by the htoc darkness factor, with a tunable smoothstep
    // window so the boundary doesn't pop.
    function smoothstep(edge0: number, edge1: number, x: number): number {
      if (edge0 === edge1) return x < edge0 ? 0 : 1;
      const t = Math.max(0, Math.min(1, (x - edge0) / (edge1 - edge0)));
      return t * t * (3 - 2 * t);
    }
    function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }

    // ── Render loop ───────────────────────────────────────────────
    let running = !document.hidden;
    let rafHandle = 0;
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        running = false;
        if (rafHandle) cancelAnimationFrame(rafHandle);
      } else if (!running) {
        running = true;
        rafHandle = requestAnimationFrame(tick);
      }
    });

    function tick() {
      if (!running) return;
      const now = performance.now();
      const realScrollY = window.scrollY;
      const cfg = getCfg() || {};
      const mainCfg = cfg.main || {};
      const horizCfg = cfg.horiz || {};
      const cursorMul = mainCfg.cursorReact ?? 1;
      const speedMul = mainCfg.naturalSpeed ?? 1;
      const ampMul = mainCfg.naturalAmp ?? 1;
      const thickness = mainCfg.thickness ?? 1.6;
      const opacityLight = mainCfg.opacity ?? 0.22;          // light-bg stroke alpha
      const opacityDark = horizCfg.opacityDark ?? 0.32;      // dark-bg stroke alpha
      const fadeStart = horizCfg.fadeStart ?? 0.25;          // smoothstep edge0
      const fadeEnd   = horizCfg.fadeEnd   ?? 0.65;          // smoothstep edge1

      const st = getState();
      // Dark-ness drives stroke color + opacity blending.
      const darkness = smoothstep(fadeStart, fadeEnd, st.htocDarkness ?? 0);

      // Subtract the htoc's accumulated pin offset from the real scrollY.
      // During pin, the offset grows linearly with realScrollY, so the
      // effective value stays at pinStartY (waves freeze vertically).
      // After pin, the offset is constant, so effectiveScrollY tracks
      // realScrollY again — continuous across the exit boundary, no snap.
      const scrollY = realScrollY - (st.htocPinOffset ?? 0);

      // Fade the wave field out below the IMPACTFUL / COMPETITIVE ROBOTICS
      // wordmark — past that point only the RoboticsTransition's own
      // animation belongs in the strip between wordmark and dark panels.
      // We anchor to the wordmark element; once its bottom is above the
      // viewport top, the fade is complete.
      let waveAlphaMul = 1;
      const fadeAnchor = document.querySelector(".ric__wordmark") as HTMLElement | null;
      if (fadeAnchor) {
        const fb = fadeAnchor.getBoundingClientRect().bottom;
        // fb > FADE_START_Y: fully visible; fb < FADE_END_Y: fully hidden.
        const FADE_START_Y = 240;
        const FADE_END_Y = -40;
        const t = (fb - FADE_END_Y) / (FADE_START_Y - FADE_END_Y);
        waveAlphaMul = Math.max(0, Math.min(1, t));
      }

      // Cull old drops.
      for (let i = drops.length - 1; i >= 0; i--) {
        if ((now - drops[i].t0) / 1000 > DROP_LIFE + 0.1) drops.splice(i, 1);
      }

      ctx.clearRect(0, 0, W, H);

      // ── Wave lines ───────────────────────────────────────────────
      const stepX = 6;
      // X-shift for wave sampling — slides the pattern horizontally with
      // the htoc strip. Scaled by htocActive (0 outside htoc, 1 inside) so
      // the rest of the page isn't influenced by a phantom shift value.
      const shiftX = (st.htocShiftX || 0) * (st.htocActive ?? 0);

      // Stroke colour: lerp 26,23,20 (dark ink) ↔ 244,237,226 (light ink).
      const r = Math.round(lerp(26, 244, darkness));
      const g = Math.round(lerp(23, 237, darkness));
      const b = Math.round(lerp(20, 226, darkness));
      const alpha = lerp(opacityLight, opacityDark, darkness) * waveAlphaMul;
      ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
      ctx.lineWidth = thickness;
      // Cheap early-out when fully faded — saves a chunk of CPU while
      // the user is parked in the wordmark / robotics area.
      if (waveAlphaMul <= 0.001) {
        rafHandle = requestAnimationFrame(tick);
        return;
      }

      for (let li = 0; li < lines.length; li++) {
        const cfgLine = lines[li];
        const baseY = cfgLine.yDoc - scrollY;
        if (baseY < -120 || baseY > H + 120) continue;

        ctx.beginPath();
        for (let x = -20; x <= W + 20; x += stepX) {
          // sx is the *sampling* coord (advances with horiz scroll); the
          // line is still *drawn* at x so it visually slides without the
          // baseline budging.
          const sx = x - shiftX;
          let y = baseY + cfgLine.amp * ampMul * waveField(sx, cfgLine.yDoc, now, speedMul);
          y += drapeOffset(x, baseY, now, cursorMul);
          y += dropletOffset(x, cfgLine.yDoc, now);
          if (x === -20) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
      }

      // ── Visible expanding rings for droplets ─────────────────────
      for (const d of drops) {
        const age = (now - d.t0) / 1000;
        if (age > DROP_LIFE) continue;
        const radius = age * DROP_SPEED;
        const decay = 1 - age / DROP_LIFE;
        const cx = d.x;
        const cy = d.yDoc - scrollY;
        if (cy < -800 || cy > H + 800) continue;
        ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, ${0.34 * decay * waveAlphaMul})`;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(cx, cy, radius, 0, Math.PI * 2);
        ctx.stroke();
      }

      rafHandle = requestAnimationFrame(tick);
    }
    rafHandle = requestAnimationFrame(tick);
  }
</script>

<style>
  .wavefield {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 1;
    /* No mix-blend-mode — stroke alpha is set per-frame from the dominant
       section's tone, so the lines read on both light and dark backgrounds
       without the multiply blend washing out over dark areas. */
  }
</style>
