---
// Global animated wavy-line background — a single canvas paints across the
// entire page (no per-section sub-canvases, no hole punches). The canvas reads
// from window.__wfConfig.main every frame and listens for "wf-config-change"
// to rebuild structural state (e.g. line count).
//
// Continuity across HorizontalTOC:
//   - The horizontal scroll-jack publishes its current strip translateX +
//     dominant section tone via window.__wfState. The wave sampler offsets
//     its x by that translateX while the htoc region is on-screen, so the
//     wave pattern slides horizontally in lockstep with the tiles.
//   - The stroke colour lerps from dark-ink (light sections) → light-ink
//     (dark sections) based on the htoc's published tone darkness, with
//     opacity from horiz.opacityDark / horiz.opacityLight (with optional
//     fade ease + fade window from main config).
//
// Interaction model is intentionally small:
//   - Hover: "drape" only (cursor pulls nearby line baselines toward it).
//   - Click: "droplet" only (an expanding ring is visible; lines bend
//     outward at the ring's leading edge — same coherent wavefield treats
//     it as a radial bump, so there's nothing janky to reconcile).
---
<canvas class="wavefield" data-wavefield aria-hidden="true"></canvas>

<script>
  const ENABLED = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canvas = document.querySelector<HTMLCanvasElement>("[data-wavefield]");
  if (canvas && ENABLED) init(canvas);

  function getCfg() {
    return (window as any).__wfConfig as any;
  }

  // ── Shared cross-component state, written by HorizontalTOC each frame ─
  type WfState = {
    htocShiftX: number;      // current strip translateX (px); 0 outside htoc
    htocActive: number;      // 0..1 — how much the htoc region is on-screen
    htocDarkness: number;    // 0..1 — current dominant section darkness
    htocBounds: { top: number; bottom: number } | null;
    htocPinOffset: number;   // (unused here — see comment below)
    htocWaveShiftX: number;  // (unused here — see comment below)
    htocPinStartY: number;   // sticky's offsetTop; constant unless layout reflows
    htocMaxTranslate: number;// pin distance; constant unless layout reflows
  };
  function getState(): WfState {
    return ((window as any).__wfState as WfState) ?? {
      htocShiftX: 0, htocActive: 0, htocDarkness: 0, htocBounds: null,
      htocPinOffset: 0, htocWaveShiftX: 0,
      htocPinStartY: 0, htocMaxTranslate: 0,
    };
  }

  function init(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d")!;

    // ── Canvas + viewport sizing ──────────────────────────────────
    let W = 0, H = 0, DPR = 1;
    function resize() {
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = Math.floor(W * DPR);
      canvas.height = Math.floor(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }
    resize();
    window.addEventListener("resize", () => { resize(); rebuildLines(); });

    // ── Click droplets — visible expanding ring + radial line push ────
    type Drop = { x: number; yDoc: number; t0: number; mode: "droplet" | "split" | "ripple"; aboveIdx: number; belowIdx: number };
    const drops: Drop[] = [];
    const DROP_LIFE = 3.2;     // seconds
    const DROP_SPEED = 240;    // px/s — radius growth
    const DROP_FW = 110;       // px — bell-curve front-width
    const DROP_AMP = 36;       // px — peak line displacement at the ring
    // "split" click mode — the disturbance only pushes the nearest line ABOVE
    // and BELOW the click apart, then ripples outward horizontally and fades
    // (it never reaches other lines; the sideways part just keeps expanding +
    // decaying, always spanning the band between those two lines).
    const SPLIT_LIFE = 3.0;    // seconds
    const SPLIT_SPEED = 340;   // px/s — horizontal half-width growth
    const SPLIT_AMP = 30;      // px — how far apart the two bounding lines push
    // "ripple" click mode — best of both: a visible circle expands (like droplet)
    // but only the two bracketing lines react, and ONLY where/when the ring's
    // edge actually reaches them (nothing moves ahead of the front). Once the
    // ring spans the band it "lands" — the circle fades and the opened band keeps
    // spreading horizontally to the ring's reach, then decays.
    const RIPPLE_LIFE = 3.2;   // seconds
    const RIPPLE_SPEED = 300;  // px/s — ring radius growth
    const RIPPLE_FW = 95;      // px — soft front width where the band ramps open
    const RIPPLE_AMP = 32;     // px — how far apart the band opens
    const RIPPLE_RINGFADE = 55;// px past the band where the visible circle fades out

    // ── Document-anchored line catalogue ──────────────────────────
    type Line = { yDoc: number; amp: number };
    let lines: Line[] = [];

    function rebuildLines() {
      const vh = window.innerHeight;
      const docH = Math.max(
        document.documentElement.scrollHeight,
        document.documentElement.clientHeight
      );
      const cfg = getCfg();
      const linesPerViewport = Math.max(1, Math.round((cfg?.main?.lineCount ?? 5)));
      const spacing = vh / linesPerViewport;
      const N = Math.ceil(docH / spacing) + linesPerViewport;
      lines = [];
      for (let i = 0; i < N; i++) {
        const seed = i * 1.61803398;
        const j1 = Math.sin(seed * 4.32) * 0.5 + 0.5;
        const j2 = Math.sin(seed * 2.71) * 0.5 + 0.5;
        lines.push({
          yDoc: i * spacing + j1 * spacing * 0.16,
          amp:  20 + j2 * 10,
        });
      }
    }
    rebuildLines();

    const docResizeObserver = new ResizeObserver(() => rebuildLines());
    docResizeObserver.observe(document.body);

    // Config-driven rebuilds.
    window.addEventListener("wf-config-change", (e) => {
      const k = (e as CustomEvent).detail?.key;
      if (k === "main.lineCount" || k === "__init") rebuildLines();
    });

    // ── Cursor tracking (viewport coords) ─────────────────────────
    const cursor = { x: -9999, y: -9999, has: false };
    window.addEventListener("pointermove", (e) => {
      cursor.x = e.clientX;
      cursor.y = e.clientY;
      cursor.has = true;
    }, { passive: true });
    window.addEventListener("pointerleave", () => { cursor.has = false; });

    // ── Click → spawn droplet (DOC coords so they scroll with page) ───
    window.addEventListener("pointerdown", (e) => {
      if ((e.target as HTMLElement)?.closest("[data-wf-tuner], [data-lt]")) return;
      const cm = getCfg()?.main?.clickMode;
      const mode = cm === "split" ? "split" : cm === "ripple" ? "ripple" : "droplet";
      const yDoc = e.clientY + window.scrollY;
      // Split + ripple lock onto the nearest line above + below the click point.
      let aboveIdx = -1, belowIdx = -1;
      if (mode === "split" || mode === "ripple") {
        let bestA = -Infinity, bestB = Infinity;
        for (let i = 0; i < lines.length; i++) {
          const ly = lines[i].yDoc;
          if (ly <= yDoc && ly > bestA) { bestA = ly; aboveIdx = i; }
          if (ly >= yDoc && ly < bestB) { bestB = ly; belowIdx = i; }
        }
      }
      drops.push({ x: e.clientX, yDoc, t0: performance.now(), mode, aboveIdx, belowIdx });
      if (drops.length > 12) drops.shift();
    }, { passive: true });

    // ── Coherent ocean-swell wave field ───────────────────────────
    function waveField(x: number, yDoc: number, t: number, speedMul: number): number {
      const ts = t * speedMul;
      const a = Math.sin(x * 0.0068 + yDoc * 0.0021 - ts * 0.00055);
      const b = Math.sin(x * 0.0115 - yDoc * 0.0033 - ts * 0.00082);
      const c = Math.sin(x * 0.0043 + yDoc * 0.0012 - ts * 0.00040);
      return a * 0.52 + b * 0.28 + c * 0.30;
    }

    // ── Hover (drape only): cursor pulls nearby baselines toward it ──
    function drapeOffset(x: number, baseY: number, now: number, mul: number): number {
      if (!cursor.has || mul <= 0) return 0;
      const dx = x - cursor.x;
      const dy = baseY - cursor.y;
      const dist = Math.hypot(dx, dy);
      const R = 720;
      const k = Math.max(0, 1 - dist / R);
      const bell = k * k;
      const pull = (cursor.y - baseY) * 0.40 * bell;
      const ripple = Math.sin(dist * 0.014 - now * 0.0024) /
                     (1 + dist * 0.004) * 11;
      return (pull + ripple) * mul;
    }

    // ── Droplet displacement: bell-curve at the expanding ring edge ───
    function dropletOffset(x: number, baseYDoc: number, now: number): number {
      let acc = 0;
      for (const d of drops) {
        if (d.mode === "split") continue;
        const age = (now - d.t0) / 1000;
        if (age > DROP_LIFE) continue;
        const dx = x - d.x;
        const dy = baseYDoc - d.yDoc;
        const dist = Math.hypot(dx, dy);
        const r = age * DROP_SPEED;
        const off = dist - r;
        if (Math.abs(off) > DROP_FW) continue;
        const bell = Math.cos((off / DROP_FW) * (Math.PI / 2));
        const decay = 1 - age / DROP_LIFE;
        const ny = dy / (dist || 1);
        // +ny pushes the line radially OUTWARD, so the wave travels AWAY from
        // the click point instead of pinching toward it.
        acc += bell * decay * DROP_AMP * ny;
      }
      return acc;
    }

    // Split mode — only the two lines bracketing the click move, pushed apart,
    // with a dome that widens outward (|x − clickX| < age·speed) and fades. The
    // dome always spans the band between the two lines (no gap), and the
    // sideways edges just keep expanding + decaying since they hit nothing.
    function splitOffset(x: number, lineIdx: number, now: number): number {
      let acc = 0;
      for (const d of drops) {
        if (d.mode !== "split") continue;
        if (lineIdx !== d.aboveIdx && lineIdx !== d.belowIdx) continue;
        const age = (now - d.t0) / 1000;
        if (age > SPLIT_LIFE) continue;
        const r = age * SPLIT_SPEED;
        if (r < 1) continue;
        const hx = Math.abs(x - d.x);
        if (hx > r) continue;
        const env = 0.5 * (1 + Math.cos((Math.PI * hx) / r)); // 1 at centre → 0 at the front
        const decay = 1 - age / SPLIT_LIFE;
        const dir = lineIdx === d.aboveIdx ? -1 : 1; // above pushes up, below pushes down
        acc += dir * env * decay * SPLIT_AMP;
      }
      return acc;
    }

    // Ripple mode — the expanding circle reaches the two bracketing lines and
    // opens the band only as far as the ring's edge has actually travelled. A
    // point moves only once the ring crosses it (r ≥ its distance), so nothing
    // jumps ahead of the front; behind the front the band stays open (occupying
    // the space) out to the ring's horizontal reach, then the whole thing fades.
    function rippleOffset(x: number, lineIdx: number, baseYDoc: number, now: number): number {
      let acc = 0;
      for (const d of drops) {
        if (d.mode !== "ripple") continue;
        if (lineIdx !== d.aboveIdx && lineIdx !== d.belowIdx) continue;
        const age = (now - d.t0) / 1000;
        if (age > RIPPLE_LIFE) continue;
        const r = age * RIPPLE_SPEED;
        const dy = baseYDoc - d.yDoc;
        const ady = Math.abs(dy);
        if (r <= ady) continue;                       // ring hasn't reached this line yet
        const reach = Math.sqrt(r * r - dy * dy);     // how far along the line the ring has spread
        const hx = Math.abs(x - d.x);
        if (hx > reach) continue;                      // ahead of the front → untouched
        const env = Math.min(1, (reach - hx) / RIPPLE_FW); // soft ramp at the front, full inside
        const decay = 1 - age / RIPPLE_LIFE;
        const dir = dy < 0 ? -1 : 1;                   // above opens up, below opens down
        acc += dir * env * decay * RIPPLE_AMP;
      }
      return acc;
    }

    // ── Colour helpers ────────────────────────────────────────────────
    // Lerps stroke + opacity between "dark ink on light bg" and "light ink
    // on dark bg" by the htoc darkness factor, with a tunable smoothstep
    // window so the boundary doesn't pop.
    function smoothstep(edge0: number, edge1: number, x: number): number {
      if (edge0 === edge1) return x < edge0 ? 0 : 1;
      const t = Math.max(0, Math.min(1, (x - edge0) / (edge1 - edge0)));
      return t * t * (3 - 2 * t);
    }
    function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }

    // ── Render loop ───────────────────────────────────────────────
    let running = !document.hidden;
    let rafHandle = 0;
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        running = false;
        if (rafHandle) cancelAnimationFrame(rafHandle);
      } else if (!running) {
        running = true;
        rafHandle = requestAnimationFrame(tick);
      }
    });

    function tick() {
      if (!running) return;
      const now = performance.now();
      const realScrollY = window.scrollY;
      const cfg = getCfg() || {};
      const mainCfg = cfg.main || {};
      const horizCfg = cfg.horiz || {};
      const cursorMul = mainCfg.cursorReact ?? 1;
      const speedMul = mainCfg.naturalSpeed ?? 1;
      const ampMul = mainCfg.naturalAmp ?? 1;
      const thickness = mainCfg.thickness ?? 1.6;
      const opacityLight = mainCfg.opacity ?? 0.22;          // light-bg stroke alpha
      const opacityDark = horizCfg.opacityDark ?? 0.32;      // dark-bg stroke alpha
      const fadeStart = horizCfg.fadeStart ?? 0.25;          // smoothstep edge0
      const fadeEnd   = horizCfg.fadeEnd   ?? 0.65;          // smoothstep edge1

      const st = getState();
      // Dark-ness drives stroke color + opacity blending.
      const darkness = smoothstep(fadeStart, fadeEnd, st.htocDarkness ?? 0);

      // Pin freeze: derive the offset locally from realScrollY + the
      // htoc's published geometry constants. Using the *snapshot*
      // offset published by HorizontalTOC each frame instead would skew
      // by one frame's scroll delta (HorizontalTOC's RAF and this one
      // sample window.scrollY at slightly different moments while Lenis
      // is animating), and the residual would jitter the wave lines
      // vertically at high scroll velocity. Doing the math here with
      // the same `realScrollY` we use for line positioning means the
      // two terms cancel exactly — pure horizontal motion during pin.
      const pinStartY = st.htocPinStartY ?? 0;
      const maxT = st.htocMaxTranslate ?? 0;
      const pinOffset = maxT > 0
        ? Math.max(0, Math.min(maxT, realScrollY - pinStartY))
        : 0;
      const scrollY = realScrollY - pinOffset;

      // Fade the wave field out below the IMPACTFUL / COMPETITIVE ROBOTICS
      // wordmark — past that point only the RoboticsTransition's own
      // animation belongs in the strip between wordmark and dark panels.
      // We anchor to the wordmark element; once its bottom is above the
      // viewport top, the fade is complete.
      let waveAlphaMul = 1;
      const fadeAnchor = document.querySelector(".ric__wordmark") as HTMLElement | null;
      if (fadeAnchor) {
        const fb = fadeAnchor.getBoundingClientRect().bottom;
        // fb > FADE_START_Y: fully visible; fb < FADE_END_Y: fully hidden.
        const FADE_START_Y = 240;
        const FADE_END_Y = -40;
        const t = (fb - FADE_END_Y) / (FADE_START_Y - FADE_END_Y);
        waveAlphaMul = Math.max(0, Math.min(1, t));
      }

      // Cull old drops.
      for (let i = drops.length - 1; i >= 0; i--) {
        const m = drops[i].mode;
        const life = m === "split" ? SPLIT_LIFE : m === "ripple" ? RIPPLE_LIFE : DROP_LIFE;
        if ((now - drops[i].t0) / 1000 > life + 0.1) drops.splice(i, 1);
      }

      ctx.clearRect(0, 0, W, H);

      // ── Wave lines ───────────────────────────────────────────────
      const stepX = 6;
      // X-shift for wave sampling. Derived locally from pinOffset for
      // the same reason we derive pinOffset locally — using the
      // published snapshot would skew by one Lenis-advanced frame.
      //
      // shiftScale tames the high-frequency vertical-jitter look that
      // appears at scroll speed × 1.0 coupling. The wave field is a sum
      // of three sines at moderate spatial frequencies (~924 px /
      // ~547 px / ~1462 px wavelength). At 1:1 coupling, a single
      // pin scroll (~5800 px) sweeps roughly six wave cycles past any
      // given screen point, which at 60 fps reads as fast vertical
      // morphing. Scaling down keeps the direction-of-motion link with
      // the gallery while the morphing per unit scroll stays subtle.
      const shiftScale = horizCfg.shiftScale ?? 0.4;
      const shiftX = -pinOffset * shiftScale;

      // Stroke colour: lerp dark ink ↔ light ink (or accent when accentLines on).
      const accentLines = !!(horizCfg.accentLines);
      const lightR = accentLines ? 217 : 244;
      const lightG = accentLines ? 106 : 237;
      const lightB = accentLines ? 54  : 226;
      const r = Math.round(lerp(26, lightR, darkness));
      const g = Math.round(lerp(23, lightG, darkness));
      const b = Math.round(lerp(20, lightB, darkness));
      const alpha = lerp(opacityLight, opacityDark, darkness) * waveAlphaMul;
      ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
      ctx.lineWidth = thickness;
      // Cheap early-out when fully faded — saves a chunk of CPU while
      // the user is parked in the wordmark / robotics area.
      if (waveAlphaMul <= 0.001) {
        rafHandle = requestAnimationFrame(tick);
        return;
      }

      for (let li = 0; li < lines.length; li++) {
        const cfgLine = lines[li];
        const baseY = cfgLine.yDoc - scrollY;
        if (baseY < -120 || baseY > H + 120) continue;

        ctx.beginPath();
        for (let x = -20; x <= W + 20; x += stepX) {
          // sx is the *sampling* coord (advances with horiz scroll); the
          // line is still *drawn* at x so it visually slides without the
          // baseline budging.
          const sx = x - shiftX;
          let y = baseY + cfgLine.amp * ampMul * waveField(sx, cfgLine.yDoc, now, speedMul);
          y += drapeOffset(x, baseY, now, cursorMul);
          y += dropletOffset(x, cfgLine.yDoc, now);
          y += splitOffset(x, li, now);
          y += rippleOffset(x, li, cfgLine.yDoc, now);
          if (x === -20) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
      }

      // ── Visible expanding rings for droplets ─────────────────────
      for (const d of drops) {
        if (d.mode === "split") continue; // split has no visible ring
        const age = (now - d.t0) / 1000;
        const cx = d.x;
        const cy = d.yDoc - scrollY;
        if (cy < -800 || cy > H + 800) continue;

        if (d.mode === "ripple") {
          // Same expanding circle as droplet, but it fades out once it has
          // spanned the band (the disturbance carries on horizontally in the
          // lines from there).
          if (age > RIPPLE_LIFE) continue;
          const radius = age * RIPPLE_SPEED;
          const above = lines[d.aboveIdx], below = lines[d.belowIdx];
          const dyMax = Math.max(
            above ? Math.abs(d.yDoc - above.yDoc) : 0,
            below ? Math.abs(below.yDoc - d.yDoc) : 0,
          );
          const decay = 1 - age / RIPPLE_LIFE;
          // full opacity until the ring reaches the band edges, then fade off.
          const land = Math.max(0, Math.min(1, (dyMax + RIPPLE_RINGFADE - radius) / RIPPLE_RINGFADE));
          const a = 0.34 * decay * land * waveAlphaMul;
          if (a <= 0.002) continue;
          ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, ${a})`;
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.arc(cx, cy, radius, 0, Math.PI * 2);
          ctx.stroke();
          continue;
        }

        if (age > DROP_LIFE) continue;
        const radius = age * DROP_SPEED;
        const decay = 1 - age / DROP_LIFE;
        ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, ${0.34 * decay * waveAlphaMul})`;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(cx, cy, radius, 0, Math.PI * 2);
        ctx.stroke();
      }

      rafHandle = requestAnimationFrame(tick);
    }
    rafHandle = requestAnimationFrame(tick);
  }
</script>

<style>
  .wavefield {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 1;
    /* No mix-blend-mode — stroke alpha is set per-frame from the dominant
       section's tone, so the lines read on both light and dark backgrounds
       without the multiply blend washing out over dark areas. */
  }
</style>
