---
// Cream → telemetry-dark transition built on a hex-tile gradient field.
// Direct port of ICHexMatrix from intro-variations.jsx — algorithm preserved.
const startFrac = 0.75;
const baseR = 22;
const dx = Math.sqrt(3) * baseR;
const dy = 1.5 * baseR;
const startY = 900 * startFrac;

const hexes: { pts: string; opacity: number }[] = [];
for (let row = 0, y = startY; y < 940; row++, y += dy) {
  const yFrac = (y / 900 - startFrac) / (1 - startFrac);
  const xOff = (row % 2) * (dx / 2);
  for (let x = -dx; x < 1280 + dx * 2; x += dx) {
    const cx = x + xOff;
    const cy = y;
    const seed = (row * 37 + Math.floor(cx / 7)) % 17;
    const sizeJitter = (seed - 8) * 0.05;
    const opJitter = ((seed * 5) % 11) / 11;
    const sizeMul = 0.4 + Math.pow(yFrac, 1.1) * 1.2 + sizeJitter;
    const r = Math.max(3, baseR * sizeMul);
    const opacity = Math.min(0.95, 0.15 + yFrac * 0.7 + opJitter * 0.25);
    const pts = [90, 150, 210, 270, 330, 30]
      .map((d) => (d * Math.PI) / 180)
      .map((a) => `${(cx + r * Math.cos(a)).toFixed(1)},${(cy + r * Math.sin(a)).toFixed(1)}`)
      .join(" ");
    hexes.push({ pts, opacity });
  }
}
---
<svg class="hex" preserveAspectRatio="none" viewBox="0 0 1280 900" aria-hidden="true">
  <defs>
    <linearGradient id="icHexGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f1ede3" />
      <stop offset="0.75" stop-color="#f1ede3" />
      <stop offset="0.98" stop-color="#1d1a17" />
      <stop offset="1" stop-color="#161412" />
    </linearGradient>
  </defs>
  <rect x="-100" y="0" width="1480" height="900" fill="url(#icHexGrad)" />
  {hexes.map((h) => (
    <polygon points={h.pts} fill="#161412" opacity={h.opacity} />
  ))}
</svg>
<style>
  .hex {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
