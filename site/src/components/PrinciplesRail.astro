---
// Principles in the same band idiom as MetaRail: rail gutter on the left (the
// page-level SectionRail floats there), six points packed two-up on the right.
import { VALUES } from "@/data/content";
const cols = [VALUES.engineering, VALUES.creative];
---
<section class="pr2" id="principles" data-spy="principles">
  <div class="pr2__inner shell">
    <div class="pr2__body">
      <div class="pr2__mark">
        <h2 class="pr2__mark-h">
          <span class="pr2__mark-n">§ 07</span>
          <span class="pr2__mark-t">Principles</span>
          <span class="pr2__mark-sub">What I look for in the work, and the people</span>
        </h2>
      </div>

      <div class="pr2__cols">
        {cols.map((v) => (
          <div class="pr2__col">
            <div class="pr2__bar">
              <h3 class="pr2__col-title">{v.label}</h3>
              <span class="pr2__rule" aria-hidden="true"></span>
            </div>
            <div class="pr2__pts">
              {v.points.map((p, i) => (
                <div class="pr2__pt" style={`--i:${i}`} data-reveal>
                  <div class="pr2__k">{p.k}</div>
                  <div>
                    <div class="pr2__t">{p.t}</div>
                    <div class="pr2__d">{p.d}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .pr2 {
    position: relative;
    z-index: 1;
    padding: 54px var(--page-pad) 62px;
    background: var(--bg-warm);
    color: var(--ink);
  }
  .pr2__inner {
    display: grid;
    /* Column 1 is the gutter the page-level SectionRail floats in. */
    grid-template-columns: var(--rail-w, 214px) minmax(0, 1fr);
    gap: var(--rail-gap, 44px);
  }
  .pr2__body { grid-column: 2; min-width: 0; }

  /* Band marker — matches MetaRail's. */
  .pr2__mark { padding-bottom: 14px; }
  .pr2__mark-h {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .pr2__mark-n { color: var(--accent); }
  .pr2__mark-t { color: var(--ink); }
  .pr2__mark-sub::before { content: "· "; }

  .pr2__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 34px;
  }
  .pr2__bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 6px;
  }
  .pr2__col-title {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
    flex: none;
    max-width: 32ch;
  }
  .pr2__rule { flex: 1 1 auto; height: 1px; background: var(--rule); }

  .pr2__pt {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 14px;
    padding: 14px 0;
    border-top: 1px solid var(--rule);
  }
  .pr2__k {
    font-family: var(--font-display);
    font-size: 26px;
    font-style: italic;
    color: var(--trim);
    line-height: 1;
  }
  .pr2__t {
    font-family: var(--font-body);
    font-size: 16.5px;
    font-weight: 700;
    color: var(--ink);
  }
  .pr2__d {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--ink-dim);
    margin-top: 3px;
    line-height: 1.5;
  }

  /* Reveal — the shared scroll pass in SectionRail flips .is-in; the
     transition itself has to live here because Astro scopes component
     styles. */
  :global(html.js-reveal) [data-reveal] {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 480ms ease, transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i, 0) * 55ms);
  }
  :global(html.js-reveal) [data-reveal].is-in { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js-reveal) [data-reveal] { opacity: 1; transform: none; }
  }

  @media (max-width: 1280px) {
    .pr2__inner { gap: 32px; }
  }
  /* Rail drops out — the marker becomes the section header. */
  @media (max-width: 1080px) {
    .pr2__inner { grid-template-columns: minmax(0, 1fr); }
    .pr2__body { grid-column: 1; }
    .pr2__mark { padding-bottom: 18px; }
    .pr2__mark-h {
      font-family: var(--font-display);
      font-size: 30px;
      font-weight: 500;
      letter-spacing: -0.02em;
      text-transform: none;
    }
    .pr2__mark-n {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }
    .pr2__mark-sub {
      font-family: var(--font-body);
      font-size: 13px;
      color: var(--ink-mute);
    }
  }
  @media (max-width: 720px) {
    .pr2__cols { grid-template-columns: 1fr; gap: 8px 0; }
  }
</style>
