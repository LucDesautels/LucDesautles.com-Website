---
import type { MetaGroup } from "@/data/content";
import Placeholder from "./Placeholder.astro";

interface Props {
  meta: MetaGroup;
  num: number;
  quirky?: boolean;
  /** Pass true on the very first MetaSection rendered (§04 Academics) so the
   *  first standout chip keeps the full "★ Standout" label. All other standout
   *  chips show just "★". */
  firstSection?: boolean;
}
const { meta, num, quirky, firstSection } = Astro.props;
---
<section class="ms" id={meta.id}>
  <div class="ms__inner shell">
    <div class="ms__head">
      <div>
        <div class="eyebrow">§ 0{num} — {meta.subtitle}</div>
        <h2 class="ms__title">
          {meta.title}<span class="ms__period">.</span>
        </h2>
        {quirky && (
          <div class="ms__quirk">slightly less serious from here on.</div>
        )}
      </div>
    </div>

    {meta.groups.map((g, gi) => {
      const standoutItem = g.items.find((i) => i.standout);
      const hasStandout = !!standoutItem;
      // When no standout is flagged, render all items in an equal-column grid.
      const allItems = hasStandout ? g.items.filter((i) => i !== standoutItem) : g.items;
      // Four-card layout: standout + 3 siblings → standout spans 2 rows.
      const isFourCard = hasStandout && allItems.length >= 3;
      // Only the very first group of the very first section keeps the full chip.
      const isFirstChip = !!firstSection && gi === 0;

      const groupClass = [
        "group",
        !hasStandout && "group--equal",
        isFourCard && "group--four",
      ].filter(Boolean).join(" ");

      return (
        <div class={groupClass} data-group-id={g.id}>
          <div class="group__head">
            <span class="eyebrow">
              {String(gi + 1).padStart(2, "0")} / {String(meta.groups.length).padStart(2, "0")}
            </span>
            <h3 class="group__title">{g.title}.</h3>
          </div>
          <div class="group__grid">
            {standoutItem && (
              <article class={`standout${quirky ? " standout--tilt" : ""}`}>
                <div class={`standout__tab${isFirstChip ? "" : " standout__tab--star"}`}>
                  {isFirstChip ? "★ Standout" : "★"}
                </div>
                <Placeholder label={standoutItem.title} aspect="4/3" />
                <div class="standout__body">
                  <h4 class="standout__title">{standoutItem.title}</h4>
                  <p class="standout__text">{standoutItem.body}</p>
                  {standoutItem.href && (
                    <a class="card-link" href={standoutItem.href}>
                      Take a look
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4.5M9.5 2.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  )}
                </div>
              </article>
            )}

            {allItems.map((it, i) => (
              <article
                class={`item${it.outlined ? " item--outlined" : ""}`}
                style={quirky && !it.outlined ? `transform:rotate(${i === 0 ? 1.5 : -1.2}deg);` : undefined}
              >
                <Placeholder label={it.title} aspect="4/3" />
                <h4 class="item__title">{it.title}</h4>
                <p class="item__text">{it.body}</p>
                {it.href && (
                  <a class="card-link" href={it.href}>
                    Take a look
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                      <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4.5M9.5 2.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                )}
              </article>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .ms {
    position: relative;
    padding: 80px var(--page-pad);
    background: var(--bg);
    color: var(--ink);
  }
  .ms__inner { position: relative; z-index: 1; }
  .ms__head { display: flex; align-items: flex-end; justify-content: space-between; }
  .ms__title {
    font-family: var(--font-display);
    font-size: clamp(48px, 8vw, 92px);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 8px 0 0;
    color: var(--ink);
  }
  .ms__period { color: var(--trim); }
  .ms__quirk {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 16px;
    color: var(--ink-dim);
    margin-top: 10px;
    transform: rotate(-1deg);
    display: inline-block;
  }

  .group {
    padding: 32px 0;
    border-top: 1px solid var(--rule);
  }
  .group__head {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin-bottom: 24px;
  }
  .group__title {
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .group__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 18px;
    align-items: stretch;
  }

  /* Equal-column layout (no standout item in the group) */
  .group--equal .group__grid {
    grid-template-columns: 1fr 1fr 1fr;
  }

  /* Four-card layout: standout spans two rows, 3 siblings on the right */
  .group--four .standout {
    grid-column: 1;
    grid-row: 1 / span 2;
  }

  @media (max-width: 960px) {
    .group__grid { grid-template-columns: 1fr; }
    .group--equal .group__grid { grid-template-columns: 1fr; }
    .group--four .standout { grid-row: auto; grid-column: auto; }
  }

  /* Standout — tab style with orange border + shadow */
  .standout {
    position: relative;
    padding: 22px 24px;
    background: #fff;
    box-shadow: 0 16px 38px rgba(0, 0, 0, 0.10);
    display: flex;
    flex-direction: column;
    min-height: 380px;
    border: 2px solid #d66e3a;
  }
  .standout--tilt { transform: rotate(-1deg); }

  /* Full chip: "★ Standout" */
  .standout__tab {
    position: absolute;
    top: -13px;
    left: 20px;
    padding: 4px 10px;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* Compact star-only chip */
  .standout__tab--star {
    padding: 5px 8px;
    letter-spacing: 0;
    font-size: 12px;
    line-height: 1;
  }

  .standout__body {
    border-left: 3px solid var(--trim);
    padding-left: 14px;
    margin-top: 18px;
  }
  .standout__title {
    font-family: var(--font-display);
    font-size: clamp(26px, 3.2vw, 34px);
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .standout__text {
    font-family: var(--font-body);
    font-size: 14.5px;
    color: var(--ink-dim);
    margin: 10px 0 0;
    line-height: 1.55;
  }

  /* Sibling item */
  .item {
    position: relative;
    padding: 18px 20px;
    background: #fff;
    border: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
  }

  /* Outlined item (orange border, like standout outline but item-sized) */
  .item--outlined {
    border: 2px solid #d66e3a;
  }

  .item__title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    margin: 14px 0 6px;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }
  .item__text {
    font-family: var(--font-body);
    font-size: 13.5px;
    color: var(--ink-dim);
    margin: 0;
    line-height: 1.55;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 12px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: #06b6d4;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .card-link:hover { color: #0891b2; }
</style>
