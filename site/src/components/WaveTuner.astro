---
// TEMPORARY tabbed control panel (top-left). Owns the live config object on
// window.__wfConfig and dispatches "wf-config-change" events that every
// other animated subsystem listens to (WaveField, RoboticsTransition,
// HorizontalTOC internal canvas, and the .ric__cad CAD images).
//
// The whole panel — markup, JS wiring, CSS — gets removed when we bake in
// the chosen values.

type Slider = { key: string; label: string; min: number; max: number; step: number; value: number; fmt?: "int" | "1dp" | "2dp"; freeform?: boolean };

const mainSliders: Slider[] = [
  { key: "main.lineCount",    label: "LINE COUNT",     min: 3,   max: 10,  step: 1,    value: 5,    fmt: "int" },
  { key: "main.thickness",    label: "THICKNESS",      min: 0.5, max: 4,   step: 0.1,  value: 1.6,  fmt: "1dp" },
  { key: "main.opacity",      label: "OPACITY",        min: 0,   max: 1,   step: 0.02, value: 0.22, fmt: "2dp" },
  { key: "main.naturalSpeed", label: "DRIFT SPEED ×",  min: 0,   max: 3,   step: 0.05, value: 1,    fmt: "2dp" },
  { key: "main.naturalAmp",   label: "AMPLITUDE ×",    min: 0,   max: 3,   step: 0.05, value: 1,    fmt: "2dp" },
  { key: "main.cursorReact",  label: "CURSOR PUSH ×",  min: 0,   max: 3,   step: 0.05, value: 1,    fmt: "2dp" },
];
const transitionSliders: Slider[] = [
  { key: "transition.lineCount",     label: "LINE COUNT",      min: 8,   max: 60,   step: 1,    value: 28,   fmt: "int" },
  { key: "transition.thickness",     label: "THICKNESS",       min: 0.5, max: 4,    step: 0.1,  value: 1.4,  fmt: "1dp" },
  { key: "transition.opacity",       label: "OPACITY ×",       min: 0,   max: 2,    step: 0.05, value: 1,    fmt: "2dp" },
  { key: "transition.naturalSpeed",  label: "DRIFT SPEED ×",   min: 0,   max: 3,    step: 0.05, value: 1,    fmt: "2dp" },
  { key: "transition.naturalAmp",    label: "AMPLITUDE ×",     min: 0,   max: 3,    step: 0.05, value: 1,    fmt: "2dp" },
  { key: "transition.cursorReact",   label: "CURSOR PUSH ×",   min: 0,   max: 3,    step: 0.05, value: 1,    fmt: "2dp" },
  { key: "transition.fadeStart",     label: "FADE START Y",    min: 0.2, max: 0.85, step: 0.01, value: 0.55, fmt: "2dp" },
  { key: "transition.densityToDark", label: "DENSITY → DARK",  min: 0,   max: 2,    step: 0.05, value: 1,    fmt: "2dp" },
  { key: "transition.colorFlip",     label: "COLOR FLIP Y",    min: 0.5, max: 0.95, step: 0.01, value: 0.78, fmt: "2dp" },
];
// The horizontal-scroll waves now share the global WaveField — so the
// "structural" sliders (line count, thickness, drift speed, amplitude)
// live in MAIN. What stays here are the controls that only matter when the
// htoc region is on screen: the dark/light stroke opacities and the
// smoothstep window that softens the dark↔light transition.
const horizSliders: Slider[] = [
  { key: "horiz.opacityDark",  label: "OPACITY (DARK)",     min: 0,   max: 1,  step: 0.02, value: 0.32, fmt: "2dp" },
  { key: "horiz.opacityLight", label: "OPACITY (LIGHT)",    min: 0,   max: 1,  step: 0.02, value: 0.22, fmt: "2dp" },
  { key: "horiz.fadeStart",    label: "FADE START (DARK)",  min: 0,   max: 1,  step: 0.01, value: 0.25, fmt: "2dp" },
  { key: "horiz.fadeEnd",      label: "FADE END (DARK)",    min: 0,   max: 1,  step: 0.01, value: 0.65, fmt: "2dp" },
  // Scales how aggressively the wave field tracks horizontal scroll. At
  // 1.0 the wave pattern shifts 1:1 with the gallery — which makes any
  // single point on screen sweep through ~6 wave cycles per pin scroll,
  // perceived as a high-frequency vertical jitter. Lower values keep
  // the direction-of-motion link without the jitter. 0 = wave field
  // stationary horizontally, 1 = full 1:1 with the gallery.
  { key: "horiz.shiftScale",   label: "WAVE SHIFT × SCROLL",min: 0,   max: 1,  step: 0.02, value: 0.4,  fmt: "2dp" },
];
function imgSliders(side: "left" | "right", defaults: { rot: number }): Slider[] {
  return [
    // X / Y use freeform number inputs so any value is typeable.
    { key: `images.${side}.x`,     label: "X (PX)",  min: -9999, max: 9999, step: 1,    value: 0,         fmt: "int", freeform: true },
    { key: `images.${side}.y`,     label: "Y (PX)",  min: -9999, max: 9999, step: 1,    value: 0,         fmt: "int", freeform: true },
    { key: `images.${side}.rot`,   label: "ROTATE",  min: 0,     max: 360,  step: 1,    value: defaults.rot, fmt: "int" },
    { key: `images.${side}.scale`, label: "SCALE",   min: 0.25,  max: 4,    step: 0.05, value: 1,         fmt: "2dp" },
  ];
}
const leftImgSliders  = imgSliders("left",  { rot: 0 });
const rightImgSliders = imgSliders("right", { rot: 0 });

function labelSliders(side: "left" | "right"): Slider[] {
  return [
    { key: `labels.${side}.x`,   label: "X (PX)",  min: -9999, max: 9999, step: 1,   value: 0, fmt: "int", freeform: true },
    { key: `labels.${side}.y`,   label: "Y (PX)",  min: -9999, max: 9999, step: 1,   value: 0, fmt: "int", freeform: true },
    { key: `labels.${side}.rot`, label: "ROTATE",  min: -180,  max: 180,  step: 0.5, value: 0, fmt: "1dp" },
    { key: `labels.${side}.size`,label: "SIZE (PX)",min: 20,   max: 120,  step: 1,   value: side === "left" ? 56 : 56, fmt: "int" },
  ];
}
const leftLabelSliders  = labelSliders("left");
const rightLabelSliders = labelSliders("right");

function fmt(v: number, f: Slider["fmt"]) {
  if (f === "int")  return Math.round(v).toString();
  if (f === "1dp")  return v.toFixed(1);
  return v.toFixed(2);
}
---
<div class="wf-tuner" data-wf-tuner role="region" aria-label="Live tuner (temporary)">
  <div class="wf-tuner__tabs" role="tablist">
    <button class="wf-tuner__close"  data-wf-close             type="button" aria-label="Close tuner">✕</button>
    <button class="wf-tab is-active" data-tab-btn="main"       type="button" role="tab" aria-selected="true">main</button>
    <button class="wf-tab"           data-tab-btn="transition" type="button" role="tab" aria-selected="false">transition</button>
    <button class="wf-tab"           data-tab-btn="horiz"      type="button" role="tab" aria-selected="false">horizontal</button>
    <button class="wf-tab"           data-tab-btn="rail"       type="button" role="tab" aria-selected="false">rail</button>
    <button class="wf-tab"           data-tab-btn="scroll"     type="button" role="tab" aria-selected="false">scroll</button>
    <button class="wf-tab"           data-tab-btn="images"     type="button" role="tab" aria-selected="false">images</button>
    <button class="wf-tab"           data-tab-btn="labels"     type="button" role="tab" aria-selected="false">labels</button>
    <button class="wf-tab"           data-tab-btn="text"       type="button" role="tab" aria-selected="false">text</button>
  </div>

  <div class="wf-tuner__body">

    <!-- ── MAIN TAB ─────────────────────────────────────────────── -->
    <!-- Hover/click pills removed: drape is the only hover mode, droplet
         (expanding ring + radial line push) is the only click mode. -->
    <div class="wf-tab-panel is-active" data-tab-panel="main" role="tabpanel">
      {mainSliders.map((s) => (
        <div class="wf-slider" data-slider>
          <label class="wf-label">{s.label} <span data-readout>{fmt(s.value, s.fmt)}</span></label>
          <input type="range" min={s.min} max={s.max} step={s.step} value={s.value} data-key={s.key} data-fmt={s.fmt} />
        </div>
      ))}
      <div class="wf-slider" data-slider>
        <label class="wf-label">ZOOM × <span data-readout>1.000</span></label>
        <input type="range" min="0.5" max="1.2" step="0.025" value="1" data-key="main.zoom" data-fmt="3dp" />
      </div>
      <div class="wf-row">
        <div class="wf-label">CLICK</div>
        <div class="wf-pills" data-wf-pills="main.clickMode">
          <button class="wf-pill is-active" data-pill="droplet" type="button">droplet (away)</button>
          <button class="wf-pill"           data-pill="split"   type="button">split</button>
          <button class="wf-pill"           data-pill="ripple"  type="button">ripple</button>
        </div>
      </div>
    </div>

    <!-- ── TRANSITION TAB ───────────────────────────────────────── -->
    <div class="wf-tab-panel" data-tab-panel="transition" role="tabpanel" hidden>
      <div class="wf-row">
        <div class="wf-label">VARIANT</div>
        <div class="wf-pills" data-wf-pills="transition.mode">
          <button class="wf-pill"           data-pill="hex"      type="button">hex</button>
          <button class="wf-pill is-active" data-pill="water"    type="button">water</button>
          <button class="wf-pill"           data-pill="gears"    type="button">gears</button>
          <button class="wf-pill"           data-pill="rain"     type="button">rain</button>
          <button class="wf-pill"           data-pill="circuits" type="button">circuits</button>
        </div>
      </div>
      {transitionSliders.map((s) => (
        <div class="wf-slider" data-slider>
          <label class="wf-label">{s.label} <span data-readout>{fmt(s.value, s.fmt)}</span></label>
          <input type="range" min={s.min} max={s.max} step={s.step} value={s.value} data-key={s.key} data-fmt={s.fmt} />
        </div>
      ))}
    </div>

    <!-- ── HORIZONTAL TAB ───────────────────────────────────────── -->
    <div class="wf-tab-panel" data-tab-panel="horiz" role="tabpanel" hidden>
      {horizSliders.map((s) => (
        <div class="wf-slider" data-slider>
          <label class="wf-label">{s.label} <span data-readout>{fmt(s.value, s.fmt)}</span></label>
          <input type="range" min={s.min} max={s.max} step={s.step} value={s.value} data-key={s.key} data-fmt={s.fmt} />
        </div>
      ))}
      <div class="wf-row">
        <button class="wf-toggle" data-toggle data-key="horiz.accentLines" type="button">orange lines</button>
      </div>
    </div>

    <!-- ── RAIL TAB ─────────────────────────────────────────────── -->
    <!-- The bottom progress rail in the HorizontalTOC. Five variants to
         try out — all of them update via a CSS custom property in the
         scroll RAF (no width transition, no React re-render per frame),
         so none of them should lag behind the scroll. -->
    <div class="wf-tab-panel" data-tab-panel="rail" role="tabpanel" hidden>
      <div class="wf-row">
        <div class="wf-label">VARIANT</div>
        <div class="wf-pills wf-pills--stack" data-wf-pills="rail.variant">
          <button class="wf-pill is-active" data-pill="fat-fixed"        type="button">fat bar (full width)</button>
          <button class="wf-pill"           data-pill="thin-fixed"       type="button">thin bar (centered)</button>
          <button class="wf-pill"           data-pill="line-thread"      type="button">line + text fills L→R</button>
          <button class="wf-pill"           data-pill="active-text"      type="button">just text, active in accent</button>
          <button class="wf-pill"           data-pill="cumulative-text"  type="button">just text, fills section-by-section</button>
        </div>
      </div>
    </div>

    <!-- ── SCROLL TAB ───────────────────────────────────────────── -->
    <!-- Live-swappable scroll modes. SmoothScroll.astro tears down + reinstates
         Lenis when the mode changes, so you can A/B feel between presets
         without reloading. `native` is the browser's own scroll. -->
    <div class="wf-tab-panel" data-tab-panel="scroll" role="tabpanel" hidden>
      <div class="wf-row">
        <div class="wf-label">MODE</div>
        <div class="wf-pills wf-pills--stack" data-wf-pills="scroll.mode">
          <button class="wf-pill"           data-pill="native"   type="button">native (no Lenis)</button>
          <button class="wf-pill"           data-pill="subtle"   type="button">subtle (very light)</button>
          <button class="wf-pill is-active" data-pill="default"  type="button">default (Lenis original)</button>
          <button class="wf-pill"           data-pill="soft"     type="button">soft (slow + glide-y)</button>
          <button class="wf-pill"           data-pill="snappy"   type="button">snappy (short + sharp)</button>
        </div>
      </div>
    </div>

    <!-- ── IMAGES TAB ───────────────────────────────────────────── -->
    <div class="wf-tab-panel" data-tab-panel="images" role="tabpanel" hidden>
      <div class="wf-subhead">SWOOP-IN</div>
      <div class="wf-slider" data-slider>
        <label class="wf-label">REST AT (% VH) <span data-readout>75</span></label>
        <input type="range" min="20" max="100" step="1" value="75" data-key="images.restPct" data-fmt="int" />
      </div>

      <div class="wf-subhead">LEFT IMAGE</div>
      {leftImgSliders.map((s) => (
        <div class="wf-slider" data-slider>
          <label class="wf-label">{s.label} <span data-readout>{fmt(s.value, s.fmt)}</span></label>
          {s.freeform ? (
            <input type="number" step={s.step} value={s.value} data-key={s.key} data-fmt={s.fmt} class="wf-numinput" />
          ) : (
            <input type="range" min={s.min} max={s.max} step={s.step} value={s.value} data-key={s.key} data-fmt={s.fmt} />
          )}
        </div>
      ))}
      <div class="wf-row">
        <button class="wf-toggle" data-toggle data-key="images.left.mirrorH" type="button">Mirror H</button>
        <button class="wf-toggle" data-toggle data-key="images.left.mirrorV" type="button">Mirror V</button>
      </div>

      <div class="wf-subhead">RIGHT IMAGE</div>
      {rightImgSliders.map((s) => (
        <div class="wf-slider" data-slider>
          <label class="wf-label">{s.label} <span data-readout>{fmt(s.value, s.fmt)}</span></label>
          {s.freeform ? (
            <input type="number" step={s.step} value={s.value} data-key={s.key} data-fmt={s.fmt} class="wf-numinput" />
          ) : (
            <input type="range" min={s.min} max={s.max} step={s.step} value={s.value} data-key={s.key} data-fmt={s.fmt} />
          )}
        </div>
      ))}
      <div class="wf-row">
        <button class="wf-toggle" data-toggle data-key="images.right.mirrorH" type="button">Mirror H</button>
        <button class="wf-toggle" data-toggle data-key="images.right.mirrorV" type="button">Mirror V</button>
      </div>
    </div>

    <!-- ── LABELS TAB ──────────────────────────────────────────────── -->
    <div class="wf-tab-panel" data-tab-panel="labels" role="tabpanel" hidden>
      <div class="wf-subhead">PROJECT SAILFISH</div>
      {leftLabelSliders.map((s) => (
        <div class="wf-slider" data-slider>
          <label class="wf-label">{s.label} <span data-readout>{fmt(s.value, s.fmt)}</span></label>
          {s.freeform ? (
            <input type="number" step={s.step} value={s.value} data-key={s.key} data-fmt={s.fmt} class="wf-numinput" />
          ) : (
            <input type="range" min={s.min} max={s.max} step={s.step} value={s.value} data-key={s.key} data-fmt={s.fmt} />
          )}
        </div>
      ))}

      <div class="wf-subhead">FTC TEAM 16366</div>
      {rightLabelSliders.map((s) => (
        <div class="wf-slider" data-slider>
          <label class="wf-label">{s.label} <span data-readout>{fmt(s.value, s.fmt)}</span></label>
          {s.freeform ? (
            <input type="number" step={s.step} value={s.value} data-key={s.key} data-fmt={s.fmt} class="wf-numinput" />
          ) : (
            <input type="range" min={s.min} max={s.max} step={s.step} value={s.value} data-key={s.key} data-fmt={s.fmt} />
          )}
        </div>
      ))}
    </div>

    <!-- ── TEXT TAB ────────────────────────────────────────────────── -->
    <!-- How the section's text appears as you scroll into the robotics
         intro. RoboticsIntroF.astro listens for text.mode and drives the
         reveal off the same scroll progress as the image swoop. -->
    <div class="wf-tab-panel" data-tab-panel="text" role="tabpanel" hidden>
      <div class="wf-row">
        <div class="wf-label">REVEAL MODE</div>
        <div class="wf-pills wf-pills--stack" data-wf-pills="text.mode">
          <button class="wf-pill"           data-pill="slide"     type="button">slide in with images</button>
          <button class="wf-pill"           data-pill="highlight" type="button">orange highlight sweep</button>
          <button class="wf-pill is-active" data-pill="cursive"   type="button">cursive handwriting</button>
          <button class="wf-pill"           data-pill="none"      type="button">none (static)</button>
        </div>
      </div>
      <div class="wf-subhead">CURSIVE WRITING</div>
      <div class="wf-slider" data-slider>
        <label class="wf-label">TRIGGER AT (%) <span data-readout>40</span></label>
        <input type="range" min="0" max="95" step="1" value="40" data-key="text.writeStart" data-fmt="int" />
      </div>
      <div class="wf-slider" data-slider>
        <label class="wf-label">WRITE SPEED (s) <span data-readout>2.0</span></label>
        <input type="range" min="0.4" max="6" step="0.1" value="2" data-key="text.writeSpeed" data-fmt="1dp" />
      </div>
      <div class="wf-row">
        <div class="wf-label">FONT</div>
        <div class="wf-pills" data-wf-pills="text.font">
          <button class="wf-pill is-active" data-pill="satisfy"    type="button">satisfy</button>
          <button class="wf-pill"           data-pill="shadows"    type="button">shadows</button>
          <button class="wf-pill"           data-pill="parisienne" type="button">parisienne</button>
          <button class="wf-pill"           data-pill="pacifico"   type="button">pacifico</button>
        </div>
      </div>
      <div class="wf-tuner__hint" style="padding:8px 0 0">
        TRIGGER = how far the label has risen up the viewport before the pen
        starts; SPEED = seconds per label. Once it starts it plays to the end on
        its own — scrolling away won't stop it.
      </div>
    </div>
  </div>

  <div class="wf-tuner__io">
    <button class="wf-tuner__iobtn" data-wf-copy  type="button">⧉ copy all</button>
    <button class="wf-tuner__iobtn" data-wf-paste type="button">⤓ paste</button>
  </div>
  <div class="wf-tuner__meta" data-wf-meta>…</div>
  <div class="wf-tuner__hint">temporary · drag to taste · click anywhere to fire click effect</div>
</div>

<button class="wf-tuner__fab" data-wf-fab type="button" aria-label="Open wave tuner">≋</button>

<script>
  // ── Default config (mirrors the slider defaults above) ──────────
  const DEFAULTS = {
    main: {
      lineCount: 5,
      thickness: 1.6,
      opacity: 0.22,
      naturalSpeed: 1.0,
      naturalAmp: 1.0,
      cursorReact: 1.0,
      zoom: 1.0,
      // click effect: "droplet" (expanding ring pushing all lines away), "split"
      // (pushes only the two bracketing lines apart), or "ripple" (expanding ring
      // that only opens the bracketing band, as/where the ring's edge reaches it).
      clickMode: "droplet" as "droplet" | "split" | "ripple",
    },
    transition: {
      mode: "water",
      lineCount: 28,
      thickness: 1.4,
      opacity: 1.0,
      naturalSpeed: 1.0,
      naturalAmp: 1.0,
      cursorReact: 1.0,
      fadeStart: 0.55,
      densityToDark: 1.0,
      colorFlip: 0.78,
    },
    horiz: {
      opacityDark: 0.32,
      opacityLight: 0.22,
      fadeStart: 0.25,
      fadeEnd: 0.65,
      shiftScale: 0.4,
      accentLines: false,
    },
    rail: {
      // HorizontalTOC subscribes to wf-config-change and swaps its rail
      // markup based on this value. See WaveTuner.astro RAIL TAB.
      variant: "fat-fixed" as
        "fat-fixed" | "thin-fixed" | "line-thread" | "active-text" | "cumulative-text",
    },
    scroll: {
      // SmoothScroll.astro destroys + recreates Lenis when this changes.
      mode: "default" as "native" | "subtle" | "default" | "soft" | "snappy",
    },
    images: {
      // Bump __v whenever these defaults change meaningfully — a stale saved
      // config gets its images branch reset on load (see hydrate below).
      __v: 2,
      // % of a viewport-height scrolled when the swoop reaches its resting
      // position (RoboticsIntroF maps this to SWOOP_END). 75 = the original
      // "three-quarters in" feel.
      restPct: 75,
      left:  { x: 0, y: 0, rot: 0, scale: 1.0, mirrorH: false, mirrorV: false },
      right: { x: 0, y: 0, rot: 0, scale: 1.0, mirrorH: false, mirrorV: false },
    },
    labels: {
      left:  { x: 0, y: 0, rot: 0, size: 56 },
      right: { x: 0, y: 0, rot: 0, size: 56 },
    },
    text: {
      // RoboticsIntroF reads this to pick the text-reveal animation as the
      // section scrolls in. See the TEXT TAB above.
      mode: "cursive" as "slide" | "highlight" | "cursive" | "none",
      // cursive (Vara handwriting): writing TRIGGERS once the label has risen
      // writeStart% up the viewport (40% ≈ lower-middle, so the pen starts where
      // the reader is looking), then plays for writeSpeed seconds per label.
      writeStart: 40,
      writeSpeed: 2.0,
      font: "satisfy" as "satisfy" | "shadows" | "parisienne" | "pacifico",
    },
  } as const;
  const IMAGES_VERSION = DEFAULTS.images.__v;

  type AnyCfg = Record<string, any>;
  function deepClone<T>(o: T): T { return JSON.parse(JSON.stringify(o)); }
  function mergeInto(target: AnyCfg, source: AnyCfg) {
    for (const k of Object.keys(source)) {
      if (source[k] && typeof source[k] === "object" && !Array.isArray(source[k])) {
        if (typeof target[k] !== "object" || target[k] == null) target[k] = {};
        mergeInto(target[k], source[k]);
      } else {
        target[k] = source[k];
      }
    }
  }

  // Hydrate from localStorage, but always start from defaults so missing
  // keys in saved data don't leave us with undefined.
  const cfg: AnyCfg = deepClone(DEFAULTS);
  let savedImagesV: unknown;
  try {
    const raw = localStorage.getItem("wf-config");
    if (raw) {
      const parsed = JSON.parse(raw);
      savedImagesV = parsed?.images?.__v;
      mergeInto(cfg, parsed);
    }
  } catch {}
  // The flanking images switched from CAD renders to photos, so the old saved
  // image transforms (225° left rotation, mirrored right) no longer apply.
  // Reset just the images branch when the saved version is stale — wave,
  // transition, scroll, etc. tuning is left untouched.
  if (savedImagesV !== IMAGES_VERSION) {
    cfg.images = deepClone(DEFAULTS.images);
    try { localStorage.setItem("wf-config", JSON.stringify(cfg)); } catch {}
  }
  (window as any).__wfConfig = cfg;

  function getAt(path: string): any {
    return path.split(".").reduce((o, k) => (o == null ? undefined : o[k]), cfg);
  }
  function setAt(path: string, value: any) {
    const parts = path.split(".");
    let o: AnyCfg = cfg;
    for (let i = 0; i < parts.length - 1; i++) {
      if (typeof o[parts[i]] !== "object" || o[parts[i]] == null) o[parts[i]] = {};
      o = o[parts[i]];
    }
    o[parts[parts.length - 1]] = value;
  }
  function persist() {
    try { localStorage.setItem("wf-config", JSON.stringify(cfg)); } catch {}
  }
  function fire(key: string, value: any) {
    window.dispatchEvent(new CustomEvent("wf-config-change", { detail: { key, value, cfg } }));
  }
  function formatVal(v: number, fmt: string | null) {
    if (fmt === "int")  return Math.round(v).toString();
    if (fmt === "1dp")  return v.toFixed(1);
    if (fmt === "3dp")  return v.toFixed(3);
    return v.toFixed(2);
  }

  // ── CAD image transform updater ──────────────────────────────────
  // Listens for images.* slider changes and rewrites the .ric__cad
  // transforms. No-ops if the robotics intro section isn't on this page.
  function applyCadImage(side: "left" | "right") {
    const c = (cfg as any).images?.[side];
    if (!c) return;
    const el = document.querySelector<HTMLElement>(`.ric__cad--${side}`);
    if (!el) return;
    const sx = (c.mirrorH ? -1 : 1) * (c.scale ?? 1);
    const sy = (c.mirrorV ? -1 : 1) * (c.scale ?? 1);
    el.style.transform =
      `translate(${c.x ?? 0}px, ${c.y ?? 0}px) ` +
      `rotate(${c.rot ?? 0}deg) ` +
      `scale(${sx}, ${sy})`;
    el.style.transformOrigin = "center center";
    // Live size readout on this side's SCALE slider: rendered width in px
    // (layout width × scale — rotation-independent, aspect ratio locked).
    const scale = c.scale ?? 1;
    const readout = tuner
      ?.querySelector<HTMLElement>(`input[data-key="images.${side}.scale"]`)
      ?.closest("[data-slider]")
      ?.querySelector<HTMLElement>("[data-readout]");
    if (readout) {
      const w = Math.round(el.offsetWidth * scale);
      readout.textContent = w > 0 ? `${scale.toFixed(2)}× · ${w}px` : `${scale.toFixed(2)}×`;
    }
  }
  function applyCadImagesAll() {
    applyCadImage("left");
    applyCadImage("right");
  }

  // ── Hand-label transform updater ─────────────────────────────────
  // Listens for labels.* slider changes and rewrites the translate +
  // rotate on the .ric__hand wrapper elements (data-hand-label attr).
  // Font size is applied directly to the .hand element inside.
  function applyHandLabel(side: "left" | "right") {
    const c = (cfg as any).labels?.[side];
    if (!c) return;
    const wrapper = document.querySelector<HTMLElement>(`[data-hand-label="${side}"]`);
    if (!wrapper) return;
    wrapper.style.transform =
      `translate(${c.x ?? 0}px, ${c.y ?? 0}px) rotate(${c.rot ?? 0}deg)`;
    // Font size lives on the inner .hand element
    const hand = wrapper.querySelector<HTMLElement>(".hand");
    if (hand) hand.style.fontSize = `${c.size ?? 56}px`;
  }
  function applyHandLabelsAll() {
    applyHandLabel("left");
    applyHandLabel("right");
  }

  const tuner = document.querySelector<HTMLElement>("[data-wf-tuner]");
  if (tuner) initTuner(tuner);
  // Initial pass — also retry once after the next frame in case the .ric__cad
  // elements aren't in the DOM yet (different page render order).
  applyCadImagesAll();
  requestAnimationFrame(applyCadImagesAll);
  applyHandLabelsAll();
  requestAnimationFrame(applyHandLabelsAll);

  // ── Collapse / expand ────────────────────────────────────────────────────
  const fab = document.querySelector<HTMLElement>("[data-wf-fab]");

  function setCollapsed(on: boolean) {
    tuner?.classList.toggle("is-collapsed", on);
    fab?.classList.toggle("is-visible", on);
    try { on ? localStorage.setItem("wf-collapsed", "1") : localStorage.removeItem("wf-collapsed"); } catch {}
  }

  // Restore persisted state on load.
  if (localStorage.getItem("wf-collapsed") === "1") setCollapsed(true);

  tuner?.querySelector("[data-wf-close]")?.addEventListener("click", () => setCollapsed(true));
  fab?.addEventListener("click", () => setCollapsed(false));

  // ── Re-sync every control's DOM to the live cfg (used on init + after paste) ──
  function syncDom() {
    if (!tuner) return;
    tuner.querySelectorAll<HTMLInputElement>("input[data-key]").forEach((input) => {
      const value = getAt(input.dataset.key!);
      if (typeof value === "number") {
        input.value = String(value);
        const readout = input.closest("[data-slider]")?.querySelector<HTMLElement>("[data-readout]");
        if (readout) readout.textContent = formatVal(value, input.dataset.fmt ?? null);
      }
    });
    tuner.querySelectorAll<HTMLElement>("[data-toggle][data-key]").forEach((btn) => {
      btn.classList.toggle("is-on", !!getAt(btn.dataset.key!));
    });
    tuner.querySelectorAll<HTMLElement>("[data-wf-pills]").forEach((group) => {
      const value = getAt(group.dataset.wfPills!);
      group.querySelectorAll<HTMLElement>("[data-pill]").forEach((b) => b.classList.toggle("is-active", b.dataset.pill === value));
    });
  }

  // ── device / viewport meta + global copy-paste ──────────────────────────
  function gcd(a: number, b: number): number { return b ? gcd(b, a % b) : a; }
  function deviceMeta() {
    const w = window.innerWidth, h = window.innerHeight;
    const g = gcd(w, h) || 1;
    const dpr = Math.round((window.devicePixelRatio || 1) * 100) / 100;
    const sw = window.screen?.width ?? 0, sh = window.screen?.height ?? 0;
    return {
      viewport: `${w}×${h}`, aspect: `${Math.round(w / g)}:${Math.round(h / g)}`,
      aspectRatio: Math.round((w / h) * 1000) / 1000, screen: `${sw}×${sh}`,
      physical: `${Math.round(sw * dpr)}×${Math.round(sh * dpr)}`, dpr,
      orientation: w >= h ? "landscape" : "portrait", ua: navigator.userAgent,
    };
  }
  function updateMeta() {
    const m = deviceMeta();
    const el = tuner?.querySelector<HTMLElement>("[data-wf-meta]");
    if (el) el.textContent = `${m.viewport} · ${m.aspect} (${m.aspectRatio}) · ${m.orientation} · dpr ${m.dpr} · screen ${m.screen} · zoom ${cfg.main.zoom}`;
  }

  // Root zoom only when ≠ 1 — a literal `zoom: 1` still puts the page on the
  // browser's zoomed render path, which makes position:sticky sections (the
  // robotics side-by-side band) jitter while scrolling. Clearing it at 1 keeps
  // the default page on the normal render path.
  function applyRootZoom(z: number) {
    if (z && z !== 1) document.documentElement.style.setProperty("zoom", String(z));
    else document.documentElement.style.removeProperty("zoom");
  }

  // Re-apply everything after a paste: sync DOM, push to every subsystem (__init),
  // and redo the appliers that don't run each frame (zoom, images, labels).
  function applyAfterPaste() {
    syncDom();
    applyRootZoom(cfg.main.zoom);
    fire("__init", cfg);
    applyCadImagesAll();
    applyHandLabelsAll();
    updateMeta();
  }

  tuner?.querySelector("[data-wf-copy]")?.addEventListener("click", async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    // Everything: the full wf config, the per-section layout config, and the
    // device/aspect metadata — one blob to hand back for responsive defaults.
    const payload = { meta: deviceMeta(), wfConfig: cfg, layout: (window as any).__layoutConfig ?? null };
    const text = JSON.stringify(payload, null, 2);
    try { await navigator.clipboard.writeText(text); btn.textContent = "✓ copied!"; }
    catch { window.prompt("Copy this:", text); btn.textContent = "⧉ copy all"; }
    setTimeout(() => { btn.textContent = "⧉ copy all"; }, 1400);
  });

  tuner?.querySelector("[data-wf-paste]")?.addEventListener("click", async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    let text = "";
    try { text = await navigator.clipboard.readText(); } catch {}
    if (!text) text = window.prompt("Paste settings JSON:") || "";
    if (!text) return;
    try {
      const parsed = JSON.parse(text);
      const incoming = parsed.wfConfig ?? (parsed.meta || parsed.layout ? null : parsed);
      if (incoming && typeof incoming === "object") { mergeInto(cfg, incoming); persist(); applyAfterPaste(); }
      if (parsed.layout && (window as any).__layoutConfig) {
        const lc = (window as any).__layoutConfig;
        // New shape: { global, sections }. (Old flat { hero: {...} } still works.)
        const inc = parsed.layout.global || parsed.layout.sections ? parsed.layout : { sections: parsed.layout };
        if (inc.global) Object.assign(lc.global, inc.global);
        if (inc.sections) for (const k of Object.keys(inc.sections)) {
          if (!lc.sections[k]) continue;
          const s = inc.sections[k];
          if (typeof s.zoom === "number") lc.sections[k].zoom = s.zoom;
          if (s.text) Object.assign(lc.sections[k].text, s.text);
        }
        try { localStorage.setItem("layout-config", JSON.stringify(lc)); } catch {}
        window.dispatchEvent(new Event("layout-apply"));
      }
      btn.textContent = "✓ applied!";
    } catch { btn.textContent = "✗ bad JSON"; }
    setTimeout(() => { btn.textContent = "⤓ paste"; }, 1600);
  });

  updateMeta();
  window.addEventListener("resize", updateMeta, { passive: true });
  window.addEventListener("wf-config-change", (e) => {
    if ((e as CustomEvent).detail?.key === "main.zoom") updateMeta();
  });

  function initTuner(tuner: HTMLElement) {
    // ── Sync every slider/number/toggle/pill DOM to the live config ──
    syncDom();

    // Apply zoom on load (since it isn't reapplied each frame elsewhere).
    applyRootZoom(cfg.main.zoom);
    fire("__init", cfg);

    // ── Tab switching ──────────────────────────────────────────────
    tuner.querySelectorAll<HTMLElement>("[data-tab-btn]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.tabBtn;
        tuner.querySelectorAll<HTMLElement>("[data-tab-btn]").forEach((b) => {
          const on = b === btn;
          b.classList.toggle("is-active", on);
          b.setAttribute("aria-selected", String(on));
        });
        tuner.querySelectorAll<HTMLElement>("[data-tab-panel]").forEach((p) => {
          const on = p.dataset.tabPanel === id;
          p.classList.toggle("is-active", on);
          p.hidden = !on;
        });
      });
    });

    // ── Sliders + number inputs (delegated) ───────────────────────
    const onInputOrChange = (e: Event) => {
      const input = e.target as HTMLInputElement;
      if (!input.matches("input[data-key]")) return;
      if (input.type !== "range" && input.type !== "number") return;
      const key = input.dataset.key!;
      const raw = input.value;
      // Number inputs can be momentarily empty while the user edits — skip
      // pushing a NaN into the config.
      if (raw === "" || raw === "-") return;
      const value = Number(raw);
      if (!Number.isFinite(value)) return;
      setAt(key, value);
      const readout = input.closest("[data-slider]")?.querySelector<HTMLElement>("[data-readout]");
      if (readout) readout.textContent = formatVal(value, input.dataset.fmt ?? null);
      // Apply page zoom immediately when changed.
      if (key === "main.zoom") applyRootZoom(value);
      if (key.startsWith("images.")) applyCadImagesAll();
      if (key.startsWith("labels.")) applyHandLabelsAll();
      persist();
      fire(key, value);
    };
    tuner.addEventListener("input", onInputOrChange);
    tuner.addEventListener("change", onInputOrChange);

    // ── Toggle buttons (mirror H/V) ───────────────────────────────
    tuner.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-toggle]");
      if (!btn) return;
      const key = btn.dataset.key!;
      const next = !getAt(key);
      setAt(key, next);
      btn.classList.toggle("is-on", next);
      if (key.startsWith("images.")) applyCadImagesAll();
      persist();
      fire(key, next);
    });

    // ── Pill groups (hover / click / transition variant) ──────────
    tuner.querySelectorAll<HTMLElement>("[data-wf-pills]").forEach((group) => {
      const key = group.dataset.wfPills!;
      group.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-pill]");
        if (!btn) return;
        const value = btn.dataset.pill!;
        setAt(key, value);
        group.querySelectorAll(".wf-pill").forEach((b) => b.classList.toggle("is-active", b === btn));
        // Back-compat for RoboticsTransition (still listens for this event).
        if (key === "transition.mode") {
          window.dispatchEvent(new CustomEvent("rtxn-mode-change", { detail: { mode: value } }));
        }
        persist();
        fire(key, value);
      });
    });
  }
</script>

