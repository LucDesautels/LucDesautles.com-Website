---
// Subtle topographic-line decoration used behind several cream sections.
interface Props { color?: string; }
const { color = "rgba(26,23,20,0.06)" } = Astro.props;
---
<svg class="waves" preserveAspectRatio="none" viewBox="0 0 1280 800" aria-hidden="true">
  <g fill="none" stroke={color} stroke-width="1">
    <path d="M -100 200 C 200 120, 360 300, 620 230 S 1050 150, 1380 270" />
    <path d="M -100 300 C 180 240, 420 400, 720 320 S 1080 260, 1380 360" />
    <path d="M -100 430 C 200 360, 380 510, 660 450 S 1080 380, 1380 480" />
    <path d="M -100 560 C 200 490, 440 630, 720 560 S 1080 500, 1380 600" />
    <path d="M -100 120 C 240  70, 460 190, 760 120 S 1100  70, 1380 150" />
  </g>
</svg>
<style>
  .waves {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
