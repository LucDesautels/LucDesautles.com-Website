---
// Dense-grid rewrite of MetaSection.
//
// Layout model:
//   [ rail gutter ][ content ]
//   Column 1 is left empty — the page-level SectionRail floats there for the
//   whole lower half (see lower.astro), so "where am I" is answered by a
//   standing outline instead of a full-width 92px heading every few screens.
//   Column 2 is a 12-column dense grid. Every group is sized to land on ONE
//   row at desktop width: 6+3+3, 4+4+4, etc. Essay cards (no image, long
//   copy) take the full 12 and always sort to the end of a group.
import { Image } from "astro:assets";
import type { MetaGroup, Item } from "@/data/content";

interface Props {
  meta: MetaGroup;
  num: number;
  /** Slight rotation + looser voice for the "Experiences" section. */
  quirky?: boolean;
  /** Background tint — sections alternate so they read as separate bands. */
  tone?: "cream" | "warm";
}
const { meta, num, quirky, tone = "cream" } = Astro.props;

/** Column span at desktop / tablet / phone, from the item's role.
 *  Desktop rows deliberately stop short of the full 12 (4+3+3 = 10, 3+3+3 = 9):
 *  filling the width would stretch cards past a sane photo aspect, so the
 *  slack is left as blank space on the right instead. Essays match the 10 so
 *  their right edge lines up with the card rows above. */
function spans(it: Item) {
  if (it.essay)    return { d: 10, m: 12, s: 12 };
  if (it.standout) return { d: 4,  m: 12, s: 12 };
  return { d: 3, m: 6, s: 12 };
}
---
<section class={`mr mr--${tone}`} id={meta.id}>
  <div class="mr__inner shell">
    <!-- Packed grid ─────────────────────────────────────────────────── -->
    <div class="mr__body">
      <!-- Band marker. Low-key on desktop (the rail carries the section);
           promoted to a real header once the rail drops out. -->
      <div class="mr__mark">
        <h2 class="mr__mark-h">
          <span class="mr__mark-n">§ {String(num).padStart(2, "0")}</span>
          <span class="mr__mark-t">{meta.title}</span>
          <span class="mr__mark-sub">{meta.subtitle}</span>
        </h2>
        {quirky && <div class="mr__quirk">slightly less serious from here on.</div>}
      </div>

      {meta.groups.map((g, gi) => {
        // Essays are full-width bands — always last in their group.
        const items = [...g.items].sort((a, b) => Number(!!a.essay) - Number(!!b.essay));

        // Widest row in this group, so the header rule stops where the cards
        // do instead of running out over the blank right-hand slack.
        let run = 0;
        let barSpan = 0;
        for (const it of items) {
          const w = spans(it).d;
          if (run + w > 12) run = 0;
          run += w;
          barSpan = Math.max(barSpan, run);
        }

        return (
          <div class="grp" id={`g-${g.id}`} data-group={g.id} data-spy={g.id}>
            <div class="grp__grid">
              <div class="grp__bar" style={`--bar-span:${barSpan}`}>
                <span class="eyebrow grp__n">
                  {String(gi + 1).padStart(2, "0")} / {String(meta.groups.length).padStart(2, "0")}
                </span>
                <h3 class="grp__title">{g.title}</h3>
                <span class="grp__rule" aria-hidden="true"></span>
                <span class="eyebrow grp__count">{g.items.length} entries</span>
              </div>

              {items.map((it, i) => {
                const sp = spans(it);
                const cls = [
                  "pc",
                  it.standout && "pc--standout",
                  it.outlined && "pc--outlined",
                  it.essay && "pc--essay",
                ].filter(Boolean).join(" ");
                const tilt = quirky && !it.standout && !it.essay
                  ? (i % 2 === 0 ? 0.5 : -0.6)
                  : 0;
                return (
                  <article
                    class={cls}
                    style={`--span:${sp.d};--span-md:${sp.m};--span-sm:${sp.s};--tilt:${tilt}deg;--i:${i}`}
                    data-reveal
                  >
                    {!it.essay && (
                      <div class="pc__media">
                        <Image src={it.image} alt={it.title} loading="lazy" decoding="async" width={600} format="webp" quality={78} />
                        {it.standout && <span class="pc__star" title="Standout">★</span>}
                      </div>
                    )}
                    <div class="pc__text">
                      <h4 class="pc__title">{it.title}</h4>
                      {it.essay && <span class="pc__mark" aria-hidden="true">“</span>}
                      <div class="pc__prose">
                        <p class="pc__body">{it.body}</p>
                        {it.long && <p class="pc__long">{it.long}</p>}
                      </div>
                      {it.href && (
                        <a class="pc__link" href={it.href}>
                          Take a look
                          <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                            <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4.5M9.5 2.5V7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </a>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .mr {
    position: relative;
    z-index: 1;
    padding: 54px var(--page-pad) 58px;
    background: var(--bg);
    color: var(--ink);
  }
  .mr--warm { background: var(--bg-warm); }

  .mr__inner {
    display: grid;
    /* Column 1 is the gutter the page-level SectionRail floats in. */
    grid-template-columns: var(--rail-w, 214px) minmax(0, 1fr);
    gap: var(--rail-gap, 44px);
  }
  .mr__body { grid-column: 2; min-width: 0; }

  /* ── Band marker ──────────────────────────────────────────────────── */
  .mr__mark {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    padding-bottom: 14px;
  }
  .mr__mark-h {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .mr__mark-n { color: var(--accent); }
  .mr__mark-t { color: var(--ink); }
  .mr__mark-sub::before { content: "· "; }
  .mr__quirk {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 14px;
    color: var(--ink-dim);
    line-height: 1.3;
  }

  /* ── Groups ───────────────────────────────────────────────────────── */
  .grp { padding-top: 4px; scroll-margin-top: calc(var(--topbar-h) + 32px); }
  .grp + .grp { margin-top: 30px; }
  /* The header takes a whole grid row — anything narrower and dense flow
     backfills a card into the leftover columns beside it — then caps its own
     width to the group's widest row, so the rule stops where the cards do. */
  .grp__bar {
    grid-column: 1 / -1;
    max-width: calc(
      (100% - 11 * var(--gap)) / 12 * var(--bar-span, 12)
      + (var(--bar-span, 12) - 1) * var(--gap)
    );
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: -4px;
  }
  .grp__n { color: var(--ink-mute); flex: none; }
  .grp__title {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
    flex: none;
  }
  .grp__rule {
    flex: 1 1 auto;
    height: 1px;
    background: var(--rule);
  }
  .grp__count { flex: none; color: var(--ink-mute); }

  .grp__grid {
    --gap: 14px;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: var(--gap);
    align-items: start;
  }

  /* ── Card ─────────────────────────────────────────────────────────── */
  .pc {
    grid-column: span var(--span);
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--rule);
    overflow: hidden;
    transform: rotate(var(--tilt, 0deg));
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }
  .pc:hover {
    transform: rotate(var(--tilt, 0deg)) translateY(-3px);
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.10);
    border-color: rgba(26, 23, 20, 0.28);
  }
  .pc--standout { border: 2px solid var(--accent); }
  .pc--outlined { border: 2px solid var(--accent); }

  /* Media is aspect-driven, not fixed-height, so a card can never letterbox
     its photo no matter how the columns resolve. The two ratios are picked so
     the heights land within a few px of each other at the desktop spans
     (3-span at 4:3 ≈ 4-span at 16:9) — the row still reads as one band. */
  .pc__media {
    position: relative;
    aspect-ratio: 4 / 3;
    flex: none;
    overflow: hidden;
  }
  .pc--standout .pc__media { aspect-ratio: 16 / 9; }
  .pc__media img,
  .pc__ph {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms ease;
  }
  .pc:hover .pc__media img { transform: scale(1.03); }
  .pc__ph { position: relative; }
  .pc__ph .placeholder__label { left: 10px; bottom: 8px; }
  .pc__star {
    position: absolute;
    top: 8px;
    left: 8px;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    background: var(--ink);
    color: var(--bg);
    font-size: 11px;
    line-height: 1;
  }

  .pc__text {
    padding: 12px 14px 14px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .pc__title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin: 0 0 5px;
  }
  .pc--standout .pc__title { font-size: 23px; }
  .pc__body {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-dim);
    margin: 0;
  }
  .pc__link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 9px;
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 500;
    color: #0891b2;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pc__link:hover { color: #06b6d4; }

  /* ── Essay card — no image, full-width band, room to actually write ── */
  .pc--essay {
    background: transparent;
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    position: relative;
  }
  .pc--essay:hover {
    transform: none;
    box-shadow: none;
    border-color: var(--rule);
    border-left-color: var(--accent);
  }
  .pc--essay .pc__text { padding: 26px 30px 28px; }
  .pc--essay .pc__title {
    font-size: 27px;
    font-weight: 500;
    margin-bottom: 12px;
  }
  .pc__mark {
    position: absolute;
    top: 4px;
    right: 22px;
    font-family: var(--font-display);
    font-size: 96px;
    line-height: 1;
    color: var(--accent);
    opacity: 0.16;
    pointer-events: none;
  }
  /* Two columns so the band's width is actually used — the copy sets its own
     measure instead of stopping at 70ch with a third of the band empty. */
  .pc--essay .pc__prose {
    columns: 2;
    column-gap: 40px;
    padding-right: 90px; /* clear of the quote mark */
  }
  .pc--essay .pc__body,
  .pc--essay .pc__long {
    font-size: 15.5px;
    line-height: 1.62;
    color: var(--ink-dim);
    break-inside: avoid-column;
  }
  .pc--essay .pc__body { color: var(--ink); }
  .pc--essay .pc__long { margin: 12px 0 0; }

  /* Engineering filter — the tokens.css rule targets MetaSection's class
     names, so the equivalent lives with the component: drop the Education
     group and its rail entry, keep Research. */
  :global(body.filter-engineering) #academics [data-group="education"],
  :global(body.filter-engineering) [data-spy-link="education"] {
    display: none;
  }

  /* ── Reveal ───────────────────────────────────────────────────────────
     Gated on html.js-reveal, which SectionRail's script adds before its
     first pass. No JS (or a script that failed to load) → cards just render,
     rather than sitting invisible at opacity 0. */
  :global(html.js-reveal) [data-reveal] {
    opacity: 0;
    transform: translateY(12px) rotate(var(--tilt, 0deg));
    transition: opacity 480ms ease, transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i, 0) * 55ms);
  }
  :global(html.js-reveal) [data-reveal].is-in {
    opacity: 1;
    transform: translateY(0) rotate(var(--tilt, 0deg));
  }

  /* ── Responsive ───────────────────────────────────────────────────── */
  @media (max-width: 1280px) {
    .mr__inner { gap: 32px; }
  }
  /* Rail drops out here (see SectionRail) — the band marker takes over as a
     real section header, since nothing else names the section any more. */
  @media (max-width: 1080px) {
    .mr__inner { grid-template-columns: minmax(0, 1fr); }
    .mr__body { grid-column: 1; }
    .mr__mark { padding-bottom: 18px; }
    .mr__mark-h {
      font-family: var(--font-display);
      font-size: 30px;
      font-weight: 500;
      letter-spacing: -0.02em;
      text-transform: none;
      align-items: baseline;
    }
    .mr__mark-n {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }
    .mr__mark-sub {
      font-family: var(--font-body);
      font-size: 13px;
      color: var(--ink-mute);
    }
  }
  @media (max-width: 980px) {
    .pc { grid-column: span var(--span-md); }
    .grp__bar { max-width: none; }
  }
  @media (max-width: 860px) {
    .pc--essay .pc__prose { columns: 1; padding-right: 0; }
  }
  @media (max-width: 620px) {
    .pc { grid-column: span var(--span-sm); }
    /* One card per row — a 4:3 photo would eat the screen. */
    .pc__media, .pc--standout .pc__media { aspect-ratio: 16 / 9; }
    .pc--essay .pc__text { padding: 20px; }
    .pc__mark { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js-reveal) [data-reveal] { opacity: 1; transform: rotate(var(--tilt, 0deg)); }
  }
</style>
