---
import { SITE } from "@/data/content";
import Placeholder from "./Placeholder.astro";
import FilterPills from "./islands/FilterPills.tsx";
import { readdirSync } from "fs";
import { join } from "path";

function heroImgs(): string[] {
  try {
    return readdirSync(join(process.cwd(), "public/images/homepage/hero"))
      .filter((f) => /\.(jpe?g|png|webp|gif|avif)$/i.test(f))
      .sort()
      .map((f) => `/images/homepage/hero/${encodeURIComponent(f)}`);
  } catch {
    return [];
  }
}
const imgs = heroImgs();
---
<section class="hero" id="main">
  <div class="hero__shell shell">
    <div class="hero__grid">
      <div class="hero__col">
        <div class="eyebrow">Preview - Personal Portfolio 2026</div>
        <h1 class="hero__name">
          Luc<br />
          <span class="hero__name-italic">Desautels</span><span class="hero__period">.</span>
        </h1>
        <p class="hero__tagline">
          My main focus right now is in <strong>robotics</strong>,
          however I also rock climb, play fiddle, and have a passion for
          <strong>drone photography</strong>.
        </p>

        <div class="hero__meta">
          {SITE.meta.map((m) => (
            <div class="hero__meta-item">
              <div class="eyebrow">{m.label}</div>
              <div class="hero__meta-value">{m.value}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="hero__polaroids" aria-hidden="true">
        <div class="polaroid polaroid--lg">
          {imgs[0]
            ? <img src={imgs[0]} alt="" class="polaroid__img" style="height:520px;width:380px" />
            : <Placeholder label="Hero portrait · 4:5" h={520} w={380} frame note="REPLACE" />
          }
        </div>
        <div class="polaroid polaroid--md">
          {imgs[1]
            ? <img src={imgs[1]} alt="" class="polaroid__img" style="width:160px;height:auto" />
            : <Placeholder label="In the field" h={220} w={160} frame />
          }
          <div class="caption-drop caption-drop--dark">
            <div class="cd-border cd-border--t"></div>
            <div class="cd-border cd-border--l"></div>
            <div class="cd-border cd-border--b"></div>
            <div class="cd-border cd-border--r"></div>
            <span class="cd-text" style="white-space:pre;line-height:1.45"></span>
          </div>
        </div>
        <div class="polaroid polaroid--sm">
          {imgs[2]
            ? <img src={imgs[2]} alt="" class="polaroid__img" style="width:160px;height:auto" />
            : <Placeholder label="Outdoors" h={170} w={160} frame />
          }
          <div class="caption-drop caption-drop--light">
            <div class="cd-border cd-border--l"></div>
            <div class="cd-border cd-border--b"></div>
            <div class="cd-border cd-border--r"></div>
            <span class="cd-text"></span>
          </div>
        </div>
      </div>
    </div>

    <FilterPills client:visible />
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Top bar sits above this, so 100vh - topbar fills the rest of the viewport. */
    min-height: calc(100vh - var(--topbar-h));
    padding: 32px var(--page-pad) 56px;
    display: flex;
    flex-direction: column;
  }
  .hero__shell {
    position: relative;
    z-index: 1;
    flex: 1;
    /* 2-row grid: hero block fills row 1 (and self-centres in it), filter
       pills sit naturally docked at the bottom in row 2. */
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 48px;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr clamp(440px, 36vw, 600px);
    gap: 56px;
    align-items: center;
    align-self: center;
    width: 100%;
  }
  .hero__col { min-width: 0; }
  .hero__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(72px, 12vw, 168px);
    line-height: 0.9;
    letter-spacing: -0.028em;
    margin: 18px 0 0;
    color: var(--ink);
  }
  .hero__name-italic { font-style: italic; font-weight: 400; }
  .hero__period { color: var(--accent); }
  .hero__tagline {
    font-family: var(--font-body);
    font-size: 21px;
    line-height: 1.45;
    color: var(--ink-dim);
    max-width: 560px;
    margin: 32px 0 0;
    text-wrap: pretty;
  }
  .hero__tagline strong { color: var(--ink); font-weight: 600; }
  .hero__meta {
    display: flex;
    gap: 48px;
    margin-top: 44px;
    flex-wrap: wrap;
  }
  .hero__meta-value {
    font-family: var(--font-body);
    font-size: 18px;
    color: var(--ink);
    font-weight: 700;
    margin-top: 6px;
  }

  @font-face {
    font-family: 'MatrixtypeDisplay';
    src: url('/fonts/matrixtype-font/MatrixtypeDisplay-9MyE5.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
  }

  .polaroid__img {
    display: block;
    object-fit: cover;
    object-position: center top;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.22);
  }

  /* Polaroid cluster — absolutely positioned so they can overlap. */
  .hero__polaroids {
    position: relative;
    height: 640px;
  }
  .polaroid {
    position: absolute;
  }
  .polaroid--lg { top: 0; right: 0; transform: rotate(3deg); }
  .polaroid--md { bottom: 60px; left: -24px; transform: rotate(-5deg); }
  .polaroid--sm { bottom: 10px; right: -20px; transform: rotate(0deg); }

  /* ── Caption drops ─────────────────────────────────────────────────────── */
  .caption-drop {
    height: 28px;
    display: flex;
    align-items: center;
    padding: 0 8px;
    position: relative;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 210ms cubic-bezier(0.4, 0, 0.2, 1);
    font-family: 'MatrixtypeDisplay', 'Courier New', Courier, monospace;
    font-size: 10px;
    letter-spacing: 0.04em;
  }
  .caption-drop.is-open { clip-path: inset(0); }
  .caption-drop--dark  { background: #1f1d1b; color: var(--accent); }
  .caption-drop--light { background: #ffffff; color: #555; }
  /* Two-line Sailfish caption */
  .polaroid--md .caption-drop { height: 44px; }

  .cd-border { position: absolute; background: currentColor; }
  .cd-border--t { top:    0; left:   0; height: 2px; width:  0; }
  .cd-border--l { left:   0; top:    0; width:  2px; height: 0; }
  .cd-border--b { bottom: 0; left:   0; height: 2px; width:  0; }
  .cd-border--r { right:  0; bottom: 0; width:  2px; height: 0; }
  /* Skiing: borders use the same subtle grey as site rule lines */
  .caption-drop--light .cd-border { background: var(--rule); }

  .cd-text { white-space: nowrap; }

  @media (max-width: 960px) {
    .hero { min-height: auto; }
    .hero__grid { grid-template-columns: 1fr; }
    .hero__polaroids { height: 540px; margin-top: 24px; }
    .polaroid--lg { right: auto; left: 0; }
    .polaroid--md { left: 200px; bottom: 40px; }
    .polaroid--sm { bottom: 10px; right: -20px; }
  }

  @media (max-width: 640px) {
    .hero__polaroids { height: 480px; }
    .polaroid--lg { transform: rotate(2deg) scale(0.85); transform-origin: top left; }
    .polaroid--md { left: 160px; transform: rotate(-4deg) scale(0.85); transform-origin: bottom left; }
    .polaroid--sm { bottom: 10px; right: -10px; transform: scale(0.85); transform-origin: bottom right; }
  }
</style>

<script is:inline>
(function () {
  var SLIDE_MS = 210;
  var BORDER_T = 90;
  var BORDER_L = 110;
  var BORDER_B = 120;
  var BORDER_R = 110;
  var STEPS_T  = 9;
  var STEPS_L  = 11;
  var STEPS_B  = 12;
  var STEPS_R  = 11;
  var CHAR_MS  = 28;

  function animateBorder(el, prop, endVal, duration, steps, finalCss) {
    var start = null;
    var stepSize = endVal / steps;
    function tick(ts) {
      if (!start) start = ts;
      var pct = Math.min((ts - start) / duration, 1);
      el.style[prop] = (Math.floor(pct * steps) * stepSize) + 'px';
      if (pct < 1) requestAnimationFrame(tick);
      else el.style[prop] = finalCss || (endVal + 'px');
    }
    requestAnimationFrame(tick);
  }

  function typewrite(el, text, onDone) {
    var i = 0;
    el.textContent = '';
    var iv = setInterval(function () {
      el.textContent = text.slice(0, ++i);
      if (i >= text.length) { clearInterval(iv); if (onDone) onDone(); }
    }, CHAR_MS);
  }

  function setup(polaroidEl, text) {
    var drop   = polaroidEl.querySelector('.caption-drop');
    var bT     = polaroidEl.querySelector('.cd-border--t');
    var bL     = polaroidEl.querySelector('.cd-border--l');
    var bB     = polaroidEl.querySelector('.cd-border--b');
    var bR     = polaroidEl.querySelector('.cd-border--r');
    var textEl = polaroidEl.querySelector('.cd-text');
    var animated = false;
    var animating = false;

    function runFirstAnim() {
      if (animated || animating) return;
      animating = true;

      var boxH = drop.offsetHeight || 28;
      var boxW = drop.offsetWidth  || 160;
      var tOff = 0;

      if (bT) {
        setTimeout(function () {
          animateBorder(bT, 'width', boxW, BORDER_T, STEPS_T, '100%');
        }, SLIDE_MS - 60);
        tOff = BORDER_T;
      }
      setTimeout(function () {
        animateBorder(bL, 'height', boxH, BORDER_L, STEPS_L);
      }, SLIDE_MS - 60 + tOff);
      setTimeout(function () {
        animateBorder(bB, 'width', boxW, BORDER_B, STEPS_B, '100%');
      }, SLIDE_MS - 60 + tOff + BORDER_L);
      setTimeout(function () {
        animateBorder(bR, 'height', boxH, BORDER_R, STEPS_R);
      }, SLIDE_MS - 60 + tOff + BORDER_L + BORDER_B);

      var textDelay = SLIDE_MS + tOff + BORDER_L + BORDER_B + BORDER_R - 40;
      setTimeout(function () {
        typewrite(textEl, text, function () {
          animated = true;
          animating = false;
        });
      }, textDelay);
    }

    polaroidEl.addEventListener('mouseenter', function () {
      drop.classList.add('is-open');
      runFirstAnim();
    });
    polaroidEl.addEventListener('mouseleave', function () {
      drop.classList.remove('is-open');
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    var md = document.querySelector('.polaroid--md');
    var sm = document.querySelector('.polaroid--sm');
    if (md) setup(md, '> Project Sailfish\nfield testing');
    if (sm) setup(sm, '> Backcountry Skiing');
  });
})();
</script>
