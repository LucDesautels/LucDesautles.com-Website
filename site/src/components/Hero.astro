---
import { SITE } from "@/data/content";
import Placeholder from "./Placeholder.astro";
import FilterPills from "./islands/FilterPills.tsx";
---
<section class="hero" id="main">
  <div class="hero__shell shell">
    <div class="hero__grid">
      <div class="hero__col">
        <div class="eyebrow">Personal Portfolio 2026</div>
        <h1 class="hero__name">
          Luc<br />
          <span class="hero__name-italic">Desautels</span><span class="hero__period">.</span>
        </h1>
        <p class="hero__tagline">
          My main focus right now is in <strong>robotics</strong>,
          however I also rock climb, play fiddle, and have a passion for
          <strong>drone photography</strong>.
        </p>

        <div class="hero__meta">
          {SITE.meta.map((m) => (
            <div class="hero__meta-item">
              <div class="eyebrow">{m.label}</div>
              <div class="hero__meta-value">{m.value}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="hero__polaroids" aria-hidden="true">
        <div class="polaroid polaroid--lg">
          <Placeholder label="Hero portrait · 4:5" h={520} w={380} frame note="REPLACE" />
          <div class="polaroid__caption">Luc · workshop, Toronto</div>
        </div>
        <div class="polaroid polaroid--md">
          <Placeholder label="In the field" h={220} w={260} frame />
          <div class="polaroid__caption polaroid__caption--sm">Sailfish field test</div>
        </div>
        <div class="polaroid polaroid--sm">
          <Placeholder label="Outdoors" h={170} w={200} frame />
          <div class="polaroid__caption polaroid__caption--xs">On rope</div>
        </div>
      </div>
    </div>

    <FilterPills client:visible />
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Top bar sits above this, so 100vh - topbar fills the rest of the viewport. */
    min-height: calc(100vh - var(--topbar-h));
    padding: 32px var(--page-pad) 56px;
    display: flex;
    flex-direction: column;
  }
  .hero__shell {
    position: relative;
    z-index: 1;
    flex: 1;
    /* 2-row grid: hero block fills row 1 (and self-centres in it), filter
       pills sit naturally docked at the bottom in row 2. */
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 48px;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr clamp(440px, 36vw, 600px);
    gap: 56px;
    align-items: center;
    align-self: center;
    width: 100%;
  }
  .hero__col { min-width: 0; }
  .hero__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(72px, 12vw, 168px);
    line-height: 0.9;
    letter-spacing: -0.028em;
    margin: 18px 0 0;
    color: var(--ink);
  }
  .hero__name-italic { font-style: italic; font-weight: 400; }
  .hero__period { color: var(--accent); }
  .hero__tagline {
    font-family: var(--font-body);
    font-size: 21px;
    line-height: 1.45;
    color: var(--ink-dim);
    max-width: 560px;
    margin: 32px 0 0;
    text-wrap: pretty;
  }
  .hero__tagline strong { color: var(--ink); font-weight: 600; }
  .hero__meta {
    display: flex;
    gap: 48px;
    margin-top: 44px;
    flex-wrap: wrap;
  }
  .hero__meta-value {
    font-family: var(--font-body);
    font-size: 18px;
    color: var(--ink);
    font-weight: 700;
    margin-top: 6px;
  }

  /* Polaroid cluster — absolutely positioned so they can overlap. */
  .hero__polaroids {
    position: relative;
    height: 640px;
  }
  .polaroid { position: absolute; }
  .polaroid--lg { top: 0; right: 0; transform: rotate(3deg); }
  .polaroid--md { bottom: 60px; left: -24px; transform: rotate(-5deg); }
  .polaroid--sm { top: 360px; left: 200px; transform: rotate(8deg); }

  .polaroid__caption {
    padding: 10px 12px 14px;
    background: #fff;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--ink-dim);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.10);
    margin-top: -2px;
  }
  .polaroid__caption--sm { padding: 8px 10px 12px; font-size: 11px; box-shadow: 0 12px 28px rgba(0, 0, 0, 0.10); }
  .polaroid__caption--xs { padding: 6px 8px 10px; font-size: 10px; box-shadow: 0 10px 22px rgba(0, 0, 0, 0.10); }

  @media (max-width: 960px) {
    .hero { min-height: auto; }
    .hero__grid { grid-template-columns: 1fr; }
    .hero__polaroids { height: 540px; margin-top: 24px; }
    .polaroid--lg { right: auto; left: 0; }
    .polaroid--md { left: 200px; bottom: 40px; }
    .polaroid--sm { top: 380px; left: auto; right: 0; }
  }

  @media (max-width: 640px) {
    .hero__polaroids { height: 480px; }
    .polaroid--lg { transform: rotate(2deg) scale(0.85); transform-origin: top left; }
    .polaroid--md { left: 160px; transform: rotate(-4deg) scale(0.85); transform-origin: bottom left; }
    .polaroid--sm { top: 340px; transform: rotate(6deg) scale(0.85); transform-origin: top right; }
  }
</style>
