---
// Full-screen loading overlay — shown first on every page load. Plays one of
// the five luc-loader wordmark animations (random variant, picked internally
// by the custom element) over a solid cream backdrop, then wipes away once
// the window "load" event fires (document + all subresources — images,
// fonts, etc. — finished). luc-loader.js is a self-contained custom element
// with no dependencies (public/luc-loader.js — see its header comment for
// the full attribute/API rundown).
---
<div class="loading-screen" data-loading-screen role="status" aria-live="polite">
  <luc-loader data-loader variant="random" ink="#1a1714"></luc-loader>
  <span class="loading-screen__sr">Loading…</span>
</div>

<script is:inline src="/luc-loader.js"></script>

<script>
  interface LucLoaderEl extends HTMLElement {
    play(): void;
    exit(): Promise<void>;
  }

  const screen = document.querySelector<HTMLElement>("[data-loading-screen]");
  const loader = document.querySelector<LucLoaderEl>("[data-loader]");

  // Block scroll behind the overlay until the page has fully loaded.
  document.documentElement.style.overflow = "hidden";

  // Keep the overlay up until the home page's contents section (the pinned horizontal
  // strip) has hydrated and measured itself. Window "load" doesn't wait for island
  // scripts, so without this the page can be revealed while that section is still its
  // server-rendered fallback. Resolves straight away on pages without it, and gives up
  // after a few seconds so a failed hydration can never trap the user behind the loader.
  function contentsReady(): Promise<void> {
    const island = document.querySelector('astro-island[component-url*="HorizontalTOC"]');
    if (!island) return Promise.resolve();
    return new Promise((resolve) => {
      // two frames after hydration: its layout effect decides pinned vs manual, then re-renders
      const settle = () => requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
      if (!island.hasAttribute("ssr")) return settle();
      const mo = new MutationObserver(() => {
        if (!island.hasAttribute("ssr")) {
          mo.disconnect();
          settle();
        }
      });
      mo.observe(island, { attributes: true, attributeFilter: ["ssr"] });
      window.setTimeout(() => { mo.disconnect(); resolve(); }, 4000);
    });
  }

  window.addEventListener("load", () => {
    contentsReady().then(() =>
      loader?.exit().then(() => {
        screen?.classList.add("is-gone");
        document.documentElement.style.overflow = "";
      }),
    );
  });
</script>

<style>
  .loading-screen {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: grid;
    place-items: center;
    background: var(--bg);
    transition: opacity 0.4s ease;
  }
  .loading-screen.is-gone {
    opacity: 0;
    pointer-events: none;
  }
  .loading-screen luc-loader {
    width: min(560px, 70vw);
  }
  .loading-screen__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
