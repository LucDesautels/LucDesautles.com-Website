---
import "@/styles/tokens.css";
import LoadingScreen from "@/components/LoadingScreen.astro";
import WaveField from "@/components/WaveField.astro";
import WaveTuner from "@/components/WaveTuner.astro";
import LayoutTuner from "@/components/LayoutTuner.astro";
import CpsCounter from "@/components/CpsCounter.astro";
import ScrollMonitor from "@/components/ScrollMonitor.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const {
  title = "Luc Desautels — robotics, drone photography, and side quests",
  description = "Luc Desautels' personal portfolio. Project Sailfish (open-source marine SAR drone), FTC Team 16366, drone videography, and more.",
  ogImage = "/og.png",
  noIndex = false,
} = Astro.props;

const SITE_URL = Astro.site ?? new URL("https://lucdesautels.com");
const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
const ogImageUrl = new URL(ogImage, SITE_URL).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    {/* Theme-color matches the cream/dark site palette so mobile browser
        chrome blends in instead of staying default grey. */}
    <meta name="theme-color" content="#f1ede3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161412" media="(prefers-color-scheme: dark)" />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Luc Desautels — robotics, drone photography, and side quests" />
    <meta property="og:site_name" content="Luc Desautels" />
    <meta property="og:locale" content="en_CA" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Person structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Luc Desautels",
      url: SITE_URL.toString(),
      email: "L@desautels.net",
      jobTitle: "Engineer · Robotics",
      address: { "@type": "PostalAddress", addressLocality: "Toronto", addressRegion: "ON", addressCountry: "CA" },
      sameAs: [
        "https://github.com/lucdesautels",
        "https://linkedin.com/in/lucdesautels",
      ],
    })} />

    <!-- Fonts: preconnect + a single self-bundled stylesheet from Google Fonts.
         If you later want to self-host, swap to @fontsource/* packages. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=JetBrains+Mono:wght@400;500&family=Khand:wght@500;600;700&family=Manrope:wght@400;500;600;700&family=Newsreader:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <LoadingScreen />
    {/* Keyboard-first navigation aid — visually hidden until focused. */}
    <a class="skip-link" href="#main">Skip to content</a>
    <SmoothScroll />
    <WaveTuner />
    <LayoutTuner />
    <CpsCounter />
    <ScrollMonitor />
    <WaveField />
    <slot />

    <style is:global>
      /* Disable the browser's scroll-anchoring: if any element resizes near the
         viewport, the browser would nudge scrollTop to compensate, which fights
         Lenis's JS-driven scroll and reads as a momentum "bump". */
      html { overflow-anchor: none; }

      /* LayoutTuner: per-text-type sizing. Each element's scale =
         --ts-all × --ts-<type>. Those vars are set on :root (the global page
         default) and optionally overridden on a [data-rsec] wrapper (inherited
         otherwise — that's the global→section cascade, for free). Block text
         only so nested inline runs don't compound. zoom reflows, so it stays
         layout-correct. Per-section ZOOM is a separate inline el.style.zoom.
         Gated behind html[data-ts-text] (set by LayoutTuner only when some text
         scale ≠ 1) so the DEFAULT page carries no `zoom` at all — a literal
         zoom:1 still trips the browser's zoomed render path and jitters the
         position:sticky robotics band on scroll. */
      /* The site mixes semantic headings with BEM-named spans/divs for text, so
         the map covers both tags AND class-name conventions (__title, __body,
         …) to catch everything. All rules share specificity, so ORDER decides
         overlaps: body is the broad catch first; eyebrow/header/subtitle/title
         come after to win for the recognised kinds (h2.ms__title → title,
         h4.rplb__title → subtitle, span.row__title → header, …). */
      [data-ts-text] [data-rsec] :where(p, li, blockquote, dd, figcaption,
        [class*="__body"], [class*="__text"], [class*="__caption"], [class*="__desc"],
        [class*="__meta"], [class*="__hint"], [class*="__blurb"], [class*="__note"],
        [class*="label"], [class*="__value"], [class*="__detail"], [class*="__quote"],
        [class*="__cite"], [class*="__role"], [class*="__copy"], [class*="__period"],
        [class*="__quirk"], [class*="__tagline"], [class*="cta"], [class*="pill"],
        [class*="chip"], [class*="__domain"], [class*="__intro"], [class*="__email"],
        [class*="tile-cap"], .pr__d, .sub__all, .sub__empty,
        .ft__links a, .ft__right div) {
        zoom: calc(var(--ts-all, 1) * var(--ts-body, 1));
      }
      [data-ts-text] [data-rsec] :where(.eyebrow, [class*="eyebrow"], [class*="__counter"], [class*="__num"],
        [class*="__tag"], [class*="__kicker"], [class*="__corner-mark"], [class*="__tab"]) {
        zoom: calc(var(--ts-all, 1) * var(--ts-eyebrow, 1));
      }
      [data-ts-text] [data-rsec] :where(h3, .ric__small, [class*="__title"], [class*="__heading"], .pr__t) {
        zoom: calc(var(--ts-all, 1) * var(--ts-header, 1));
      }
      [data-ts-text] [data-rsec] :where(h4, h5, h6, [class*="__subtitle"], [class*="__deck"], [class*="__lede"]) {
        zoom: calc(var(--ts-all, 1) * var(--ts-subtitle, 1));
      }
      [data-ts-text] [data-rsec] :where(h1, h2, .ric__big, [class*="hero__name"]) {
        zoom: calc(var(--ts-all, 1) * var(--ts-title, 1));
      }
      /* the cursive Vara/Caveat label has its own sizing — keep it out of the sweep */
      [data-ts-text] [data-rsec] :where(.hand, .hand__text) { zoom: 1; }

      .skip-link {
        position: fixed;
        top: 8px;
        left: 8px;
        z-index: 1000;
        padding: 10px 14px;
        background: var(--ink);
        color: var(--bg);
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        text-decoration: none;
        border: 1px solid var(--accent);
        transform: translateY(-150%);
        transition: transform 180ms ease;
      }
      .skip-link:focus { transform: translateY(0); outline: none; }
    </style>
  </body>
</html>
