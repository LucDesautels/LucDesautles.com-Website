---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TopBar from "@/components/TopBar.astro";
import Placeholder from "@/components/Placeholder.astro";
import { SITE, ENG_PROJECTS, ENG_TAGS } from "@/data/content";
---
<BaseLayout title="Engineering portfolio · Luc Desautels" description="The full engineering portfolio: ~20 sub-projects across Sailfish, FTC, and standalone work.">
  <TopBar />

  <main class="ep" id="main">
    <!-- Lander ─────────────────────────────────────────────────────── -->
    <section class="ep__lander">
      <div class="ep__lander-grid shell">
        <div class="ep__lander-col">
          <div class="eyebrow eyebrow--accent">// LUC DESAUTELS · ENGINEERING PORTFOLIO</div>
          <h1 class="ep__title">
            Engineering<br />
            <span class="ep__title-italic">portfolio</span><span class="ep__period">.</span>
          </h1>
          <div class="ep__byline">The engineering work of <strong>Luc Desautels</strong>.</div>
          <p class="ep__tagline">
            Twenty sub-projects across three programs. Hover to preview, click to lock
            a project, open any image for the full write-up. Filter by <strong>discipline</strong>.
          </p>
          <div class="ep__meta">
            {SITE.meta.map((m) => (
              <div class="ep__meta-item">
                <div class="eyebrow eyebrow--dark">{m.label}</div>
                <div class="ep__meta-value">{m.value}</div>
              </div>
            ))}
            <div class="ep__meta-item">
              <div class="eyebrow eyebrow--dark">Total</div>
              <div class="ep__meta-value">{ENG_PROJECTS.length} sub-projects</div>
            </div>
          </div>

          <a class="ep__scroll" href="#all" aria-label="Scroll to project grid">
            <span>// SCROLL — PROJECT GRID</span>
            <span class="ep__scroll-arrow">↓</span>
          </a>
        </div>

        <div class="ep__lander-figure" aria-hidden="true">
          <div class="ep__chip ep__chip--1"><Placeholder label="SAILFISH GEN.3" aspect="16/10" dark note="HERO" /></div>
          <div class="ep__chip ep__chip--2"><Placeholder label="FTC ARM TRANSFER" aspect="4/3" dark note="CAD" /></div>
          <div class="ep__chip ep__chip--3"><Placeholder label="THRUST STAND" aspect="4/3" dark note="RIG" /></div>
          <div class="ep__chip-text">
            <div class="eyebrow eyebrow--accent">// TELEMETRY</div>
            <div class="ep__chip-rows">
              <div>SAILFISH · 09 SUB</div>
              <div>FTC · 04 SUB</div>
              <div>STANDALONE · 06 SUB</div>
              <div>RESEARCH ENTRIES · 04</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Grid + filters + detail ─────────────────────────────────────── -->
    <section class="ep__projects" id="all" data-projects>
      <div class="shell">
        <div class="ep__sec-head">
          <div>
            <div class="eyebrow eyebrow--accent">// 01 — PROJECT GRID</div>
            <h2 class="ep__sec-title">All twenty.</h2>
          </div>
          <div class="ep__hint">
            Hover to preview · click a tile to lock it as selected.
          </div>
        </div>

        <div class="ep__filters" role="toolbar" aria-label="Filter projects by tag">
          <button class="ep-pill is-active" data-tag="ALL" type="button" aria-pressed="true">All <span class="ep-pill__count">{ENG_PROJECTS.length}</span></button>
          {ENG_TAGS.map((tag) => {
            const n = ENG_PROJECTS.filter((p) => p.tags.includes(tag)).length;
            return (
              <button class="ep-pill" data-tag={tag} type="button" aria-pressed="false">
                {tag} <span class="ep-pill__count">{n}</span>
              </button>
            );
          })}
        </div>

        <div class="ep__split">
          <div class="ep__cards" data-cards>
            {ENG_PROJECTS.map((p, i) => (
              <button
                class={`ep-card${i === 0 ? " is-focus" : ""}`}
                data-card
                data-id={p.id}
                data-tags={p.tags.join("|")}
                type="button"
                aria-pressed="false"
                aria-label={`${p.title} — click to select`}
              >
                <div class="ep-card__overline">
                  <span class="ep-card__parent">{p.parent ?? "STANDALONE"}</span>
                  <span class="ep-card__year">{p.year ?? "—"}</span>
                </div>
                <h3 class="ep-card__title">{p.title}</h3>
                <p class="ep-card__blurb">{p.blurb}</p>
                <div class="ep-card__tags">
                  {p.tags.map((t) => (
                    <span class="ep-card__tag">{t}</span>
                  ))}
                </div>
                <span class="ep-card__cursor" aria-hidden="true">↗</span>
                <span class="ep-card__badge" aria-hidden="true">● Selected</span>
              </button>
            ))}
          </div>

          <aside class="ep__detail" data-detail>
            {ENG_PROJECTS.map((p, i) => (
              <article class={`ep-detail${i === 0 ? " is-active" : ""}`} data-detail-id={p.id}>
                <div class="ep-detail__head">
                  <div class="eyebrow eyebrow--accent">// {String(i + 1).padStart(2, "0")} / {String(ENG_PROJECTS.length).padStart(2, "0")}</div>
                  <h3 class="ep-detail__title">{p.title}</h3>
                  <div class="ep-detail__sub">
                    <span>{p.parent ?? "Standalone"}</span>
                    <span class="ep-detail__sep">·</span>
                    <span>{p.year ?? "—"}</span>
                  </div>
                </div>
                <div class="ep-detail__media">
                  <div class="ep-cz" data-cz data-id={p.id}>
                    <div
                      class="ep-cz__frame"
                      data-cz-frame
                      data-id={p.id}
                      role="button"
                      tabindex="0"
                      aria-label={`Open ${p.title} in the lightbox`}
                    >
                      {p.images.map((img, ii) => (
                        <div class={`ep-cz__slide${ii === 0 ? " is-active" : ""}`} data-cz-slide={ii}>
                          <img src={img.src} alt={img.caption} loading="lazy" decoding="async" />
                          <div class="ep-cz__cap">{img.caption}</div>
                        </div>
                      ))}
                      <span class="ep-cz__zoom" aria-hidden="true">⤢ Expand</span>
                    </div>
                    {p.images.length > 1 && (
                      <div class="ep-cz__bars" data-cz-bars data-id={p.id}>
                        {p.images.map((_, ii) => (
                          <button
                            class={`ep-cz__bar${ii === 0 ? " is-active" : ""}`}
                            data-cz-bar={ii}
                            type="button"
                            aria-label={`Image ${ii + 1}`}
                          >
                            <span class="ep-cz__fill"></span>
                          </button>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
                <div class="ep-detail__body">
                  <p class="ep-detail__blurb">{p.blurb}</p>
                  <p class="ep-detail__long">{p.detail}</p>
                </div>
                <div class="ep-detail__tags">
                  {p.tags.map((t) => (
                    <span class="ep-detail__tag">{t}</span>
                  ))}
                </div>
              </article>
            ))}
            <div class="ep-detail-empty" data-detail-empty hidden>
              <div class="eyebrow eyebrow--dark">// NO MATCH</div>
              <p>No projects match the current filter combination.</p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Project lightbox: image carousel + extended write-up. ──────────── -->
    <div class="eplb" data-eplb hidden aria-hidden="true">
      <div class="eplb__backdrop" data-eplb-close></div>
      <div class="eplb__panel" role="dialog" aria-modal="true" aria-label="Project detail">
        <div class="eplb__bars" data-eplb-bars>
          {[0, 1, 2, 3, 4].map((i) => (
            <button class="eplb__bar" data-eplb-bar={i} type="button" aria-label={`Image ${i + 1}`} hidden>
              <span class="eplb__bar-fill"></span>
            </button>
          ))}
        </div>

        <div class="eplb__main">
          <div class="eplb__media" data-eplb-media>
            {ENG_PROJECTS.map((p) =>
              p.images.map((img, i) => (
                <div class="eplb__slide" data-eplb-slide data-pid={p.id} data-idx={i} hidden>
                  <div class="eplb__img">
                    <img src={img.src} alt={img.caption} loading="lazy" decoding="async" />
                    <div class="eplb__cap">{img.caption}</div>
                  </div>
                </div>
              ))
            )}

            <button class="eplb__nav eplb__nav--prev" data-eplb-prev aria-label="Previous image" type="button">
              <span class="eplb__arrow">‹</span>
            </button>
            <button class="eplb__nav eplb__nav--next" data-eplb-next aria-label="Next image" type="button">
              <span class="eplb__arrow">›</span>
            </button>

            <div class="eplb__hint" data-eplb-hint aria-hidden="true">
              <div class="eplb__hint-half"><span class="eplb__hint-pill">‹ Click — previous</span></div>
              <div class="eplb__hint-line"></div>
              <div class="eplb__hint-half"><span class="eplb__hint-pill">Click — next ›</span></div>
            </div>
          </div>

          <aside class="eplb__info" data-eplb-info-wrap>
            {ENG_PROJECTS.map((p, idx) => (
              <div class="eplb__info-block" data-eplb-info data-pid={p.id} hidden>
                <div class="eyebrow eyebrow--accent">// {String(idx + 1).padStart(2, "0")} / {String(ENG_PROJECTS.length).padStart(2, "0")}</div>
                <h3 class="eplb__title">{p.title}</h3>
                <div class="eplb__sub">
                  <span>{p.parent ?? "Standalone"}</span>
                  <span class="eplb__sep">·</span>
                  <span>{p.year ?? "—"}</span>
                </div>
                <p class="eplb__blurb">{p.blurb}</p>
                <div class="eplb__field">
                  <div class="eyebrow eyebrow--dark">&gt; Requirements</div>
                  <p>{p.requirements}</p>
                </div>
                <div class="eplb__field">
                  <div class="eyebrow eyebrow--dark">&gt; What I did</div>
                  <p>{p.contribution}</p>
                </div>
                <div class="eplb__field">
                  <div class="eyebrow eyebrow--dark">&gt; Result</div>
                  <p>{p.result}</p>
                </div>
                <div class="eplb__tags">
                  {p.tags.map((t) => (
                    <span class="eplb__tag">{t}</span>
                  ))}
                </div>
              </div>
            ))}
          </aside>
        </div>

        <button class="eplb__close" data-eplb-close type="button" aria-label="Close">×</button>
      </div>
    </div>
  </main>

  <script>
    (function () {
      const root = document.querySelector("[data-projects]") as HTMLElement | null;
      if (!root) return;

      const pills = root.querySelectorAll<HTMLButtonElement>(".ep-pill");
      const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-card]"));
      const details = Array.from(root.querySelectorAll<HTMLElement>("[data-detail-id]"));
      const empty = root.querySelector<HTMLElement>("[data-detail-empty]");

      // Lightbox open-state declared early — referenced by the carousel's
      // visibility handler before the lightbox section below.
      let lbOpen = false;

      // Locked-selection state — null means "nothing locked, hover previews".
      let selectedId: string | null = null;

      // ── Detail-panel carousel ───────────────────────────────────────
      // Only the currently-focused project's carousel runs. Instagram-style
      // progress bars; the active bar fills over CZ_TICK then advances.
      const CZ_TICK = 3800;
      let czEl: HTMLElement | null = null;
      let czIdx = 0;
      let czCount = 0;
      let czTimer: number | null = null;

      function czRender(animate: boolean) {
        if (!czEl) return;
        const slides = czEl.querySelectorAll<HTMLElement>(".ep-cz__slide");
        const bars = czEl.querySelectorAll<HTMLElement>(".ep-cz__bar");
        slides.forEach((s, i) => s.classList.toggle("is-active", i === czIdx));
        bars.forEach((b, i) => {
          b.classList.toggle("is-active", i === czIdx);
          const fill = b.querySelector(".ep-cz__fill") as HTMLElement | null;
          if (!fill) return;
          fill.style.animation = "none";
          if (i < czIdx) {
            fill.style.width = "100%";
          } else if (i > czIdx) {
            fill.style.width = "0%";
          } else if (animate) {
            fill.style.width = "0%";
            void fill.offsetWidth;
            fill.style.animation = `ep-cz-fill ${CZ_TICK}ms linear forwards`;
          } else {
            fill.style.width = "100%";
          }
        });
      }
      function czStop() {
        if (czTimer != null) { window.clearTimeout(czTimer); czTimer = null; }
      }
      function czStart() {
        czStop();
        if (czCount <= 1 || document.hidden || lbOpen) return;
        czTimer = window.setTimeout(() => {
          czIdx = (czIdx + 1) % czCount;
          czRender(true);
          czStart();
        }, CZ_TICK);
      }
      function czActivate(id: string) {
        czStop();
        czEl = root!.querySelector<HTMLElement>(`.ep-cz[data-id="${id}"]`);
        czIdx = 0;
        czCount = czEl ? czEl.querySelectorAll(".ep-cz__slide").length : 0;
        czRender(true);
        czStart();
      }

      // ── Tag filter — "ALL" is exclusive ─────────────────────────────
      let active: Set<string> = new Set(["ALL"]);

      function applyFilter() {
        const tags = active;
        const isAll = tags.has("ALL") || tags.size === 0;
        let visible = 0;
        let firstVisibleId: string | null = null;
        cards.forEach((card) => {
          const cardTags = (card.getAttribute("data-tags") ?? "").split("|").filter(Boolean);
          const match = isAll || cardTags.some((t) => tags.has(t));
          card.classList.toggle("is-hidden", !match);
          if (match) {
            visible++;
            if (!firstVisibleId) firstVisibleId = card.getAttribute("data-id");
          }
        });
        // A locked selection that's been filtered out is released.
        if (selectedId) {
          const selCard = cards.find((c) => c.getAttribute("data-id") === selectedId);
          if (!selCard || selCard.classList.contains("is-hidden")) setSelected(null);
        }
        const activeDetail = root!.querySelector<HTMLElement>(".ep-detail.is-active");
        const activeId = activeDetail?.getAttribute("data-detail-id");
        if (visible === 0) {
          details.forEach((d) => d.classList.remove("is-active"));
          if (empty) empty.hidden = false;
        } else {
          if (empty) empty.hidden = true;
          const stillVisible = activeId && cards.find((c) => c.getAttribute("data-id") === activeId && !c.classList.contains("is-hidden"));
          if (!stillVisible && firstVisibleId) {
            details.forEach((d) => d.classList.toggle("is-active", d.getAttribute("data-detail-id") === firstVisibleId));
            cards.forEach((c) => c.classList.toggle("is-focus", c.getAttribute("data-id") === firstVisibleId));
            czActivate(firstVisibleId);
          }
        }
      }

      pills.forEach((pill) => {
        pill.addEventListener("click", () => {
          const t = pill.getAttribute("data-tag") ?? "ALL";
          if (t === "ALL") {
            active = new Set(["ALL"]);
          } else {
            active.delete("ALL");
            if (active.has(t)) active.delete(t);
            else active.add(t);
            if (active.size === 0) active = new Set(["ALL"]);
          }
          pills.forEach((p) => {
            const tg = p.getAttribute("data-tag") ?? "";
            const on = active.has(tg);
            p.classList.toggle("is-active", on);
            p.setAttribute("aria-pressed", String(on));
          });
          applyFilter();
        });
      });

      // ── Focus + select a project ────────────────────────────────────
      // Hover previews a project; clicking *locks* the selection so the
      // detail panel stays put while you move the mouse over to read /
      // open it. Click the locked card again (or another card) to change.
      function focusProject(id: string) {
        cards.forEach((c) => c.classList.toggle("is-focus", c.getAttribute("data-id") === id));
        details.forEach((d) => d.classList.toggle("is-active", d.getAttribute("data-detail-id") === id));
        czActivate(id);
      }
      function setSelected(id: string | null) {
        selectedId = id;
        cards.forEach((c) => {
          const on = c.getAttribute("data-id") === id;
          c.classList.toggle("is-selected", on);
          c.setAttribute("aria-pressed", String(on));
        });
      }
      cards.forEach((card) => {
        const id = card.getAttribute("data-id");
        if (!id) return;
        // Hover/keyboard-focus only previews while nothing is locked.
        card.addEventListener("mouseenter", () => { if (!selectedId) focusProject(id); });
        card.addEventListener("focus", () => { if (!selectedId) focusProject(id); });
        card.addEventListener("click", () => {
          if (selectedId === id) {
            setSelected(null);            // click the locked card again → release
          } else {
            setSelected(id);              // lock onto this project
            focusProject(id);
          }
        });
      });

      // ── Carousel interactions (delegated on the grid root) ──────────
      root.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const bar = target.closest<HTMLElement>(".ep-cz__bar");
        if (bar && czEl && czEl.contains(bar)) {
          e.stopPropagation();
          czIdx = Number(bar.dataset.czBar);
          czRender(true);
          czStart();
          return;
        }
        const frame = target.closest<HTMLElement>(".ep-cz__frame");
        if (frame && frame.dataset.id) openLb(frame.dataset.id, czIdx);
      });
      root.addEventListener("keydown", (e) => {
        const frame = (e.target as HTMLElement).closest<HTMLElement>(".ep-cz__frame");
        if (frame && frame.dataset.id && (e.key === "Enter" || e.key === " ")) {
          e.preventDefault();
          openLb(frame.dataset.id, czIdx);
        }
      });

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) czStop();
        else if (!lbOpen) czStart();
      });

      // ── Lightbox ────────────────────────────────────────────────────
      const lb = document.querySelector("[data-eplb]") as HTMLElement | null;
      if (!lb) return;
      const lbSlides = Array.from(lb.querySelectorAll<HTMLElement>("[data-eplb-slide]"));
      const lbInfos = Array.from(lb.querySelectorAll<HTMLElement>("[data-eplb-info]"));
      const lbBars = Array.from(lb.querySelectorAll<HTMLElement>("[data-eplb-bar]"));
      const lbMedia = lb.querySelector("[data-eplb-media]") as HTMLElement | null;
      const lbHint = lb.querySelector("[data-eplb-hint]") as HTMLElement | null;
      const lbPrev = lb.querySelector("[data-eplb-prev]") as HTMLElement | null;
      const lbNext = lb.querySelector("[data-eplb-next]") as HTMLElement | null;

      let lbPid = "";
      let lbIdx = 0;
      let lbCount = 0;
      let hintTimer: number | null = null;

      function lbRender() {
        lbSlides.forEach((el) => {
          el.hidden = !(el.dataset.pid === lbPid && Number(el.dataset.idx) === lbIdx);
        });
        lbInfos.forEach((el) => { el.hidden = el.dataset.pid !== lbPid; });
        lbBars.forEach((b, i) => {
          b.hidden = i >= lbCount;
          const fill = b.querySelector(".eplb__bar-fill") as HTMLElement | null;
          if (fill) fill.style.width = i <= lbIdx ? "100%" : "0%";
        });
      }
      function showHint() {
        if (!lbHint) return;
        lbHint.classList.add("is-on");
        if (hintTimer != null) window.clearTimeout(hintTimer);
        hintTimer = window.setTimeout(dismissHint, 3000);
      }
      function dismissHint() {
        if (!lbHint) return;
        lbHint.classList.remove("is-on");
        if (hintTimer != null) { window.clearTimeout(hintTimer); hintTimer = null; }
      }
      function openLb(pid: string, idx: number) {
        lbCount = lbSlides.filter((s) => s.dataset.pid === pid).length;
        if (lbCount === 0) return;
        lbPid = pid;
        lbIdx = Math.min(Math.max(idx || 0, 0), lbCount - 1);
        lbOpen = true;
        czStop();
        lb!.hidden = false;
        lb!.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        lbRender();
        requestAnimationFrame(() => lb!.classList.add("is-open"));
        showHint();
      }
      function closeLb() {
        if (!lbOpen) return;
        lbOpen = false;
        dismissHint();
        lb!.classList.remove("is-open");
        lb!.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
        window.setTimeout(() => { lb!.hidden = true; }, 220);
        czStart();
      }
      function lbStep(d: number) {
        if (lbCount <= 0) return;
        lbIdx = ((lbIdx + d) % lbCount + lbCount) % lbCount;
        lbRender();
        dismissHint();
      }

      lb.querySelectorAll<HTMLElement>("[data-eplb-close]").forEach((el) =>
        el.addEventListener("click", closeLb)
      );
      lbPrev?.addEventListener("click", (e) => { e.stopPropagation(); lbStep(-1); });
      lbNext?.addEventListener("click", (e) => { e.stopPropagation(); lbStep(1); });
      lbBars.forEach((b, i) =>
        b.addEventListener("click", (e) => {
          e.stopPropagation();
          if (i < lbCount) { lbIdx = i; lbRender(); dismissHint(); }
        })
      );
      lbMedia?.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest(".eplb__nav")) return;
        const rect = lbMedia.getBoundingClientRect();
        if ((e as MouseEvent).clientX - rect.left < rect.width / 2) lbStep(-1);
        else lbStep(1);
      });
      document.addEventListener("keydown", (e) => {
        if (!lbOpen) return;
        if (e.key === "Escape") closeLb();
        else if (e.key === "ArrowLeft") lbStep(-1);
        else if (e.key === "ArrowRight") lbStep(1);
      });

      // Kick the first project's carousel (first card is SSR-focused).
      const firstId = cards[0]?.getAttribute("data-id");
      if (firstId) czActivate(firstId);
    })();
  </script>

  <style>
    /* The whole page sits on a dark canvas. Override body cream. */
    main.ep {
      position: relative;
      z-index: 2; /* opaquely cover the fixed wave canvas behind it */
      background: var(--dark);
      color: var(--dark-ink);
    }

    /* ── Lander ────────────────────────────────────────────────────── */
    .ep__lander {
      position: relative;
      min-height: calc(100vh - var(--topbar-h));
      padding: 48px var(--page-pad);
      background: radial-gradient(120% 80% at 80% 0%, rgba(217, 106, 54, 0.10) 0%, rgba(217, 106, 54, 0.0) 60%), var(--dark);
      overflow: hidden;
      /* Centre the hero content vertically in the viewport. */
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .ep__lander-grid {
      display: grid;
      grid-template-columns: 1fr clamp(380px, 36vw, 520px);
      gap: 56px;
      align-items: center;
      width: 100%;
    }
    .ep__title {
      font-family: var(--font-display);
      font-size: clamp(56px, 10vw, 138px);
      line-height: 0.9;
      letter-spacing: -0.028em;
      margin: 18px 0 0;
      color: var(--dark-ink);
      font-weight: 500;
    }
    .ep__title-italic { font-style: italic; font-weight: 400; }
    .ep__period { color: var(--accent); }
    .ep__byline {
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(19px, 2.2vw, 28px);
      color: var(--dark-dim);
      margin: 16px 0 0;
    }
    .ep__byline strong { color: var(--dark-ink); font-weight: 600; font-style: normal; }
    .ep__tagline {
      font-family: var(--font-body);
      font-size: 19px;
      line-height: 1.5;
      color: var(--dark-dim);
      max-width: 580px;
      margin: 32px 0 0;
    }
