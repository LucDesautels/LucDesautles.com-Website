      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
    .eplb__nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 48px;
      height: 48px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.2);
