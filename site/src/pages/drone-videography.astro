---
import { Image } from "astro:assets";
import { readText, readTextOptional, resolveImage, listSlotDirs, listSlotImages } from "@/lib/finalImages";
import { SITE, DEDICATED_PAGES } from "@/data/content";
import LinkedInCard from "@/components/LinkedInCard.astro";
import DroneNav from "@/components/webflow/DroneNav.astro";
import DroneFooter from "@/components/webflow/DroneFooter.astro";
import DroneMotion from "@/components/webflow/DroneMotion.astro";

// FAITHFUL port of the Webflow "drone-portfolio" page — the template's own
// layout, styling and motion, not this site's design system. (The version
// restyled to match the rest of the site lives at /drone-videography-adapted.)
//
// This page deliberately does NOT use BaseLayout: it links the Webflow
// export's own CSS from /webflow/drone-videography/css/ and renders the
// template's class names verbatim, so the result is pixel-faithful. The two
// Webflow IX2 interactions are reproduced in CSS at the bottom of this file
// rather than by shipping jQuery + the 554 KB webflow.js runtime:
//
//   e-13/e-14 (a-4/a-5) "Project Card - Hover In/Out": 500ms outQuart —
//     marquee opacity 0->1, .project-card-content-line translateY 100%->0,
//     .project-card-content-secondary opacity 0->1, card scale 1->0.985,
//     .project-card-image scale 1->1.015
//   e-16 (a-3) "Project Card - Marquee": .project-card-marquee-line
//     translateX 0 -> -100% over 15s, linear, looping
const B = "drone-videography";
const t = (p: string) => readText(`${B}/${p}`);
const ASSETS = "/webflow/drone-videography";

const projects = listSlotDirs(`${B}/projects`).map((dir) => {
  const f = (n: string) => readTextOptional(`${B}/projects/${dir}/${n}`);
  return {
    dir,
    slug: dir.replace(/^\d+-/, ""),
    title: f("title"),
    year: f("year"),
    location: f("location"),
    featured: resolveImage(`${B}/projects/${dir}/hero`),
    marquee: listSlotImages(`${B}/projects/${dir}/marquee`),
  };
});
---
<!doctype html>
<html lang="en" class="dvw">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Drone Videography · Luc Desautels</title>
    <meta
      name="description"
      content="Nature drone videography — landscapes and natural environments filmed from above, across Vancouver Island, Muskoka and Prince Edward County."
    />
    <meta property="og:title" content="Drone Videography · Luc Desautels" />
    <meta property="og:type" content="website" />
    <link rel="stylesheet" href={`${ASSETS}/css/normalize.css`} />
    <link rel="stylesheet" href={`${ASSETS}/css/webflow.css`} />
    <link rel="stylesheet" href={`${ASSETS}/css/luke-s-newest-site-667-portfolio.webflow.css`} />
    <link rel="shortcut icon" href={`${ASSETS}/images/favicon.svg`} type="image/x-icon" />
    <link rel="apple-touch-icon" href={`${ASSETS}/images/webclip.svg`} />
    <script is:inline>
      // Webflow's own no-JS/touch flag — several template rules key off these.
      !(function (o, c) {
        var n = c.documentElement,
          t = " w-mod-";
        n.className += t + "js";
        ("ontouchstart" in o || (o.DocumentTouch && c instanceof DocumentTouch)) &&
          (n.className += t + "touch");
      })(window, document);
    </script>
  </head>

  <body>
    <!-- Zone 1 — hero ─────────────────────────────────────────────── -->
    <section id="hero" class="hero">
      <div
        data-animation="default"
        class="rl_navbar1_component w-nav"
        data-easing2="ease"
        data-easing="ease"
        data-collapse="medium"
        role="banner"
        data-duration="400"
      >
        <div class="rl_navbar1_container">
          <div class="text-block">Luc Desautels</div>
          <nav role="navigation" class="rl_navbar1_menu is-page-height-tablet w-nav-menu">
            {DEDICATED_PAGES.map((p) => {
              const cur = p.href.replace(/\/$/, "") === "/drone-videography";
              return (
                <a href={p.href} class:list={["rl_navbar1_link", "w-nav-link", cur && "w--current"]} aria-current={cur ? "page" : undefined}>{p.label}</a>
              );
            })}
            <div class="rl_navbar1_menu-buttons">
              <a href={`mailto:${SITE.contact.email}`} class="fs-copyclip_button helper w-inline-block" data-copy-email={SITE.contact.email}>
                <div class="fs-copyclip_button_icon w-embed">
                  <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M3 3C2.44772 3 2 3.44772 2 4V12C2 12.5523 2.44771 13 3 13H13C13.5523 13 14 12.5523 14 12V4C14 3.44772 13.5523 3 13 3H3ZM12.2929 4H3.70711L8 8.29289L12.2929 4ZM3 4.70711V12H13V4.70711L8.70711 9C8.31658 9.39052 7.68342 9.39052 7.29289 9L3 4.70711Z"
                      fill="currentColor"></path>
                  </svg>
                </div>
                <div class="text-block-2">{SITE.contact.email}</div>
              </a>
              <a href="/resume" class="rl_navbar1_button-secondary w-button">Résumé</a>
              <LinkedInCard icon={`${ASSETS}/images/linkedin-svgrepo-com.svg`} />
            </div>
          </nav>
          <div class="rl_navbar1_menu-button w-nav-button">
            <div class="rl_menu-icon">
              <div class="rl_menu-icon_line-top"></div>
              <div class="rl_menu-icon_line-middle"><div class="rl_menu-icon_line-middle-inner"></div></div>
              <div class="rl_menu-icon_line-bottom"></div>
            </div>
          </div>
        </div>
      </div>

      <header class="rl_section_header5">
        <div class="rl-padding-global">
          <div class="rl-container-large">
            <div class="header5_component">
              <div class="rl_header5_content">
                <h1 class="rl-heading-style-h1 is-white">{t("intro/heading")}</h1>
                <div class="rl_heading1_spacing-block-1"></div>
                <p class="rl-text-style-medium is-white">{t("intro/tagline")}</p>
                <div class="rl_heading1_spacing-block-2"></div>
                <div class="rl-button-group">
                  <a href="#portfolio" class="rl-button w-button" data-dv-enter>View the work</a>
                  <a href="/" class="rl-button-secondary-alternate w-button">Back to LucDesautels.com</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </header>
    </section>

    <!-- Zone 2 — portfolio ────────────────────────────────────────── -->
    <section id="portfolio" class="portfolio">
      <div id="portfolio-scroll" class="portfolio-scroll">
        <div class="layout">
          <div class="w-layout-grid layout-grid">
            <DroneNav projects={projects} />

            <div id="w-node-_14d7e00e-e9ba-fa7e-2ec8-faf5556d70fe-d93b2b6e" class="layout-content">
              <div>
                <div role="list" class="projects-list">
                  {projects.map((p) => (
                    <div role="listitem">
                      <a href={`/drone-videography/${p.slug}`} class="project-card w-inline-block">
                        <div class="project-card-content">
                          <div class="project-card-content-line-wrapper">
                            <div class="project-card-content-line">
                              <div class="display-s">{p.title}</div>
                            </div>
                          </div>
                          <div class="project-card-content-line-wrapper">
                            <div class="project-card-content-line">
                              <div class="project-card-content-meta">
                                <div class="project-card-content-meta-year">
                                  <div class="display-s">{p.year}</div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                        <div class="project-card-content-secondary">
                          <div class="project-card-content-line-wrapper">
                            <div class="project-card-content-line">
                              <div class="display-s">{p.location}</div>
                            </div>
                          </div>
                        </div>

                        <div class="project-card-marquee">
                          {[0, 1].map(() => (
                            <div class="project-card-marquee-line">
                              {p.marquee.map((src) => (
                                <div class="project-card-marquee-item">
                                  <Image src={src} alt="" width={520} format="webp" quality={78} loading="lazy" decoding="async" class="project-card-marquee-item-image" />
                                </div>
                              ))}
                            </div>
                          ))}
                        </div>

                        {p.featured && (
                          <Image
                            src={p.featured}
                            alt={p.title}
                            width={1800}
                            format="webp"
                            quality={82}
                            loading="lazy"
                            decoding="async"
                            class="project-card-image"
                          />
                        )}
                      </a>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <DroneFooter projects={projects} />
      </div>
    </section>

    <script is:inline>
      // The export's own two-zone snap scroll, verbatim in behaviour: hero and
      // portfolio each fill the viewport inside a fixed wrapper translated by
      // 100vh; the portfolio scrolls internally; at its top, two deliberate
      // upward flicks (momentum under 8px ignored) return to the hero.
      (function () {
        var hero = document.getElementById("hero");
        var portfolio = document.getElementById("portfolio");
        var inner = document.querySelector(".portfolio-scroll");
        if (!hero || !portfolio || !inner) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        var zone = "hero";
        var animating = false;
        var exitLocked = false;
        var armed = false;
        var wheelTimer, lockTimer;
        var wrapper;

        // ── Smooth wheel scrolling inside the gallery pane ─────────────────
        // The wheel handler below cancels native scrolling (it has to, to run the
        // hero/gallery zones), and that also cancels the browser's own wheel glide:
        // each notch used to just add its delta to scrollTop and jump. This keeps a
        // target position and eases the pane toward it every frame. It is time-based,
        // so it feels the same at 60 or 144 Hz, and it only changes HOW the pane
        // moves; the zone logic, the flick-to-exit and the position memory are as they were.
        var SMOOTH_MS = 120;           // ease time constant: higher = longer glide
        var targetY = 0, curY = 0, glideRaf = 0, lastT = 0;
        function maxY() { return inner.scrollHeight - inner.clientHeight; }
        function glideStep(t) {
          var dt = Math.min(64, t - lastT || 16);
          lastT = t;
          curY += (targetY - curY) * (1 - Math.exp(-dt / SMOOTH_MS));
          if (Math.abs(targetY - curY) < 0.4) {
            curY = targetY;
            inner.scrollTop = curY;
            glideRaf = 0;
            return;
          }
          inner.scrollTop = curY;
          glideRaf = requestAnimationFrame(glideStep);
        }
        function glideBy(dy) {
          // not mid-glide: pick up wherever the pane really is (scrollbar drag, touch, restore)
          if (!glideRaf) { curY = targetY = inner.scrollTop; }
          targetY = Math.max(0, Math.min(maxY(), targetY + dy));
          if (!glideRaf) { lastT = performance.now(); glideRaf = requestAnimationFrame(glideStep); }
        }
        // For programmatic jumps (back to the top, restoring a saved position).
        function jumpTo(y) {
          if (glideRaf) { cancelAnimationFrame(glideRaf); glideRaf = 0; }
          inner.scrollTop = y;
          curY = targetY = inner.scrollTop;
        }

        function initLayout() {
          document.body.style.overflow = "hidden";
          document.body.style.height = "100vh";
          document.documentElement.style.overflow = "hidden";
          wrapper = document.createElement("div");
          wrapper.id = "scroll-wrapper";
          wrapper.style.cssText =
            "position:fixed;top:0;left:0;width:100%;transition:transform 0.7s cubic-bezier(0.77,0,0.175,1);";
          hero.parentNode.insertBefore(wrapper, hero);
          wrapper.appendChild(hero);
          wrapper.appendChild(portfolio);
          hero.style.height = "100vh";
          portfolio.style.height = "100vh";
        }

        function enterPortfolio() {
          if (animating || zone === "portfolio") return;
          animating = true;
          wrapper.style.transform = "translateY(-100vh)";
          setTimeout(function () {
            animating = false;
            zone = "portfolio";
            exitLocked = true;
            clearTimeout(lockTimer);
            lockTimer = setTimeout(function () { exitLocked = false; }, 1000);
          }, 700);
        }

        function exitToHero() {
          if (animating || zone === "hero") return;
          animating = true;
          jumpTo(0);
          wrapper.style.transform = "translateY(0)";
          setTimeout(function () {
            animating = false;
            zone = "hero";
          }, 700);
        }

        window.addEventListener("wheel", function (e) {
          e.preventDefault();
          if (animating) return;
          if (zone === "hero") {
            if (e.deltaY > 0) enterPortfolio();
            return;
          }
          // mice report pixels, some browsers report lines/pages: normalise to px
          var dy = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaMode === 2 ? e.deltaY * inner.clientHeight : e.deltaY;
          if (e.deltaY > 0) {
            armed = false;
            glideBy(dy);
            return;
          }
          var intentional = e.deltaY < -8;
          if (inner.scrollTop > 0) {
            armed = false;
            if (intentional) glideBy(dy);
            return;
          }
          if (!intentional) return;
          clearTimeout(wheelTimer);
          wheelTimer = setTimeout(function () {
            if (!armed) armed = true;
            else if (!exitLocked) { armed = false; exitToHero(); }
          }, 80);
        }, { passive: false });

        var touchStartY = 0;
        window.addEventListener("touchstart", function (e) { touchStartY = e.touches[0].clientY; }, { passive: true });
        window.addEventListener("touchmove", function (e) {
          if (animating) return;
          var deltaY = touchStartY - e.touches[0].clientY;
          if (zone === "hero" && deltaY > 30) { e.preventDefault(); enterPortfolio(); }
          else if (zone === "portfolio" && !exitLocked && inner.scrollTop === 0 && deltaY < -30) { e.preventDefault(); exitToHero(); }
        }, { passive: false });

        // Keyboard parity — the wheel hijack would otherwise strand keyboard users.
        window.addEventListener("keydown", function (e) {
          var tag = e.target && e.target.tagName;
          if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;
          if (zone === "hero" && (e.key === "ArrowDown" || e.key === "PageDown" || e.key === " ")) {
            e.preventDefault(); enterPortfolio();
          } else if (zone === "portfolio" && e.key === "Escape") {
            e.preventDefault(); exitToHero();
          }
        });

        document.querySelectorAll("[data-dv-enter]").forEach(function (el) {
          el.addEventListener("click", function (e) { e.preventDefault(); enterPortfolio(); });
        });

        // ── Gallery position memory ───────────────────────────────────────
        // The gallery scrolls inside a pinned pane, not the document, so the
        // browser has nothing to restore on Back — without this you land on
        // the hero again. Persist the pane offset and the zone, then put both
        // back when arriving from a project page or via Back/Forward.
        var SKEY = "dv:scroll", ZKEY = "dv:zone", RKEY = "dv:return";
        var saveTimer;
        function save() {
          try {
            sessionStorage.setItem(SKEY, String(Math.round(inner.scrollTop)));
            sessionStorage.setItem(ZKEY, zone);
          } catch (e) {}
        }
        inner.addEventListener("scroll", function () {
          clearTimeout(saveTimer);
          saveTimer = setTimeout(save, 120);
        }, { passive: true });
        window.addEventListener("pagehide", save);
        // Flush synchronously on the way out rather than trusting the debounce
        // to have fired — a click can land inside the 120ms window.
        document.querySelectorAll(".project-card").forEach(function (card) {
          card.addEventListener("click", save);
        });

        function restoreIfReturning() {
          var returning = false;
          try {
            var navEntry = performance.getEntriesByType("navigation")[0];
            returning =
              sessionStorage.getItem(RKEY) === "1" ||
              (navEntry && navEntry.type === "back_forward");
            sessionStorage.removeItem(RKEY);
            if (sessionStorage.getItem(ZKEY) !== "portfolio") returning = false;
          } catch (e) { return; }
          if (!returning) return;

          var y = 0;
          try { y = parseInt(sessionStorage.getItem(SKEY) || "0", 10) || 0; } catch (e) {}

          // Jump straight in, no 700ms slide — this is a restore, not a nav.
          wrapper.style.transition = "none";
          wrapper.style.transform = "translateY(-100vh)";
          zone = "portfolio";
          exitLocked = true;
          clearTimeout(lockTimer);
          lockTimer = setTimeout(function () { exitLocked = false; }, 1000);
          jumpTo(y);
          requestAnimationFrame(function () { wrapper.style.transition = ""; });
          // Lazy images above the restore point can still be resolving their
          // height, which clamps scrollTop; re-apply once layout has settled.
          window.addEventListener("load", function () { jumpTo(y); });
          setTimeout(function () { if (Math.abs(inner.scrollTop - y) > 4) jumpTo(y); }, 400);
        }

        // Clicking the brand from inside the gallery goes up to the hero
        // rather than reloading the page.
        document.querySelectorAll("[data-dv-home]").forEach(function (el) {
          el.addEventListener("click", function (e) {
            if (zone !== "portfolio") return;
            e.preventDefault();
            exitToHero();
          });
        });

        // ── Touch devices: reveal the card in focus while scrolling ───────
        // Only where hovering isn't possible, so pointer users are untouched.
        // A card opens as it rises past the lower edge of a band in the upper
        // half of the pane and closes again as it leaves the top.
        function initTouchReveal() {
          if (!window.matchMedia("(hover: none)").matches) return;
          if (!("IntersectionObserver" in window)) return;
          var cards = document.querySelectorAll(".project-card");
          if (!cards.length) return;
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                entry.target.classList.toggle("is-active", entry.isIntersecting);
              });
            },
            { root: inner, rootMargin: "-15% 0px -50% 0px", threshold: 0 },
          );
          cards.forEach(function (c) { io.observe(c); });
        }

        function boot() { initLayout(); restoreIfReturning(); initTouchReveal(); }
        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
        else boot();
      })();
    </script>

    <DroneMotion scrollRoot=".portfolio-scroll" />

    <style is:global>
      /* ── Page-level custom CSS from the export's <head> ────────────
         This is what makes the gallery scrollable. `.portfolio` is
         height:100vh + overflow:hidden (template CSS), so the inner pane is
         the only thing that can scroll, and the snap-scroll script drives it
         by writing `inner.scrollTop`. Without overflow-y here that pane
         computes `overflow-y: visible`, scrollTop is pinned at 0, and the
         gallery is unscrollable — the content is simply clipped. */
      .portfolio-scroll {
        height: 100%;
        overflow-y: scroll;
      }
      /* The template reveals the footer with z-index:-1 (content slides over it).
         Inside this scroll pane that sinks it *under* the pane's own box, and a
         scroll container is hit-tested before anything behind it — so every footer
         link was unclickable. z-index:1 lifts the footer above the pane but keeps it
         below .layout (z-index:2), so the reveal looks identical and the links work. */
      .portfolio-scroll .section.section-footer { z-index: 1; }
      .portfolio-scroll::-webkit-scrollbar { width: 6px; }
      .portfolio-scroll::-webkit-scrollbar-track { background: transparent; }
      .portfolio-scroll::-webkit-scrollbar-thumb {
        background-color: rgba(0, 0, 0, 0.25);
        border-radius: 10px;
      }
      .portfolio-scroll::-webkit-scrollbar-thumb:hover {
        background-color: rgba(0, 0, 0, 0.45);
      }

      /* ── Webflow IX2 replacements ──────────────────────────────────
         Values taken verbatim from the export's ix2 action lists a-3
         (marquee), a-4 (hover in) and a-5 (hover out). outQuart is
         cubic-bezier(.165,.84,.44,1) — the same curve the template uses
         for .nav-link. */
      .project-card,
      .project-card .project-card-image,
      .project-card .project-card-marquee,
      .project-card .project-card-content-secondary,
      .project-card .project-card-content-line {
        transition-duration: 500ms;
        transition-timing-function: cubic-bezier(0.165, 0.84, 0.44, 1);
      }
      .project-card { transition-property: transform; transform: scale(1); }
      .project-card .project-card-image { transition-property: transform; transform: scale(1); }
      .project-card .project-card-marquee { transition-property: opacity; opacity: 0; }
      .project-card .project-card-content-secondary { transition-property: opacity; opacity: 0; }
      .project-card .project-card-content-line { transition-property: transform; transform: translateY(100%); }

      .project-card:hover { transform: scale(0.985); }
      .project-card:hover .project-card-image { transform: scale(1.015); }
      .project-card:hover .project-card-marquee { opacity: 1; }
      .project-card:hover .project-card-content-secondary { opacity: 1; }
      .project-card:hover .project-card-content-line { transform: translateY(0%); }

      /* .is-active is the touch-device stand-in for :hover — see the
         IntersectionObserver below, which only runs under (hover: none). */
      .project-card.is-active .project-card-content-secondary { opacity: 1; }
      .project-card.is-active .project-card-content-line { transform: translateY(0%); }

      /* Keyboard users get the same reveal as pointer users. */
      .project-card:focus-visible { transform: scale(0.985); outline: 2px solid var(--color--brand-primary); outline-offset: 3px; }
      .project-card:focus-visible .project-card-image { transform: scale(1.015); }
      .project-card:focus-visible .project-card-marquee { opacity: 1; }
      .project-card:focus-visible .project-card-content-secondary { opacity: 1; }
      .project-card:focus-visible .project-card-content-line { transform: translateY(0%); }

      /* a-3: translateX 0 -> -100% over 15s, linear, looping. Two identical
         lines sit side by side so the wrap is seamless. */
      .project-card-marquee-line { animation: dv-card-marquee 15s linear infinite; }
      @keyframes dv-card-marquee {
        from { transform: translateX(0%); }
        to { transform: translateX(-100%); }
      }

      /* Astro's <Image> emits intrinsic width/height; the template sized these
         purely with CSS, so re-assert the object-fit sizing it expects. */
      .project-card-image { width: 100%; height: 100%; object-fit: cover; }
      .project-card-marquee-item-image { width: 100%; height: 100%; object-fit: cover; }

      /* ── Narrow / half-screen ──────────────────────────────────────
         Below 991px the template drops .project-card-content into normal
         flow under the image instead of overlaying it. Our reveal still
         holds the title lines translated 100% down inside their
         overflow:hidden wrappers, so that block sat there reserving empty
         height and pushing the tiles apart. Collapse its row tracks — and
         the card's own image/text gap — while idle, and let both open as
         part of the same 500ms outQuart reveal. */
      @media screen and (max-width: 991px) {
        .project-card {
          gap: 0;
          transition:
            transform 500ms cubic-bezier(0.165, 0.84, 0.44, 1),
            gap 500ms cubic-bezier(0.165, 0.84, 0.44, 1);
        }
        .project-card-content {
          display: grid;
          grid-template-rows: 0fr 0fr;
          transition: grid-template-rows 500ms cubic-bezier(0.165, 0.84, 0.44, 1);
        }
        .project-card-content > .project-card-content-line-wrapper { min-height: 0; }

        .project-card:hover,
        .project-card:focus-visible,
        .project-card.is-active { gap: 1rem; }
        .project-card:hover .project-card-content,
        .project-card:focus-visible .project-card-content,
        .project-card.is-active .project-card-content { grid-template-rows: 1fr 1fr; }
      }

      @media (prefers-reduced-motion: reduce) {
        .project-card-marquee-line { animation: none; }
        .project-card,
        .project-card .project-card-image,
        .project-card .project-card-marquee,
        .project-card .project-card-content-secondary,
        .project-card .project-card-content-line { transition-duration: 1ms; }
      }
    </style>
  </body>
</html>
