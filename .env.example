# Copy to `.env` on the server and adjust.
#
# In production, set this to your real domain. Caddy will fetch a Let's Encrypt
# cert for it on first request (port 80 + 443 must be reachable from the
# public internet, and DNS must resolve to this server).
#
# Multi-host example (with redirect from www):
#   SITE_HOST=lucdesautels.com, www.lucdesautels.com
#
# Local-only testing (no TLS):
#   SITE_HOST=:80
SITE_HOST=lucdesautels.com
